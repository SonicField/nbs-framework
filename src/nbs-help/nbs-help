#!/bin/bash
# nbs-help — Search the NBS framework manifest for tools, skills, and documents.
#
# Usage:
#   nbs-help <query>              Search by keyword across all entries
#   nbs-help --kind=tool <query>  Filter to a specific kind (tool/skill/document/concept)
#   nbs-help --list               List all entries grouped by kind
#   nbs-help --help               Show this help
#
# Searches name, summary, when_to_use, and keywords fields.
# Case-insensitive. Multiple query words are ANDed.

set -euo pipefail

# Find MANIFEST.honest — walk up from script location to find repo root
find_manifest() {
    local dir
    # Try relative to script
    dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    if [ -f "$dir/MANIFEST.honest" ]; then
        echo "$dir/MANIFEST.honest"
        return 0
    fi
    # Try current directory upward
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/MANIFEST.honest" ]; then
            echo "$dir/MANIFEST.honest"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

MANIFEST=""
KIND_FILTER=""
LIST_MODE=0
QUERY=""

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            echo "Usage: nbs-help <query>              Search by keyword"
            echo "       nbs-help --kind=<kind> <query> Filter by kind (tool/skill/document/concept)"
            echo "       nbs-help --list                List all entries grouped by kind"
            echo "       nbs-help --list --kind=<kind>  List entries of one kind"
            echo ""
            echo "Searches name, summary, when_to_use, and keywords. Case-insensitive."
            exit 0
            ;;
        --kind=*)
            KIND_FILTER="${1#--kind=}"
            ;;
        --list)
            LIST_MODE=1
            ;;
        --manifest=*)
            MANIFEST="${1#--manifest=}"
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            if [ -z "$QUERY" ]; then
                QUERY="$1"
            else
                QUERY="$QUERY $1"
            fi
            ;;
    esac
    shift
done

# Find manifest
if [ -z "$MANIFEST" ]; then
    MANIFEST="$(find_manifest)" || {
        echo "Error: MANIFEST.honest not found" >&2
        exit 1
    }
fi

if [ ! -f "$MANIFEST" ]; then
    echo "Error: $MANIFEST not found" >&2
    exit 1
fi

# Locate honest-get
HONEST_GET="$(which honest-get 2>/dev/null)" || {
    # Try relative to manifest
    HONEST_GET="$(dirname "$MANIFEST")/bin/honest-get"
    [ -x "$HONEST_GET" ] || {
        echo "Error: honest-get not found" >&2
        exit 1
    }
}

# Count entries
count_entries() {
    local i=0
    while "$HONEST_GET" "$MANIFEST" manifest entries.$i.name >/dev/null 2>&1; do
        i=$((i + 1))
    done
    echo "$i"
}

# Get entry field
get_field() {
    "$HONEST_GET" "$MANIFEST" manifest "entries.$1.$2" 2>/dev/null || echo ""
}

# Get keywords as space-separated string
get_keywords() {
    local idx=$1
    local kw=""
    local ki=0
    while true; do
        local k
        k=$("$HONEST_GET" "$MANIFEST" manifest "entries.$idx.keywords.$ki" 2>/dev/null) || break
        [ -z "$k" ] && break
        kw="$kw $k"
        ki=$((ki + 1))
    done
    echo "$kw"
}

# Resolve paths relative to the directory containing MANIFEST.honest
MANIFEST_ROOT="$(dirname "$(realpath "$MANIFEST")")"

# Format and print an entry
print_entry() {
    local idx=$1
    local name kind path summary when_to_use
    name=$(get_field "$idx" name)
    kind=$(get_field "$idx" kind)
    path=$(get_field "$idx" path)
    summary=$(get_field "$idx" summary)
    when_to_use=$(get_field "$idx" when_to_use)

    printf "  \033[1m%s\033[0m — %s\n" "$name" "$summary"
    printf "    Path: %s/%s\n" "$MANIFEST_ROOT" "$path"
    printf "    Use when: %s\n" "$when_to_use"
}

N=$(count_entries)

if [ "$LIST_MODE" -eq 1 ]; then
    # List mode: show all entries grouped by kind
    for kind_name in Tool Skill Document Concept; do
        # Apply kind filter if specified
        if [ -n "$KIND_FILTER" ]; then
            local_filter=$(echo "$KIND_FILTER" | tr '[:upper:]' '[:lower:]')
            kind_lower=$(echo "$kind_name" | tr '[:upper:]' '[:lower:]')
            [ "$local_filter" != "$kind_lower" ] && continue
        fi

        header_printed=0
        for ((i = 0; i < N; i++)); do
            entry_kind=$(get_field "$i" kind)
            if [ "$entry_kind" = "$kind_name" ]; then
                if [ "$header_printed" -eq 0 ]; then
                    printf "\n\033[1;4m%ss\033[0m\n" "$kind_name"
                    header_printed=1
                fi
                print_entry "$i"
                echo ""
            fi
        done
    done
    exit 0
fi

# Search mode
if [ -z "$QUERY" ]; then
    echo "Usage: nbs-help <query>" >&2
    echo "       nbs-help --list" >&2
    exit 1
fi

# Split query into words (lowercase)
QUERY_LOWER=$(echo "$QUERY" | tr '[:upper:]' '[:lower:]')
IFS=' ' read -ra WORDS <<< "$QUERY_LOWER"

# Search each entry
matches=()
for ((i = 0; i < N; i++)); do
    # Apply kind filter
    if [ -n "$KIND_FILTER" ]; then
        entry_kind=$(get_field "$i" kind)
        entry_kind_lower=$(echo "$entry_kind" | tr '[:upper:]' '[:lower:]')
        filter_lower=$(echo "$KIND_FILTER" | tr '[:upper:]' '[:lower:]')
        [ "$entry_kind_lower" != "$filter_lower" ] && continue
    fi

    # Build searchable text from all fields
    name=$(get_field "$i" name)
    summary=$(get_field "$i" summary)
    when=$(get_field "$i" when_to_use)
    keywords=$(get_keywords "$i")
    searchable=$(echo "$name $summary $when $keywords" | tr '[:upper:]' '[:lower:]')

    # Check all query words match (AND)
    all_match=1
    for word in "${WORDS[@]}"; do
        if [[ "$searchable" != *"$word"* ]]; then
            all_match=0
            break
        fi
    done

    if [ "$all_match" -eq 1 ]; then
        matches+=("$i")
    fi
done

if [ ${#matches[@]} -eq 0 ]; then
    echo "No matches for: $QUERY"
    exit 0
fi

# Group matches by kind
for kind_name in Tool Skill Document Concept; do
    header_printed=0
    for idx in "${matches[@]}"; do
        entry_kind=$(get_field "$idx" kind)
        if [ "$entry_kind" = "$kind_name" ]; then
            if [ "$header_printed" -eq 0 ]; then
                printf "\n\033[1;4m%ss\033[0m\n" "$kind_name"
                header_printed=1
            fi
            print_entry "$idx"
            echo ""
        fi
    done
done
