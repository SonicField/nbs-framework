#!/bin/bash
# nbs-remote-run: Run a command on a remote machine, return output
#
# Ephemeral: creates a pty-session, SSHs, runs the command, captures
# output, cleans up. No session management needed.
#
# Usage:
#   nbs-remote-run <host> <command>
#   nbs-remote-run <host> --cwd=<path> <command>
#   nbs-remote-run <host> --timeout=<secs> <command>
#
# Examples:
#   nbs-remote-run build-server.example.com 'git log --oneline -5'
#   nbs-remote-run build-server.example.com --cwd=/home/user/project 'make -j8'
#   nbs-remote-run build-server.example.com --timeout=300 'bash build_cinderx.sh'
#
# Output:
#   stdout — command output from the remote machine
#   stderr — errors from this tool (connection failures, timeouts)
#
# Exit codes:
#   0 - Command ran (output printed, check content for command-level errors)
#   1 - SSH connection failed
#   2 - Invalid arguments
#   3 - Command timed out

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_TS="${SCRIPT_DIR}/nbs-ts"
[[ -x "$NBS_TS" ]] || NBS_TS="${HOME}/.nbs/bin/nbs-ts"
PTY_SESSION="${HOME}/.nbs/bin/pty-session"
export NBS_PTY_QUIET=1

die() { local rc="$1"; shift; echo "Error: $*" >&2; exit "$rc"; }

[[ -x "$NBS_TS" ]] || [[ -x "$PTY_SESSION" ]] || die 1 "Neither nbs-ts nor pty-session found"

# Parse arguments
HOST=""
CWD=""
TIMEOUT=300
CMD=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cwd=*)     CWD="${1#*=}"; shift ;;
        --timeout=*) TIMEOUT="${1#*=}"; shift ;;
        --help|-h)
            sed -n '2,/^$/{ /^#/p }' "$0" | cut -c3-
            exit 0
            ;;
        -*)          die 2 "Unknown option: $1" ;;
        *)
            if [[ -z "$HOST" ]]; then
                HOST="$1"
            elif [[ -z "$CMD" ]]; then
                CMD="$1"
            else
                die 2 "Unexpected argument: $1 (command must be a single quoted string)"
            fi
            shift
            ;;
    esac
done

[[ -n "$HOST" ]] || die 2 "Usage: nbs-remote-run <host> [--cwd=PATH] [--timeout=SECS] '<command>'"
[[ -n "$CMD" ]]  || die 2 "No command specified"

# Unique session name and markers
SESSION=""
START_MARKER="NBS_START_${RANDOM}_${RANDOM}"
END_MARKER="NBS_END_${RANDOM}_${RANDOM}"
USE_NBS_TS=0
[[ -x "$NBS_TS" ]] && USE_NBS_TS=1

cleanup() {
    if [[ "$USE_NBS_TS" == "1" && -n "$SESSION" ]]; then
        "$NBS_TS" kill "$SESSION" >/dev/null 2>&1 || true
    elif [[ -n "$SESSION" ]]; then
        "$PTY_SESSION" kill "$SESSION" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

if [[ "$USE_NBS_TS" == "1" ]]; then
    # --- nbs-ts mode ---
    SESSION=$("$NBS_TS" create "ssh -o StrictHostKeyChecking=no $HOST") || die 1 "Failed to create nbs-ts session"

    READY="NBS_READY_${RANDOM}"
    sleep 5
    "$NBS_TS" send "$SESSION" "echo $READY"
    if ! "$NBS_TS" wait-pattern "$SESSION" "$READY" --timeout=15 >/dev/null 2>&1; then
        die 1 "SSH to $HOST timed out (15s)"
    fi

    if [[ -n "$CWD" ]]; then
        "$NBS_TS" send "$SESSION" "cd $CWD"
        sleep 1
    fi

    "$NBS_TS" send "$SESSION" "echo $START_MARKER; $CMD; echo $END_MARKER"

    if ! "$NBS_TS" wait-pattern "$SESSION" "$END_MARKER" --timeout="$TIMEOUT" >/dev/null 2>&1; then
        die 3 "Command timed out after ${TIMEOUT}s"
    fi
    sleep 1

    "$NBS_TS" read-new "$SESSION" --strip 2>/dev/null \
        | sed -n "/${START_MARKER}/,/${END_MARKER}/p" \
        | grep -v "$START_MARKER" \
        | grep -v "$END_MARKER" \
        | tail -n +2 \
        || true
else
    # --- pty-session fallback ---
    SESSION="nbs-run-$$-${RANDOM}"

    if ! "$PTY_SESSION" create "$SESSION" "ssh -o StrictHostKeyChecking=no $HOST" >/dev/null 2>&1; then
        die 1 "Failed to create pty-session"
    fi

    READY="NBS_READY_${RANDOM}"
    sleep 5
    "$PTY_SESSION" send "$SESSION" "echo $READY" >/dev/null 2>&1
    if ! "$PTY_SESSION" wait "$SESSION" "$READY" --timeout=15 >/dev/null 2>&1; then
        die 1 "SSH to $HOST timed out (15s)"
    fi

    if [[ -n "$CWD" ]]; then
        "$PTY_SESSION" send "$SESSION" "cd $CWD" >/dev/null 2>&1
        sleep 1
    fi

    "$PTY_SESSION" send "$SESSION" "echo $START_MARKER; $CMD; echo $END_MARKER" >/dev/null 2>&1

    if ! "$PTY_SESSION" wait "$SESSION" "$END_MARKER" --timeout="$TIMEOUT" >/dev/null 2>&1; then
        die 3 "Command timed out after ${TIMEOUT}s"
    fi
    sleep 1

    "$PTY_SESSION" read "$SESSION" 2>/dev/null \
        | sed -n "/${START_MARKER}/,/${END_MARKER}/p" \
        | grep -v "$START_MARKER" \
        | grep -v "$END_MARKER" \
        | grep -v '__PTY_FENCE_' \
        | tail -n +2 \
        || true
fi
