#!/bin/bash
# nbs-remote-session: Create a persistent shell on a remote machine
#
# Wraps nbs-ts + SSH into a single command. Returns a session handle
# that can be used with nbs-ts send/read-new/wait-pattern/kill.
#
# Usage:
#   nbs-remote-session <host>                  # Auto-named session
#   nbs-remote-session <host> --name=mywork    # Named session
#   nbs-remote-session <host> --cwd=/path      # cd after connecting
#
# Examples:
#   nbs-remote-session build-server.example.com
#   nbs-remote-session build-server.example.com --name=build --cwd=/home/user/project
#
#   # Then use normally:
#   nbs-ts send <handle> 'make -j8'
#   nbs-ts read-new <handle> --strip
#   nbs-ts kill <handle>
#
# Exit codes:
#   0 - Session created, handle printed to stdout
#   1 - SSH connection failed
#   2 - Invalid arguments

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_TS="${SCRIPT_DIR}/nbs-ts"
[[ -x "$NBS_TS" ]] || NBS_TS="${HOME}/.nbs/bin/nbs-ts"

die() { echo "Error: $*" >&2; exit "${1:-1}"; }

[[ -x "$NBS_TS" ]] || die 1 "nbs-ts not found"

# Parse arguments
HOST=""
NAME=""
CWD=""

for arg in "$@"; do
    case "$arg" in
        --name=*)  NAME="${arg#*=}" ;;
        --cwd=*)   CWD="${arg#*=}" ;;
        --help|-h)
            sed -n '2,/^$/{ /^#/p }' "$0" | cut -c3-
            exit 0
            ;;
        -*)        die 2 "Unknown option: $arg" ;;
        *)
            if [[ -z "$HOST" ]]; then
                HOST="$arg"
            else
                die 2 "Unexpected argument: $arg"
            fi
            ;;
    esac
done

[[ -n "$HOST" ]] || die 2 "Usage: nbs-remote-session <host> [--name=NAME] [--cwd=PATH]"

# Default idle timeout: 1 hour. Session self-terminates if no
# input received for this duration. Prevents zombie sessions
# when the owning agent dies without cleanup.
IDLE_TIMEOUT="${NBS_SESSION_IDLE_TIMEOUT:-3600}"

HANDLE=$("$NBS_TS" create --idle-timeout="$IDLE_TIMEOUT" "ssh -o StrictHostKeyChecking=no $HOST") || {
    die 1 "Failed to create nbs-ts session"
}

MARKER="__NBS_SESSION_READY_${RANDOM}__"
sleep 5
"$NBS_TS" send "$HANDLE" "echo $MARKER"
if ! "$NBS_TS" wait-pattern "$HANDLE" "$MARKER" --timeout=15 >/dev/null 2>&1; then
    "$NBS_TS" kill "$HANDLE" >/dev/null 2>&1 || true
    die 1 "SSH to $HOST timed out (15s)"
fi

if [[ -n "$CWD" ]]; then
    "$NBS_TS" send "$HANDLE" "cd $CWD"
    sleep 1
fi

echo "$HANDLE"
