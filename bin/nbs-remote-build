#!/bin/bash
# nbs-remote-build: Run a build command on a remote pty-session while staying
# chat-aware. Polls for build completion and checks chat between polls.
#
# Solves the "build-time chat blindness" problem: agents using pty-session
# to build on remote machines block on 'sleep 120' and can't read chat
# messages until the build finishes.
#
# Usage:
#   nbs-remote-build <session> <build-command> [options]
#
# Options:
#   --prompt=PATTERN   Shell prompt pattern to detect build completion
#                      (default: '\\$[[:space:]]*$' — matches $ at end of line)
#   --timeout=N        Build timeout in seconds (default: 300)
#   --poll=N           Poll interval in seconds (default: 5)
#   --chat=FILE        Chat file to check between polls (optional)
#   --handle=NAME      Chat handle for --unread (required if --chat is set)
#   --quiet            Don't print progress dots
#
# Examples:
#   # Basic: run build, wait for completion
#   nbs-remote-build my-server 'cmake --build build -j8'
#
#   # Chat-aware: check chat while building
#   nbs-remote-build my-server 'cmake --build build -j8' \
#       --chat=.nbs/chat/live.chat --handle=claude
#
#   # Custom prompt pattern (venv prompt)
#   nbs-remote-build my-server 'make -j8' --prompt='(venv)'
#
# Output:
#   Prints any unread chat messages as they arrive during the build.
#   When the build completes, prints the build output (last 50 lines).
#
# Exit codes:
#   0 - Build completed (prompt detected)
#   1 - General error
#   2 - Session not found
#   3 - Build timed out
#   4 - Invalid arguments

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_TS="${SCRIPT_DIR}/nbs-ts"
[[ -x "$NBS_TS" ]] || NBS_TS="${HOME}/.nbs/bin/nbs-ts"
NBS_CHAT="${HOME}/.nbs/bin/nbs-chat"

[[ -x "$NBS_TS" ]] || {
    echo "ASSERTION FAILED: nbs-ts not found" >&2
    exit 1
}

# Suppress pty-session tool header (we ARE the higher-level tool)

# Detect session type: nbs-ts handles are 8 hex chars

# Defaults
SESSION=""
BUILD_CMD=""
PROMPT_PATTERN='\$ *>?\s*$|\)\s*\$'
TIMEOUT=300
POLL_INTERVAL=5
CHAT_FILE=""
CHAT_HANDLE=""
QUIET=false

usage() {
    grep '^#' "$0" | grep -v '!/bin/bash' | cut -c3-
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --prompt=*)
            PROMPT_PATTERN="${1#--prompt=}"
            shift
            ;;
        --timeout=*)
            TIMEOUT="${1#--timeout=}"
            shift
            ;;
        --poll=*)
            POLL_INTERVAL="${1#--poll=}"
            shift
            ;;
        --chat=*)
            CHAT_FILE="${1#--chat=}"
            shift
            ;;
        --handle=*)
            CHAT_HANDLE="${1#--handle=}"
            shift
            ;;
        --quiet)
            QUIET=true
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 4
            ;;
        *)
            if [[ -z "$SESSION" ]]; then
                SESSION="$1"
            elif [[ -z "$BUILD_CMD" ]]; then
                BUILD_CMD="$1"
            else
                echo "Error: unexpected argument: $1" >&2
                exit 4
            fi
            shift
            ;;
    esac
done

if [[ -z "$SESSION" ]] || [[ -z "$BUILD_CMD" ]]; then
    echo "Error: requires <session> and <build-command>" >&2
    echo "Usage: nbs-remote-build <session> <build-command> [options]" >&2
    exit 4
fi

if [[ -n "$CHAT_FILE" ]] && [[ -z "$CHAT_HANDLE" ]]; then
    echo "Error: --handle is required when --chat is set" >&2
    exit 4
fi

# Precondition: nbs-chat binary must exist when --chat is used
if [[ -n "$CHAT_FILE" ]]; then
    [[ -x "$NBS_CHAT" ]] || {
        echo "ASSERTION FAILED: nbs-chat not found or not executable at $NBS_CHAT, required when --chat is set. Install from https://github.com/SonicField/nbs-framework" >&2
        exit 1
    }
fi

# Validate numeric arguments — must be strictly positive integers
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] && (( TIMEOUT > 0 )) || { echo "Error: --timeout must be a positive integer > 0, got '$TIMEOUT'" >&2; exit 4; }
[[ "$POLL_INTERVAL" =~ ^[0-9]+$ ]] && (( POLL_INTERVAL > 0 )) || { echo "Error: --poll must be a positive integer > 0, got '$POLL_INTERVAL'" >&2; exit 4; }

# Validate regex pattern before entering poll loop
_regex_rc=0
echo "" | grep -qE "$PROMPT_PATTERN" 2>/dev/null || _regex_rc=$?
if (( _regex_rc == 2 )); then
    echo "Error: invalid --prompt regex: $PROMPT_PATTERN" >&2
    exit 4
fi

# Session dispatch helpers


# Verify session exists
if ! "$NBS_TS" read "$SESSION" --last=1 2>/dev/null >/dev/null 2>&1; then
    echo "Error: session '$SESSION' not found" >&2
    exit 2
fi

# Send the build command
if ! "$NBS_TS" send "$SESSION" "$BUILD_CMD"; then
    echo "Error: Failed to send build command to session '$SESSION'" >&2
    exit 1
fi

if [[ "$QUIET" != true ]]; then
    echo "Build started on $SESSION: $BUILD_CMD" >&2
    echo "Polling every ${POLL_INTERVAL}s (timeout: ${TIMEOUT}s)" >&2
fi

# Poll for completion, checking chat between polls
# Use wall-clock time to avoid cumulative drift from command overhead
start_time=$(date +%s)
elapsed=0
chat_messages_shown=0
consecutive_read_failures=0

while (( elapsed < TIMEOUT )); do
    sleep "$POLL_INTERVAL"
    now=$(date +%s)
    elapsed=$((now - start_time))

    # Check if build is done (prompt visible in last few lines)
    read_rc=0
    last_lines=$("$NBS_TS" read "$SESSION" --last=5 2>/dev/null) || read_rc=$?
    if (( read_rc != 0 )); then
        consecutive_read_failures=$((consecutive_read_failures + 1))
        if (( consecutive_read_failures >= 3 )); then
            echo "Error: session read failed $consecutive_read_failures consecutive times, session may be dead" >&2
            exit 1
        fi
    else
        consecutive_read_failures=0
    fi
    if echo "$last_lines" | grep -qE "$PROMPT_PATTERN"; then
        sentinel="NBS_SENTINEL_${RANDOM}_${RANDOM}"
        "$NBS_TS" send "$SESSION" "echo $sentinel" 2>/dev/null || true
        sleep 1
        sentinel_output=$("$NBS_TS" read "$SESSION" --last=5 2>/dev/null) || true
        if ! echo "$sentinel_output" | grep -qF "$sentinel"; then
            continue
        fi

        if [[ "$QUIET" != true ]]; then
            echo "" >&2
            echo "Build completed in ${elapsed}s" >&2
        fi

        build_output=$("$NBS_TS" read "$SESSION" --last=50 2>/dev/null) || {
            echo "Warning: build completed but could not read output from session '$SESSION'" >&2
        }
        if [[ -n "${build_output:-}" ]]; then
            echo "$build_output"
        fi
        exit 0
    fi

    # Check chat if configured
    if [[ -n "$CHAT_FILE" ]] && [[ -n "$CHAT_HANDLE" ]]; then
        unread_rc=0
        unread=$("$NBS_CHAT" read "$CHAT_FILE" --unread="$CHAT_HANDLE" 2>/dev/null) || unread_rc=$?
        if (( unread_rc != 0 )); then
            echo "Warning: nbs-chat read failed (exit $unread_rc), chat monitoring may be impaired" >&2
        fi
        if [[ -n "$unread" ]]; then
            echo "--- CHAT (during build) ---" >&2
            echo "$unread" >&2
            echo "--- END CHAT ---" >&2
            chat_messages_shown=$((chat_messages_shown + 1))
        fi
    fi

    # Progress indicator
    if [[ "$QUIET" != true ]]; then
        printf "." >&2
    fi
done

# Timeout
if [[ "$QUIET" != true ]]; then
    echo "" >&2
    echo "Build timed out after ${TIMEOUT}s" >&2
fi

# Print whatever output we have
if ! "$NBS_TS" read "$SESSION" --last=50 2>/dev/null; then
    echo "Warning: could not read final output from session '$SESSION'" >&2
fi
exit 3
