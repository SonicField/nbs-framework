#!/bin/bash
# nbs-chat-init: Bootstrap NBS framework infrastructure for a project
#
# Creates the tripod (bus, chat, scribe log) and optionally spawns AI
# instances via nbs-ts. This script is both executable automation and
# living documentation — read it to understand how the system fits
# together.
#
# Usage:
#   nbs-chat-init --name=NAME [OPTIONS]
#
#   --name=NAME           Chat name (required) — all resource names derive from this
#   --project-name=NAME   Override project name (default: dirname of pwd)
#   --force               Skip confirmation prompts
#   --dry-run             Print actions without executing
#   --spawn-scribe        Launch Scribe in nbs-ts session
#   --spawn-pythia        Launch Pythia in nbs-ts session
#   --spawn-all           Launch Scribe + Pythia + main Claude instance
#   --spawn-only          Skip infrastructure, just spawn agents (for restart)
#   --compact-log         Archive decision log if it exceeds threshold
#   --help                Show usage
#
# Exit codes:
#   0 - Success
#   1 - General error
#   4 - Invalid arguments
#
# Infrastructure created:
#   .nbs/events/           Bus event queue
#   .nbs/events/processed/ Acknowledged events
#   .nbs/events/config.yaml Bus + Pythia configuration
#   .nbs/chat/<name>.chat  Primary chat channel
#   .nbs/chat/archive/     Archived previous chats
#   .nbs/scribe/<name>-log.md Decision log (Scribe's output)
#   .nbs/project-id        4-char project identifier
#
# Tmux sessions (optional, named after chat):
#   nbs-scribe-<name>      Scribe instance (--spawn-scribe or --spawn-all)
#   nbs-pythia-<name>      Pythia instance (--spawn-pythia or --spawn-all)
#   nbs-claude-<name>      Main Claude instance (--spawn-all)

set -euo pipefail

# --- Configuration ---

# Violation 11 (HARDENING): Resolve PROJECT_ROOT to absolute path.
PROJECT_ROOT="$(cd "$(pwd)" && pwd -P)"
PROJECT_NAME=""
FORCE=false
DRY_RUN=false
SPAWN_SCRIBE=false
SPAWN_PYTHIA=false
SPAWN_ALL=false
SPAWN_ONLY=false
COMPACT_LOG=false
PROJECT_ID=""
CHAT_NAME=""  # Set via --name= (required)

# --- Output helpers ---

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

# V5.1: Use printf instead of echo -e to avoid mangling backslash sequences
info()  { printf '%b %s\n' "${BLUE}[nbs-chat-init]${NC}" "$*"; }
ok()    { printf '%b %s\n' "${GREEN}[nbs-chat-init]${NC}" "$*"; }
warn()  { printf '%b %s\n' "${YELLOW}[nbs-chat-init]${NC}" "$*"; }
error() { printf '%b %s\n' "${RED}[nbs-chat-init]${NC}" "$*" >&2; }

# --- CHAT_NAME validation ---
# Violation 3 (SECURITY): CHAT_NAME used unsanitised in session names.
# Restrict to safe characters to prevent session name injection.
validate_chat_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        error "CHAT_NAME contains invalid characters: '$name'"
        error "Allowed: alphanumeric, hyphen, underscore (regex: ^[a-zA-Z0-9_-]+\$)"
        exit 4
    fi
}

# --- PROJECT_NAME validation ---
# Audit Violation 4 (SECURITY): PROJECT_NAME used unsanitised in command prompts.
# Restrict to safe characters to prevent shell metacharacter injection into sessions.
validate_project_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-zA-Z0-9_.\ -]+$ ]]; then
        error "PROJECT_NAME contains invalid characters: '$name'"
        error "Allowed: alphanumeric, hyphen, underscore, dot, space (regex: ^[a-zA-Z0-9_. -]+\$)"
        exit 4
    fi
}

# --- Dry-run wrapper ---
# Every side-effectful operation goes through run().
# In dry-run mode, the command is printed but not executed.
# Reading the dry-run output is equivalent to reading a specification.

run() {
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "$*"
        return 0
    fi
    "$@"
}

# --- Assertion helpers ---

assert_not_empty() {
    local var_name="$1"
    local var_value="$2"
    [[ -n "$var_value" ]] || {
        error "ASSERTION FAILED: $var_name is empty"
        exit 4
    }
}

assert_tool_exists() {
    local tool="$1"
    command -v "$tool" >/dev/null 2>&1 || {
        error "Required tool not found: $tool"
        error "Ensure NBS tools are installed and on PATH."
        error "Run: ./bin/install.sh"
        exit 1
    }
}

assert_directory_exists() {
    local dir="$1"
    [[ -d "$dir" ]] || {
        error "ASSERTION FAILED: Directory not found: $dir"
        exit 1
    }
}

assert_file_exists() {
    local file="$1"
    [[ -f "$file" ]] || {
        error "ASSERTION FAILED: File not found: $file"
        exit 1
    }
}

# --- Interaction ---

confirm() {
    local message="$1"
    if [[ "$FORCE" == "true" ]]; then
        return 0
    fi
    read -rp "$(printf '%b %s [y/N]: ' "${YELLOW}[nbs-chat-init]${NC}" "$message")" answer
    case "$answer" in
        [Yy]|[Yy]es) return 0 ;;
        *) return 1 ;;
    esac
}

# --- Project identity ---

generate_project_id() {
    local path="$1"
    assert_not_empty "path" "$path"
    # Violation 10 (HARDENING): Check sha256sum return value.
    local hash
    hash=$(echo -n "$path" | sha256sum) || {
        error "sha256sum failed for project ID generation"
        exit 1
    }
    echo "$hash" | head -c 4
}


# nbs-ts detection
SCRIPT_DIR_INIT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_TS_BIN="${SCRIPT_DIR_INIT}/nbs-ts"
[[ -x "$NBS_TS_BIN" ]] || NBS_TS_BIN="${HOME}/.nbs/bin/nbs-ts"
USE_NBS_TS_INIT=0
[[ -x "$NBS_TS_BIN" ]] && USE_NBS_TS_INIT=1

# Spawn an agent via nbs-ts. Returns the handle in SPAWN_HANDLE.
# Usage: spawn_agent_ts <role> <nbs-claude-path> <project-root> [prompt]
SPAWN_HANDLE=""
spawn_agent_ts() {
    local role="$1"
    local nbs_claude="$2"
    local project_root="$3"
    local prompt="${4:-}"

    # SECURITY RISK: --dangerously-skip-permissions bypasses Claude's permission system.
    # Architectural decision: NBS agents run autonomously in monitored sessions;
    # the permission system is replaced by NBS-level controls (bus, watchdog, scribe).
    SPAWN_HANDLE=$("$NBS_TS_BIN" create "cd $(printf '%q' "$project_root") && NBS_HANDLE=${role} NBS_TRANSPORT=ts ${nbs_claude} --dangerously-skip-permissions") || {
        error "Failed to create nbs-ts session for $role"
        return 1
    }

    # Wait for CLI readiness (handle injection)
    local wait_count=0
    local max_wait=60
    while [ "$wait_count" -lt "$max_wait" ]; do
        if "$NBS_TS_BIN" read "$SPAWN_HANDLE" 2>/dev/null | grep -q 'handle is'; then
            break
        fi
        sleep 1
        wait_count=$((wait_count + 1))
    done

    if [ "$wait_count" -ge "$max_wait" ]; then
        warn "  $role CLI did not become ready within ${max_wait}s"
    fi

    # Send role prompt if provided
    if [[ -n "$prompt" ]]; then
        "$NBS_TS_BIN" send "$SPAWN_HANDLE" "$prompt" 2>/dev/null || true
        sleep 1
        "$NBS_TS_BIN" send "$SPAWN_HANDLE" "" 2>/dev/null || true
    fi
}

# --- Argument parsing ---

for arg in "$@"; do
    case "$arg" in
        --name=*)
            CHAT_NAME="${arg#--name=}"
            ;;
        --project-name=*)
            PROJECT_NAME="${arg#--project-name=}"
            ;;
        --force)
            FORCE=true
            ;;
        --dry-run)
            DRY_RUN=true
            ;;
        --spawn-scribe)
            SPAWN_SCRIBE=true
            ;;
        --spawn-pythia)
            SPAWN_PYTHIA=true
            ;;
        --spawn-all)
            SPAWN_ALL=true
            SPAWN_SCRIBE=true
            SPAWN_PYTHIA=true
            ;;
        --spawn-only)
            SPAWN_ONLY=true
            ;;
        --root=*)
            PROJECT_ROOT="$(cd "${arg#--root=}" && pwd -P)"
            ;;
        --compact-log)
            COMPACT_LOG=true
            ;;
        --help|-h)
            cat <<'USAGE'
nbs-chat-init: Bootstrap NBS framework infrastructure for any project

Usage: nbs-chat-init --name=NAME [OPTIONS]

  Sets up a project directory with everything needed for an NBS AI team.
  Run this once in any project (even non-NBS projects) and you're ready
  to start a team with nbs-chat-terminal.

Example:
  cd ~/local/FooBar
  nbs-chat-init --name=foobar-dev
  nbs-chat-terminal .nbs/chat/foobar-dev.chat alex --goal-file=goal.md --restart

  Or from anywhere:
  nbs-chat-init --name=phoenix-ts --root=~/local/phoenix

Required:
  --name=NAME             Chat name — all resource names derive from this

Options:
  --root=PATH             Project root directory (default: current directory)
  --project-name=NAME     Override project name (default: dirname of root)
  --force                 Skip confirmation prompts
  --dry-run               Print actions without executing
  --spawn-scribe          Launch Scribe in nbs-ts session
  --spawn-pythia          Launch Pythia in nbs-ts session
  --spawn-all             Launch Scribe + Pythia + main Claude instance
  --spawn-only            Skip infrastructure creation, just spawn agents (for restart)
  --compact-log           Archive decision log if it exceeds threshold (100 entries)
  --help                  Show this help

Infrastructure created:
  .nbs/events/            Event bus queue
  .nbs/chat/<name>.chat   Primary chat channel
  .nbs/scribe/<name>-log.md Decision log
  .nbs/workers/           Ephemeral worker task files
  .nbs/pids/              Agent PID tracking
  .nbs/commands/          Skill files (symlinked from ~/.nbs/commands/)
  .nbs/docs/              Tool reference (symlinked from ~/.nbs/docs/)

Spawn only (restart after reboot):
  nbs-chat-init --name=NAME --spawn-only --spawn-scribe
  nbs-chat-init --name=NAME --spawn-only --spawn-all

Join an existing chat (human):
  nbs-chat-terminal .nbs/chat/<name>.chat <your-handle>

Join an existing chat (additional agent):
  NBS_HANDLE=<unique-name> nbs-claude

Exit codes:
  0 - Success
  1 - General error
  4 - Invalid arguments
USAGE
            exit 0
            ;;
        *)
            error "Unknown argument: $arg"
            error "Run: nbs-chat-init --help"
            exit 4
            ;;
    esac
done

# --- Validate arguments ---

if [[ -z "$CHAT_NAME" ]]; then
    error "Missing required argument: --name=NAME"
    error "Run: nbs-chat-init --help"
    exit 4
fi

# Violation 3 (SECURITY): Validate CHAT_NAME before use in session names.
validate_chat_name "$CHAT_NAME"

# Violation 8 (HARDENING): Assert PROJECT_ROOT is a valid directory.
assert_directory_exists "$PROJECT_ROOT"

if [[ "$SPAWN_ONLY" == "true" ]] && [[ "$SPAWN_SCRIBE" != "true" ]] && [[ "$SPAWN_PYTHIA" != "true" ]] && [[ "$SPAWN_ALL" != "true" ]]; then
    error "--spawn-only requires --spawn-scribe, --spawn-pythia, or --spawn-all"
    exit 4
fi

# --- Derived paths (all resource names derive from CHAT_NAME) ---
# Violation 11 (HARDENING): Resolve all derived paths to absolute.

CHAT_FILE="${PROJECT_ROOT}/.nbs/chat/${CHAT_NAME}.chat"
CHAT_CURSORS="${CHAT_FILE}.cursors"
CHAT_LOCK="${CHAT_FILE}.lock"
SCRIBE_LOG="${PROJECT_ROOT}/.nbs/scribe/${CHAT_NAME}-log.md"

# --- Validate prerequisites ---

info "Checking prerequisites..."
# Violation 14 (HARDENING): Assert all required binaries exist.
assert_tool_exists "nbs-chat"
assert_tool_exists "nbs-bus"
assert_tool_exists "sha256sum"
assert_tool_exists "date"
assert_tool_exists "grep"
assert_tool_exists "sed"
assert_tool_exists "basename"

if [[ "$SPAWN_SCRIBE" == "true" ]] || [[ "$SPAWN_PYTHIA" == "true" ]] || [[ "$SPAWN_ALL" == "true" ]]; then
    assert_tool_exists "nbs-ts"
    assert_tool_exists "nbs-claude"
fi

# --- Project detection ---

if [[ -z "$PROJECT_NAME" ]]; then
    PROJECT_NAME="$(basename "$PROJECT_ROOT")"
fi

# Audit Violation 4 (SECURITY): Validate PROJECT_NAME before use in command prompts.
validate_project_name "$PROJECT_NAME"

PROJECT_ID=$(generate_project_id "$PROJECT_ROOT")

echo ""
printf '%b\n' "${BOLD}NBS Init${NC}"
echo "  Project:    $PROJECT_NAME"
echo "  Chat name:  $CHAT_NAME"
echo "  Root:       $PROJECT_ROOT"
echo "  Project ID: $PROJECT_ID"
if [[ "$DRY_RUN" == "true" ]]; then
    printf '  Mode:       %b\n' "${YELLOW}DRY RUN${NC}"
fi
if [[ "$SPAWN_ONLY" == "true" ]]; then
    printf '  Mode:       %b\n' "${YELLOW}SPAWN ONLY${NC}"
fi
echo ""

# ============================================================
# PHASES 1-4: Infrastructure Creation (skipped in spawn-only mode)
# ============================================================

if [[ "$SPAWN_ONLY" != "true" ]]; then

# Check for existing .nbs/
# V5.2: Use absolute path for .nbs directory check
if [[ -d "$PROJECT_ROOT/.nbs" ]]; then
    warn "Existing .nbs/ directory found."
    if ! confirm "Re-initialise? (existing data will be preserved)"; then
        info "Cancelled."
        exit 0
    fi
fi

# ============================================================
# PHASE 0: Scorched Earth — remove all state from previous runs
# ============================================================

info "Phase 0: Clearing previous state..."

# Derive chat tag for session name filtering
INIT_TAG=$(echo "$CHAT_NAME" | tr '.' '-')

# Kill processes first — files second.
# nbs-ts sessions belonging to this project
if [[ -x "$NBS_TS_BIN" ]]; then
    while IFS=$'\t' read -r ts_handle ts_status ts_name ts_cmd; do
        [[ -n "$ts_handle" ]] || continue
        "$NBS_TS_BIN" kill "$ts_handle" 2>/dev/null || true
    done < <("$NBS_TS_BIN" list --name="$INIT_TAG" 2>/dev/null || true)
fi

# Kill nbs-claude wrappers via pid files
if [[ -d "${PROJECT_ROOT}/.nbs/pids" ]]; then
    for pidfile in "${PROJECT_ROOT}/.nbs/pids/"*.pid; do
        [[ -f "$pidfile" ]] || continue
        oldpid=$(cat "$pidfile" 2>/dev/null)
        if [[ -n "$oldpid" && "$oldpid" =~ ^[0-9]+$ ]]; then
            kill "$oldpid" 2>/dev/null || true
        fi
    done
fi

# Kill sidecars for this project
pkill -f "nbs-sidecar.*--root=${PROJECT_ROOT}" 2>/dev/null || true

# Wait for processes to die
sleep 2

# Force-kill any survivors
if [[ -d "${PROJECT_ROOT}/.nbs/pids" ]]; then
    for pidfile in "${PROJECT_ROOT}/.nbs/pids/"*.pid; do
        [[ -f "$pidfile" ]] || continue
        oldpid=$(cat "$pidfile" 2>/dev/null)
        if [[ -n "$oldpid" && "$oldpid" =~ ^[0-9]+$ ]]; then
            kill -9 "$oldpid" 2>/dev/null || true
        fi
    done
fi

# Now remove all files — no process holds them.

# Control files
run rm -f "${PROJECT_ROOT}/.nbs/control-pause"
for f in "${PROJECT_ROOT}/.nbs/"control-registry-*; do
    [[ -f "$f" ]] && run rm -f "$f"
done

# Session metadata and pid files
run rm -f "${PROJECT_ROOT}/.nbs/pids/"*.pid
run rm -f "${PROJECT_ROOT}/.nbs/sessions/"*.json

# Trigger timestamps
run rm -f "${PROJECT_ROOT}/.nbs/librarian-last-run"
run rm -f "${PROJECT_ROOT}/.nbs/pythia-last-run"
run rm -f "${PROJECT_ROOT}/.nbs/shepard-last-run"
run rm -f "${PROJECT_ROOT}/.nbs/fixup-last-run"

# Worker task files and logs from previous runs
if [[ -d "${PROJECT_ROOT}/.nbs/workers" ]]; then
    run rm -f "${PROJECT_ROOT}/.nbs/workers/"*.md
    run rm -f "${PROJECT_ROOT}/.nbs/workers/"*.log
fi

# Bus events — pending and processed
if [[ -d "${PROJECT_ROOT}/.nbs/events" ]]; then
    find "${PROJECT_ROOT}/.nbs/events" -maxdepth 1 -name '*.event' -delete 2>/dev/null || true
    if [[ -d "${PROJECT_ROOT}/.nbs/events/processed" ]]; then
        find "${PROJECT_ROOT}/.nbs/events/processed" -name '*.event' -delete 2>/dev/null || true
    fi
fi

# Sidecar logs
run rm -f "${PROJECT_ROOT}/.nbs/nbs-claude-"*.log
run rm -f "${PROJECT_ROOT}/.nbs/sidecar-"*.log

# Scribe log and archives
if [[ -d "${PROJECT_ROOT}/.nbs/scribe" ]]; then
    run rm -f "${PROJECT_ROOT}/.nbs/scribe/"*.md
    run rm -f "${PROJECT_ROOT}/.nbs/scribe/"*.lock
fi

# Digests
if [[ -d "${PROJECT_ROOT}/.nbs/digests" ]]; then
    run rm -f "${PROJECT_ROOT}/.nbs/digests/"*.md
fi

ok "  Previous state destroyed"

# ============================================================
# PHASE 1: Bus Infrastructure
# ============================================================

info "Phase 1: Event bus..."

# 1.1 Create bus directories
# V5.3: Use absolute path for bus directory
run mkdir -p "${PROJECT_ROOT}/.nbs/events/processed"

# 1.2 Write config (only if missing)
# V5.4: Use absolute paths for config.yaml
if [[ ! -f "${PROJECT_ROOT}/.nbs/events/config.yaml" ]] || [[ "$DRY_RUN" == "true" ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Write .nbs/events/config.yaml (defaults)"
    else
        # Violation 7 (BUG): cat heredoc bypasses run(). This is intentional:
        # the enclosing DRY_RUN guard prevents execution in dry-run mode,
        # and cat heredocs cannot be meaningfully routed through run().
        cat > "${PROJECT_ROOT}/.nbs/events/config.yaml" << 'CONFIGEOF'
# NBS Event Bus Configuration
#
# dedup-window:  Seconds to suppress duplicate events (default: 0 = disabled)
#                System events use this as the default. Chat events pass
#                --dedup-window=0 to nbs-bus to bypass dedup entirely.
# ack-timeout:   Seconds before unacknowledged events are flagged stale (default: 120)
# pythia-interval: Scribe decisions between Pythia checkpoints (default: 10)
# retention-max-bytes: Maximum total size of processed events before pruning (default: 16MB)

dedup-window: 300
ack-timeout: 120
pythia-interval: 10
retention-max-bytes: 16777216
CONFIGEOF
        ok "  config.yaml written"
    fi
else
    info "  config.yaml already exists — keeping"
fi

# 1.3 Bus self-test: publish, check, ack, verify
info "  Bus self-test..."
if [[ "$DRY_RUN" == "true" ]]; then
    printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "nbs-bus publish → check → ack → verify"
else
    # Use a unique event type per invocation to avoid dedup window collisions
    # Audit Violation 5 (HARDENING): Check date +%s return value.
    self_test_ts=$(date +%s) || {
        error "date command failed during self-test event type generation"
        exit 1
    }
    SELF_TEST_TYPE="self-test-${self_test_ts}"

    # Publish a test event
    # Violation 4 (BUG): Check nbs-bus publish return value.
    # V5.6: Use absolute paths for all bus self-test operations
    if ! nbs-bus publish "${PROJECT_ROOT}/.nbs/events/" nbs-chat-init "$SELF_TEST_TYPE" low "nbs-chat-init self-test" >/dev/null 2>&1; then
        warn "  nbs-bus publish failed during self-test (exit $?)"
    fi

    # Find and acknowledge it
    # Violation 1 (SECURITY): Use find with -print0 instead of unquoted glob + ls + xargs.
    SELF_TEST_EVENT=$(find "${PROJECT_ROOT}/.nbs/events/" -maxdepth 1 -name "*nbs-chat-init*self-test*.event" -print0 2>/dev/null \
        | xargs -0 -r -n1 basename 2>/dev/null | head -1)
    if [[ -n "$SELF_TEST_EVENT" ]]; then
        # Violation 13 (HARDENING): Check nbs-bus ack return value, log warning on failure.
        if ! nbs-bus ack "${PROJECT_ROOT}/.nbs/events/" "$SELF_TEST_EVENT" >/dev/null 2>&1; then
            warn "  nbs-bus ack failed for self-test event '$SELF_TEST_EVENT'"
        fi

        # Verify it reached processed/
        if [[ -f "${PROJECT_ROOT}/.nbs/events/processed/$SELF_TEST_EVENT" ]]; then
            ok "  Bus self-test passed"
        else
            error "  Bus self-test: event not found in processed/"
            exit 1
        fi
    else
        # If no event was created, the bus binary may have deduped it or failed.
        # Fall back to checking bus status — if status works, the bus is operational.
        if nbs-bus status "${PROJECT_ROOT}/.nbs/events/" >/dev/null 2>&1; then
            ok "  Bus self-test passed (via status check)"
        else
            error "  Bus self-test: no event file created and status check failed"
            exit 1
        fi
    fi
fi

# ============================================================
# PHASE 2: Chat
# ============================================================

info "Phase 2: Chat..."

# V5.3: Use absolute path for chat archive directory
run mkdir -p "${PROJECT_ROOT}/.nbs/chat/archive"

# 2.1 Archive existing chat (if present)
if [[ -f "$CHAT_FILE" ]]; then
    ARCHIVE_TS=$(date +%Y%m%d_%H%M%S)
    ARCHIVE_NAME="${CHAT_NAME}-${ARCHIVE_TS}.chat"
    info "  Archiving existing ${CHAT_NAME}.chat → archive/$ARCHIVE_NAME"
    run mv "$CHAT_FILE" "${PROJECT_ROOT}/.nbs/chat/archive/$ARCHIVE_NAME"
    if [[ -f "$CHAT_CURSORS" ]]; then
        run mv "$CHAT_CURSORS" "${PROJECT_ROOT}/.nbs/chat/archive/${ARCHIVE_NAME}.cursors"
    fi
    if [[ -f "$CHAT_LOCK" ]]; then
        run rm -f "$CHAT_LOCK"
    fi
fi

# 2.2 Create fresh chat
if [[ "$DRY_RUN" == "true" ]]; then
    printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "nbs-chat create $CHAT_FILE"
else
    # Violation 5 (BUG): Check nbs-chat create return value.
    if ! nbs-chat create "$CHAT_FILE" >/dev/null 2>&1; then
        error "nbs-chat create failed for '$CHAT_FILE'"
        exit 1
    fi
    ok "  ${CHAT_NAME}.chat created"
fi

# 2.3 Post init message
if [[ "$DRY_RUN" == "true" ]]; then
    printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "nbs-chat send init message"
else
    # Violation 5 (BUG): Check nbs-chat send return value.
    if ! nbs-chat send "$CHAT_FILE" nbs-chat-init \
        "Project '$PROJECT_NAME' initialised (project-id: $PROJECT_ID). Bus, chat, and scribe log are ready." \
        >/dev/null 2>&1; then
        error "nbs-chat send failed for init message"
        exit 1
    fi
    ok "  Init message posted"
fi

# ============================================================
# PHASE 3: Scribe Log
# ============================================================

info "Phase 3: Scribe log..."

# V5.3: Use absolute path for scribe directory
run mkdir -p "${PROJECT_ROOT}/.nbs/scribe"

if [[ ! -f "$SCRIBE_LOG" ]] || [[ "$DRY_RUN" == "true" ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Write $SCRIBE_LOG (header)"
    else
        CREATED_TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        # Violation 7 (BUG): cat heredoc bypasses run(). Intentional — guarded by DRY_RUN check above.
        cat > "$SCRIBE_LOG" << LOGEOF
# Decision Log

Project: $PROJECT_NAME
Created: $CREATED_TS
Scribe: scribe
Chat: ${CHAT_NAME}.chat
Decision count: 0

---
LOGEOF
        ok "  ${CHAT_NAME}-log.md created"
    fi
else
    info "  ${CHAT_NAME}-log.md already exists — keeping"
fi

# --- Log compaction (progressive archival) ---
# If the decision log exceeds 100 entries, archive it and start a new one.
# The first record in the new log points to the archive (linked list).
# Triggered automatically during init or manually with --compact-log.

COMPACT_THRESHOLD=100

compact_decision_log() {
    local log_file="$1"
    local entry_count
    entry_count=$(grep -c '^### D-' "$log_file" 2>/dev/null || echo 0)

    if [[ "${entry_count:-0}" -lt "$COMPACT_THRESHOLD" ]] && [[ "$COMPACT_LOG" != "true" ]]; then
        info "  Decision log: $entry_count entries (threshold: $COMPACT_THRESHOLD) — no compaction needed"
        return 0
    fi

    if [[ "${entry_count:-0}" -eq 0 ]]; then
        info "  Decision log: empty — nothing to compact"
        return 0
    fi

    local archive_ts
    archive_ts=$(date +%Y%m%d-%H%M%S)
    local archive_file="${PROJECT_ROOT}/.nbs/scribe/${CHAT_NAME}-log-archive-${archive_ts}.md"

    if [[ "$DRY_RUN" == "true" ]]; then
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Archive $log_file ($entry_count entries) → $archive_file"
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Create new $log_file with link to archive"
        return 0
    fi

    # Move current log to archive
    # Violation 7 (BUG): Route mv through run() for dry-run compatibility.
    run mv "$log_file" "$archive_file"

    # Extract header fields from the archive for the new log
    local project_name
    project_name=$(grep '^Project:' "$archive_file" | head -1 | sed 's/^Project: //')
    # Audit Violation 6 (BUG): Warn on missing archive headers instead of silently masking.
    if [[ -z "$project_name" ]]; then
        warn "  Archive '$archive_file' missing 'Project:' header, using default '$PROJECT_NAME'"
    fi
    local chat_ref
    chat_ref=$(grep '^Chat:' "$archive_file" | head -1 | sed 's/^Chat: //')
    if [[ -z "$chat_ref" ]]; then
        warn "  Archive '$archive_file' missing 'Chat:' header, using default '${CHAT_NAME}.chat'"
    fi
    local created_ts
    created_ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    # Create new log with link to archive as first record
    # Violation 7 (BUG): cat heredoc bypasses run(). Intentional — guarded by DRY_RUN check above.
    cat > "$log_file" << COMPACTEOF
# Decision Log

Project: ${project_name:-$PROJECT_NAME}
Created: $created_ts
Scribe: scribe
Chat: ${chat_ref:-${CHAT_NAME}.chat}
Decision count: 0
Previous log: $archive_file

---

### ARCHIVE-LINK
- **Previous log:** \`$archive_file\`
- **Entries archived:** $entry_count
- **Archived at:** $created_ts
- **Rationale:** Decision log exceeded compaction threshold ($COMPACT_THRESHOLD entries). All previous decisions are preserved in the archive file. This is the continuation log.

---
COMPACTEOF

    ok "  Compacted: $entry_count entries archived → $archive_file"
    info "  New log created with link to archive"
}

if [[ -f "$SCRIBE_LOG" ]]; then
    compact_decision_log "$SCRIBE_LOG"
fi

# ============================================================
# PHASE 4: Project Identity
# ============================================================

info "Phase 4: Project identity..."

if [[ "$DRY_RUN" == "true" ]]; then
    printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Write .nbs/project-id ($PROJECT_ID)"
else
    # Violation 7 (BUG): echo redirect bypasses run(). Intentional — guarded by DRY_RUN check above.
    # V5.5: Use absolute path for project-id
    echo "$PROJECT_ID" > "${PROJECT_ROOT}/.nbs/project-id"
    ok "  project-id: $PROJECT_ID"
fi

# ============================================================
# PHASE 4b: Operational Directories and Skills
# ============================================================

info "Phase 4b: Operational directories..."

# Create directories needed by agents, workers, and sidecar
for dir in workers pids pty-locks sessions; do
    run mkdir -p "${PROJECT_ROOT}/.nbs/${dir}"
done
ok "  workers/, pids/, pty-locks/, sessions/"

# Link binaries from global ~/.nbs/bin/ if available.
# Agents and the restart script look for nbs-chat, nbs-bus, etc. here.
NBS_GLOBAL_BIN="$HOME/.nbs/bin"
PROJECT_BIN="${PROJECT_ROOT}/.nbs/bin"
if [[ -d "$NBS_GLOBAL_BIN" ]] && [[ ! -e "$PROJECT_BIN" ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Link $NBS_GLOBAL_BIN → $PROJECT_BIN"
    else
        ln -s "$NBS_GLOBAL_BIN" "$PROJECT_BIN"
        ok "  bin/ → $NBS_GLOBAL_BIN (symlinked)"
    fi
elif [[ -e "$PROJECT_BIN" ]]; then
    info "  bin/ already exists — keeping"
else
    warn "  No global binaries found at $NBS_GLOBAL_BIN — tools will not work"
    warn "  Install NBS first: cd nbs-framework && make install"
fi

# Link or copy skills from global ~/.nbs/commands/ if available.
# These give agents access to librarian, pythia, shepard, fixup, etc.
NBS_GLOBAL_COMMANDS="$HOME/.nbs/commands"
PROJECT_COMMANDS="${PROJECT_ROOT}/.nbs/commands"
if [[ -d "$NBS_GLOBAL_COMMANDS" ]] && [[ ! -d "$PROJECT_COMMANDS" ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Link $NBS_GLOBAL_COMMANDS → $PROJECT_COMMANDS"
    else
        ln -s "$NBS_GLOBAL_COMMANDS" "$PROJECT_COMMANDS"
        ok "  commands/ → $NBS_GLOBAL_COMMANDS (symlinked)"
    fi
elif [[ -d "$PROJECT_COMMANDS" ]]; then
    info "  commands/ already exists — keeping"
else
    warn "  No global commands found at $NBS_GLOBAL_COMMANDS — agents will lack skills"
fi

# Link docs from global ~/.nbs/docs/ if available (tools.md, etc.)
NBS_GLOBAL_DOCS="$HOME/.nbs/docs"
PROJECT_DOCS="${PROJECT_ROOT}/.nbs/docs"
if [[ -d "$NBS_GLOBAL_DOCS" ]] && [[ ! -d "$PROJECT_DOCS" ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Link $NBS_GLOBAL_DOCS → $PROJECT_DOCS"
    else
        ln -s "$NBS_GLOBAL_DOCS" "$PROJECT_DOCS"
        ok "  docs/ → $NBS_GLOBAL_DOCS (symlinked)"
    fi
elif [[ -d "$PROJECT_DOCS" ]]; then
    info "  docs/ already exists — keeping"
fi

fi  # end of SPAWN_ONLY != true

# ============================================================
# PHASE 5: Health Check
# ============================================================

info "Phase 5: Health check..."

if [[ "$DRY_RUN" == "true" ]]; then
    printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "nbs-bus status ${PROJECT_ROOT}/.nbs/events/"
    printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "nbs-chat read $CHAT_FILE"
    printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Verify $SCRIBE_LOG header"
else
    HEALTH_PASS=true

    # V5.7: Use absolute paths for bus status check
    if nbs-bus status "${PROJECT_ROOT}/.nbs/events/" >/dev/null 2>&1; then
        ok "  Bus: operational"
    else
        error "  Bus: FAILED"
        HEALTH_PASS=false
    fi

    # Chat
    if nbs-chat read "$CHAT_FILE" >/dev/null 2>&1; then
        ok "  Chat: operational"
    else
        error "  Chat: FAILED"
        HEALTH_PASS=false
    fi

    # Scribe log
    if grep -q "^Project:" "$SCRIBE_LOG" 2>/dev/null && \
       grep -q "^Decision count:" "$SCRIBE_LOG" 2>/dev/null; then
        ok "  Scribe log: well-formed"
    else
        error "  Scribe log: FAILED (missing header fields)"
        HEALTH_PASS=false
    fi

    if [[ "$HEALTH_PASS" != "true" ]]; then
        error "Health check failed. Infrastructure may be incomplete."
        exit 1
    fi
fi

# ============================================================
# PHASE 6: AI Spawn (optional)
# ============================================================

if [[ "$SPAWN_SCRIBE" == "true" ]] || [[ "$SPAWN_PYTHIA" == "true" ]] || [[ "$SPAWN_ALL" == "true" ]]; then
    echo ""
    info "Phase 6: AI spawn..."

    # --- Scribe ---
    if [[ "$SPAWN_SCRIBE" == "true" ]]; then
        SCRIBE_PROMPT="You are the Scribe. Load /nbs-scribe. Your handle is 'scribe'. Monitor $CHAT_FILE and log decisions to $SCRIBE_LOG. Publish decision-logged bus events. Check pythia-interval threshold and publish pythia-checkpoint events when reached. Do not participate in conversation — only observe and record."

        info "  Spawning Scribe..."
        if [[ "$DRY_RUN" == "true" ]]; then
            printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Spawn scribe via nbs-ts"
        else
            spawn_agent_ts "scribe" "nbs-claude" "$PROJECT_ROOT" "$SCRIBE_PROMPT"
            ok "  Scribe spawned: nbs-ts $SPAWN_HANDLE"
            info "  Attach: nbs-ts attach $SPAWN_HANDLE"
        fi
    fi

    # --- Pythia ---
    if [[ "$SPAWN_PYTHIA" == "true" ]]; then
        PYTHIA_PROMPT="You are Pythia — the oracle. Load /nbs-pythia. Your handle is 'pythia'. Read the decision log at $SCRIBE_LOG. Post your structured assessment to $CHAT_FILE. When your assessment is posted and the bus event published, exit."

        info "  Spawning Pythia..."
        if [[ "$DRY_RUN" == "true" ]]; then
            printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Spawn pythia via nbs-ts"
        else
            spawn_agent_ts "pythia" "nbs-claude" "$PROJECT_ROOT" "$PYTHIA_PROMPT"
            ok "  Pythia spawned: nbs-ts $SPAWN_HANDLE"
            info "  Attach: nbs-ts attach $SPAWN_HANDLE"
        fi
    fi

    # --- Main Claude (--spawn-all only) ---
    if [[ "$SPAWN_ALL" == "true" ]]; then
        info "  Spawning Claude..."
        if [[ "$DRY_RUN" == "true" ]]; then
            printf '  %b %s\n' "${YELLOW}[DRY-RUN]${NC}" "Spawn claude via nbs-ts"
        else
            spawn_agent_ts "claude" "nbs-claude" "$PROJECT_ROOT"
            ok "  Claude spawned: nbs-ts $SPAWN_HANDLE"
            info "  Attach: nbs-ts attach $SPAWN_HANDLE"
        fi
    fi

    # Publish spawn event
    # Violation 6 (BUG): Replace || true with proper error handling — log warning but continue.
    if [[ "$DRY_RUN" != "true" ]]; then
        if ! nbs-bus publish "${PROJECT_ROOT}/.nbs/events/" nbs-chat-init ai-spawned normal \
            "AI instances spawned by nbs-chat-init" >/dev/null 2>&1; then
            warn "nbs-bus publish failed for ai-spawned event (non-fatal, continuing)"
        fi
    fi
fi

