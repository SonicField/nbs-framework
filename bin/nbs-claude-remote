#!/bin/bash
# nbs-claude-remote: Launch Claude Code on a remote machine via SSH
#
# SSHs to a remote machine, starts nbs-claude in an nbs-ts session there,
# and attaches your local terminal. All file access (bus, chat, scribe)
# happens on the remote machine where .nbs/ lives.
#
# Usage:
#   nbs-claude-remote --host=USER@HOST --root=PATH [OPTIONS]
#
# Required:
#   --host=USER@HOST      SSH target (e.g. user@remote-host)
#   --root=PATH           Project root on the remote machine (must contain .nbs/)
#
# Options:
#   --handle=NAME         Agent handle (default: remote)
#   --name=NAME           Chat name for session naming (default: live)
#   --ssh-key=PATH        SSH key file (default: use ssh-agent)
#   --ssh-opts=OPTS       Additional SSH options, space-separated single tokens
#                         (e.g. '-o ControlPath=none'). Compound options with
#                         embedded spaces are NOT supported in a single invocation.
#   --resume              Attach to existing remote nbs-ts session instead of creating
#   --list                List existing NBS nbs-ts sessions on the remote
#   --help                Show usage
#
# Examples:
#   nbs-claude-remote --host=user@remote-host --root=~/project
#   nbs-claude-remote --host=user@remote-host --root=~/project --handle=worker1
#   nbs-claude-remote --host=user@remote-host --root=~/project --resume
#   nbs-claude-remote --host=user@remote-host --list
#
# Exit codes:
#   0 - Clean exit
#   1 - General error
#   4 - Invalid arguments

set -euo pipefail

# --- Cleanup trap (HARDENING #11) ---

CLEANUP_DONE=false
cleanup() {
    # STRUCTURAL SCAFFOLDING: no resources currently require cleanup.
    # This trap exists so future resource management (temp files, background
    # processes) has a single well-defined teardown path.
    if [[ "$CLEANUP_DONE" == "true" ]]; then
        return
    fi
    CLEANUP_DONE=true
}
trap cleanup EXIT INT TERM HUP

# --- Configuration ---

HOST=""
ROOT=""
HANDLE="remote"
CHAT_NAME="live"
SSH_KEY=""
SSH_OPTS=""
RESUME=false
LIST=false
SSH_OPTS_ARRAY=()

# --- Output helpers ---

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

info()  { printf '%b %s\n' "${BLUE}[nbs-claude-remote]${NC}" "$*"; }
ok()    { printf '%b %s\n' "${GREEN}[nbs-claude-remote]${NC}" "$*"; }
warn()  { printf '%b %s\n' "${YELLOW}[nbs-claude-remote]${NC}" "$*"; }
error() { printf '%b %s\n' "${RED}[nbs-claude-remote]${NC}" "$*" >&2; }

# --- Validation helpers ---

validate_safe_name() {
    local label="$1"
    local value="$2"
    if [[ ! "$value" =~ ^[A-Za-z0-9_-]+$ ]]; then
        error "Invalid $label: '$value' — must match ^[A-Za-z0-9_-]+\$"
        exit 4
    fi
}

validate_safe_path() {
    local label="$1"
    local value="$2"
    if [[ ! "$value" =~ ^[A-Za-z0-9_.@:~/-]+$ ]]; then
        error "Invalid $label: '$value' — must match ^[A-Za-z0-9_.@:~/-]+\$"
        exit 4
    fi
}

# LIMITATION: parse_ssh_opts_array splits on spaces, so compound options
# with embedded spaces (e.g. -o "ProxyCommand ssh -W %h:%p jump") are not
# supported. Each token must be a single, space-free option.
parse_ssh_opts_array() {
    local opts_string="$1"
    SSH_OPTS_ARRAY=()
    if [[ -n "$opts_string" ]]; then
        IFS=' ' read -ra SSH_OPTS_ARRAY <<< "$opts_string"
    fi
}

# --- Argument parsing ---

for arg in "$@"; do
    case "$arg" in
        --host=*)
            HOST="${arg#--host=}"
            ;;
        --root=*)
            ROOT="${arg#--root=}"
            ;;
        --handle=*)
            HANDLE="${arg#--handle=}"
            ;;
        --name=*)
            CHAT_NAME="${arg#--name=}"
            ;;
        --ssh-key=*)
            SSH_KEY="${arg#--ssh-key=}"
            ;;
        --ssh-opts=*)
            SSH_OPTS="${arg#--ssh-opts=}"
            ;;
        --resume)
            RESUME=true
            ;;
        --list)
            LIST=true
            ;;
        --help|-h)
            cat <<'USAGE'
nbs-claude-remote: Launch Claude Code on a remote machine via SSH

Usage: nbs-claude-remote --host=USER@HOST --root=PATH [OPTIONS]

Required:
  --host=USER@HOST      SSH target (e.g. user@remote-host)
  --root=PATH           Project root on the remote machine (must contain .nbs/)

Options:
  --handle=NAME         Agent handle (default: remote)
  --name=NAME           Chat name for session naming (default: live)
  --ssh-key=PATH        SSH key file
  --ssh-opts=OPTS       Additional SSH options, space-separated single tokens
                        (e.g. '-o ControlPath=none'). Compound options with
                        embedded spaces are NOT supported in a single invocation.
  --resume              Attach to existing remote nbs-ts session
  --list                List existing NBS nbs-ts sessions on remote
  --help                Show this help

The script SSHs to the remote, starts nbs-claude in an nbs-ts session
there, and attaches your terminal. All file access happens on the
remote machine where .nbs/ lives.

Exit codes:
  0 - Success
  1 - General error
  4 - Invalid arguments
USAGE
            exit 0
            ;;
        *)
            error "Unknown argument: $arg"
            error "Run: nbs-claude-remote --help"
            exit 4
            ;;
    esac
done

# --- Validate arguments ---

if [[ -z "$HOST" ]]; then
    error "Missing required argument: --host=USER@HOST"
    error "Run: nbs-claude-remote --help"
    exit 4
fi

validate_safe_path "HOST" "$HOST"

if [[ -n "$SSH_KEY" && ! -f "$SSH_KEY" ]]; then
    error "SSH key file not found: $SSH_KEY"
    exit 4
fi

parse_ssh_opts_array "$SSH_OPTS"

if [[ "$LIST" == "true" ]]; then
    # List remote NBS nbs-ts sessions and exit
    info "Listing NBS sessions on $HOST..."
    SSH_CMD=(ssh)
    [[ -n "$SSH_KEY" ]] && SSH_CMD+=(-i "$SSH_KEY")
    [[ ${#SSH_OPTS_ARRAY[@]} -gt 0 ]] && SSH_CMD+=("${SSH_OPTS_ARRAY[@]}")
    SSH_CMD+=("$HOST" "nbs-ts list 2>&1 || { echo 'No NBS sessions found (or nbs-ts unavailable)' >&2; exit 1; }")
    "${SSH_CMD[@]}"
    exit $?
fi

if [[ -z "$ROOT" ]]; then
    error "Missing required argument: --root=PATH"
    error "Run: nbs-claude-remote --help"
    exit 4
fi

validate_safe_path "ROOT" "$ROOT"
validate_safe_name "HANDLE" "$HANDLE"
validate_safe_name "CHAT_NAME" "$CHAT_NAME"

# --- Build SSH command ---

SSH_BASE=(ssh -t)
[[ -n "$SSH_KEY" ]] && SSH_BASE+=(-i "$SSH_KEY")
[[ ${#SSH_OPTS_ARRAY[@]} -gt 0 ]] && SSH_BASE+=("${SSH_OPTS_ARRAY[@]}")
SSH_BASE+=("$HOST")

SESSION_NAME="nbs-${HANDLE}-${CHAT_NAME}"

# Check tmux availability locally (tmux is used for session management)
if ! command -v tmux >/dev/null 2>&1; then
    error "tmux is not installed locally. Install tmux before using nbs-claude-remote."
    exit 1
fi

# --- Resume mode ---

if [[ "$RESUME" == "true" ]]; then
    info "Listing sessions on $HOST to find $SESSION_NAME..."
    # SESSION_NAME is expanded locally; remote single-quoting is defence-in-depth.
    "${SSH_BASE[@]}" "if ! tmux has-session -t '${SESSION_NAME}' 2>/dev/null; then echo 'Session not found' >&2; exit 1; fi; tmux attach-session -t '${SESSION_NAME}'"
    exit $?
fi

# --- Launch mode ---

printf '\n'
printf '%b%s%b\n' "${BOLD}" "NBS Claude Remote" "${NC}"
printf '  Host:     %s\n' "$HOST"
printf '  Root:     %s\n' "$ROOT"
printf '  Handle:   %s\n' "$HANDLE"
printf '  Chat:     %s\n' "$CHAT_NAME"
printf '\n'

# Check nbs-ts availability on remote
info "Checking for nbs-ts on remote..."
if ! "${SSH_BASE[@]}" "command -v nbs-ts >/dev/null 2>&1 || { echo 'nbs-ts not found on remote host. Install nbs-ts on $HOST before using nbs-claude-remote.' >&2; exit 1; }"; then
    error "nbs-ts is not available on $HOST"
    error "Install nbs-ts on the remote machine first."
    exit 1
fi

# Create remote nbs-ts session, start nbs-claude, then attach
info "Creating remote session and launching nbs-claude..."

LOCAL_HOST="$(whoami)@$(hostname -f 2>/dev/null || hostname)"
if [[ -z "$LOCAL_HOST" ]]; then
    error "LOCAL_HOST is empty — whoami or hostname failed"
    exit 1
fi
if [[ "$LOCAL_HOST" != *"@"* ]]; then
    error "LOCAL_HOST='$LOCAL_HOST' does not contain '@' — expected USER@HOST format"
    exit 1
fi
validate_safe_path "LOCAL_HOST" "$LOCAL_HOST"

# MAINTENANCE INVARIANT — every shell variable interpolated into REMOTE_CMD
# must be validated before this point. Current interpolated variables:
#   ROOT         — validated by validate_safe_path "ROOT" (line above)
#   SESSION_NAME — composed from HANDLE + CHAT_NAME, both validated by validate_safe_name
#   HANDLE       — validated by validate_safe_name "HANDLE"
#   LOCAL_HOST   — validated by validate_safe_path "LOCAL_HOST"
#
# SESSION_NAME is expanded locally; remote single-quoting is defence-in-depth.
#
# Create tmux session and launch nbs-claude via send-keys.
# Security: --dangerously-skip-permissions is intentional — the remote session
# runs in a trusted environment where the human operator has already authorised
# access via SSH. This is an accepted security trade-off for remote operation.
#
# SESSION_NAME is expanded locally; remote single-quoting is defence-in-depth.
REMOTE_CMD="cd \"${ROOT}\" && \
    tmux new-session -d -s '${SESSION_NAME}' && \
    tmux send-keys -t '${SESSION_NAME}' 'NBS_HANDLE=\"${HANDLE}\" NBS_TRANSPORT=ts NBS_REMOTE_HOST=\"${LOCAL_HOST}\" nbs-claude --dangerously-skip-permissions --root=\"${ROOT}\" --remote-host=\"${LOCAL_HOST}\"' Enter && \
    echo \"Session created: ${SESSION_NAME}\""

# Readiness poll: check tmux session exists AND nbs-claude process is running
POLL_CMD="for i in \$(seq 1 20); do \
    if tmux has-session -t '${SESSION_NAME}' 2>/dev/null && pgrep -f nbs-claude >/dev/null 2>&1; then \
        break; \
    fi; \
    sleep 0.2; \
done; \
if ! pgrep -f nbs-claude >/dev/null 2>&1; then \
    echo 'Warning: nbs-claude process not detected after poll timeout' >&2; \
fi"

ATTACH_CMD="tmux attach-session -t '${SESSION_NAME}'"

"${SSH_BASE[@]}" "${REMOTE_CMD} && ${POLL_CMD} && ${ATTACH_CMD}"
