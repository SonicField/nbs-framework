#!/bin/bash
# nbs-remote-diff: Pull git diff from a remote pty-session
#
# Fetches 'git diff' output from a remote machine via pty-session and
# prints it locally. Optionally posts the diff to a chat channel.
#
# Usage:
#   nbs-remote-diff <session> [options]
#
# Options:
#   --path=PATH        Restrict diff to a specific file or directory
#   --stat             Show diffstat only (--stat instead of full diff)
#   --staged           Show staged changes (git diff --cached)
#   --commit=REF       Diff against a specific commit (e.g. HEAD~1, 0ca33338)
#   --chat=FILE        Post the diff to this chat file
#   --handle=NAME      Chat handle (required with --chat)
#   --cwd=DIR          Working directory on the remote machine
#   --last=N           Lines of pty-session scrollback to capture (default: 200)
#
# Examples:
#   # Show unstaged changes
#   nbs-remote-diff my-server --cwd=/home/user/project
#
#   # Show diff for a specific file
#   nbs-remote-diff my-server --path=Jit/inliner.cpp --cwd=/home/user/project
#
#   # Show diff against base commit and post to chat
#   nbs-remote-diff my-server --commit=0ca33338 --cwd=/home/user/project \
#       --chat=.nbs/chat/live.chat --handle=claude
#
#   # Just the diffstat
#   nbs-remote-diff my-server --stat --cwd=/home/user/project
#
# Exit codes:
#   0 - Success
#   2 - Session not found
#   3 - Timeout
#   4 - Invalid arguments

set -euo pipefail

PTY_SESSION="${HOME}/.nbs/bin/pty-session"
NBS_CHAT="${HOME}/.nbs/bin/nbs-chat"

# Precondition: pty-session binary must exist
[[ -x "$PTY_SESSION" ]] || { echo "Error: pty-session not found at $PTY_SESSION" >&2; exit 1; }

# Suppress pty-session tool header (we ARE the higher-level tool)
export NBS_PTY_QUIET=1

SESSION=""
DIFF_PATH=""
STAT_ONLY=false
STAGED=false
COMMIT=""
CHAT_FILE=""
CHAT_HANDLE=""
CWD=""
LAST=200

usage() {
    [[ -f "$0" ]] || { echo "Error: cannot read $0 for usage" >&2; return 1; }
    grep '^#' "$0" | grep -v '!/bin/bash' | cut -c3-
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --path=*)   DIFF_PATH="${1#--path=}"; shift ;;
        --stat)     STAT_ONLY=true; shift ;;
        --staged)   STAGED=true; shift ;;
        --commit=*) COMMIT="${1#--commit=}"; shift ;;
        --chat=*)   CHAT_FILE="${1#--chat=}"; shift ;;
        --handle=*) CHAT_HANDLE="${1#--handle=}"; shift ;;
        --cwd=*)    CWD="${1#--cwd=}"; shift ;;
        --last=*)   LAST="${1#--last=}"; shift ;;
        --help|-h)  usage; exit 0 ;;
        -*)         echo "Unknown option: $1" >&2; exit 4 ;;
        help)       usage; exit 0 ;;
        *)
            if [[ -z "$SESSION" ]]; then
                SESSION="$1"
            else
                echo "Error: unexpected argument: $1" >&2
                exit 4
            fi
            shift
            ;;
    esac
done

if [[ -z "$SESSION" ]]; then
    echo "Error: requires <session>" >&2
    echo "Usage: nbs-remote-diff <session> [options]" >&2
    exit 4
fi

# Precondition: session name must contain only safe characters (BUG/SECURITY: marker injection via SESSION)
[[ "$SESSION" =~ ^[a-zA-Z0-9._-]+$ ]] || { echo "Error: session name contains invalid characters: '$SESSION'" >&2; exit 4; }

if [[ -n "$CHAT_FILE" ]] && [[ -z "$CHAT_HANDLE" ]]; then
    echo "Error: --handle is required when --chat is set" >&2
    exit 4
fi

# Precondition: nbs-chat must exist if --chat is used (BUG: validated late, fails silently after all work done)
if [[ -n "$CHAT_FILE" ]]; then
    [[ -x "$NBS_CHAT" ]] || { echo "Error: nbs-chat not found at $NBS_CHAT" >&2; exit 1; }
fi

# Validate numeric arguments — must be a positive integer, not zero (BUG: LAST=0 guarantees timeout)
[[ "$LAST" =~ ^[0-9]+$ ]] && (( LAST > 0 )) || { echo "Error: --last must be a positive integer, got '$LAST'" >&2; exit 4; }

# Validate COMMIT matches a git ref pattern (SECURITY: prevents flag injection via --commit=--output=...)
if [[ -n "$COMMIT" ]]; then
    COMMIT_RE='^[a-zA-Z0-9_.^~/@{}-]+$'
    [[ "$COMMIT" =~ $COMMIT_RE ]] || { echo "Error: --commit value contains invalid characters: '$COMMIT'" >&2; exit 4; }
fi

# Validate DIFF_PATH contains only path-safe characters (HARDENING: catches errors early)
if [[ -n "$DIFF_PATH" ]]; then
    PATH_RE='^[a-zA-Z0-9_./ -]+$'
    [[ "$DIFF_PATH" =~ $PATH_RE ]] || { echo "Error: --path contains invalid characters: '$DIFF_PATH'" >&2; exit 4; }
fi

# Validate CWD is an absolute path with safe characters (HARDENING: catches injection early)
if [[ -n "$CWD" ]]; then
    [[ "$CWD" == /* ]] || { echo "Error: --cwd must be an absolute path, got '$CWD'" >&2; exit 4; }
    CWD_RE='^[a-zA-Z0-9/._ -]+$'
    [[ "$CWD" =~ $CWD_RE ]] || { echo "Error: --cwd contains suspicious characters: '$CWD'" >&2; exit 4; }
fi

# Verify session exists
if ! "$PTY_SESSION" read "$SESSION" --last=1 >/dev/null 2>&1; then
    echo "Error: pty-session '$SESSION' not found" >&2
    exit 2
fi

# Build the git diff command
GIT_CMD="git diff"
if [[ "$STAGED" == true ]]; then
    GIT_CMD="$GIT_CMD --cached"
fi
if [[ "$STAT_ONLY" == true ]]; then
    GIT_CMD="$GIT_CMD --stat"
fi
if [[ -n "$COMMIT" ]]; then
    GIT_CMD="$GIT_CMD $(printf '%q' "$COMMIT")"
fi
if [[ -n "$DIFF_PATH" ]]; then
    GIT_CMD="$GIT_CMD -- $(printf '%q' "$DIFF_PATH")"
fi

# Build the full command (with optional cd)
FULL_CMD="$GIT_CMD"
if [[ -n "$CWD" ]]; then
    FULL_CMD="cd $(printf '%q' "$CWD") && ${GIT_CMD}"
fi

# Use markers with cryptographic randomness to prevent injection and collision
# (SECURITY: PID-only markers are predictable and injectable; $$ expands differently on remote shell)
MARKER_RANDOM=$(head -c 16 /dev/urandom | xxd -p)
MARKER_START="NBS_DIFF_START_${MARKER_RANDOM}"
MARKER_END="NBS_DIFF_END_${MARKER_RANDOM}"

# Single-quote markers in remote command to prevent shell expansion (BUG: $$ was expanded by remote shell)
if ! "$PTY_SESSION" send "$SESSION" "echo '${MARKER_START}'; ${FULL_CMD}; echo '${MARKER_END}'"; then
    echo "Error: Failed to send diff command to session '$SESSION'" >&2
    exit 1
fi

# Wait for completion
TIMEOUT=30
elapsed=0
POLL=2
consecutive_failures=0

while (( elapsed < TIMEOUT )); do
    sleep "$POLL"
    elapsed=$((elapsed + POLL))

    # Track consecutive read failures to detect dead sessions (HARDENING: was silently swallowed)
    if output=$("$PTY_SESSION" read "$SESSION" --last="$LAST" 2>/dev/null); then
        consecutive_failures=0
    else
        consecutive_failures=$((consecutive_failures + 1))
        if (( consecutive_failures >= 3 )); then
            echo "Error: pty-session read failed 3 consecutive times for '$SESSION'" >&2
            exit 2
        fi
        continue
    fi

    # Use grep -F for fixed-string matching (HARDENING: markers treated as literal, not regex)
    if echo "$output" | grep -qF "$MARKER_END"; then
        # Extract diff content using awk with literal string matching (HARDENING: sed treated markers as regex)
        diff_output=$(echo "$output" | awk -v start="$MARKER_START" -v end="$MARKER_END" '
            $0 == start { capture=1; next }
            $0 == end { capture=0; next }
            capture { print }
        ')

        # Postcondition: note when diff is empty (HARDENING: could indicate extraction failure vs no changes)
        if [[ -z "$diff_output" ]]; then
            echo "(no diff output)" >&2
        fi

        # Print to stdout
        echo "$diff_output"

        # Post to chat if requested
        if [[ -n "$CHAT_FILE" ]] && [[ -n "$CHAT_HANDLE" ]]; then
            # Truncate if very long (chat messages have practical limits)
            local_lines=$(echo "$diff_output" | wc -l)
            if (( local_lines > 50 )); then
                chat_msg="git diff (${local_lines} lines, showing first 50):
$(echo "$diff_output" | head -50)
... (${local_lines} total lines, truncated)"
            else
                chat_msg="git diff:
${diff_output}"
            fi
            # Fail hard if chat post fails — user explicitly requested it (BUG: was silently swallowed)
            if ! "$NBS_CHAT" send "$CHAT_FILE" "$CHAT_HANDLE" "$chat_msg"; then
                echo "Error: Failed to post diff to chat file '$CHAT_FILE'" >&2
                exit 1
            fi
        fi

        exit 0
    fi
done

echo "Error: Timed out waiting for git diff (${TIMEOUT}s)" >&2
exit 3
