#!/bin/bash
# nbs-claude: Launch Claude Code with the nbs-sidecar monitor.
#
# Thin wrapper that:
#   1. Parses arguments and environment variables
#   2. Handles collision guard (pidfile)
#   3. Generates session ID and metadata
#   4. Launches claude (foreground) + nbs-sidecar (background)
#   5. Cleans up on exit
#
# All monitoring behaviours (bus checking, chat notifications, dialogue
# handling, standup triggers, etc.) are implemented in the C binary
# nbs-sidecar. This script only handles orchestration.
#
# Works in two modes:
#   - Uses nbs-ts for session management
#   - 
#
# Usage:
#   nbs-claude [--root=PATH] [--model=MODEL] [--continue=SESSION_ID] [claude-args...]
#
# Environment:
#   NBS_POLL_DISABLE        Set to 1 to disable sidecar (just wraps claude)
#   NBS_HANDLE              Agent handle (default: claude)
#   NBS_ROOT                Project root containing .nbs/ (default: current directory)
#   NBS_MODEL               Model to use (e.g. opus, sonnet)
#   NBS_CONTINUE_SESSION    Session ID to continue
#   NBS_INITIAL_PROMPT      Custom initial prompt
#   NBS_FORCE_SPAWN         (deprecated — flock removed, no effect)
#   (All other NBS_* variables are passed through to nbs-sidecar)
#
# Exit codes:
#   0 - Clean exit
#   1 - General error
#   4 - Invalid arguments

set -euo pipefail

# --- Debug mode ---
# Set NBS_DEBUG=1 or pass --debug to log every lifecycle step to stderr.

NBS_DEBUG="${NBS_DEBUG:-0}"
for arg in "$@"; do
    [[ "$arg" == "--debug" ]] && NBS_DEBUG=1
done
export NBS_DEBUG
# Debug log goes to a file (not stderr) so it survives setsid >/dev/null 2>&1
NBS_DEBUG_LOG=""
if [[ "$NBS_DEBUG" == "1" ]]; then
    NBS_DEBUG_LOG="/tmp/nbs-claude-debug-$$.log"
fi
dbg() {
    if [[ "$NBS_DEBUG" == "1" && -n "$NBS_DEBUG_LOG" ]]; then
        echo "[nbs-claude:$$] $(date +%H:%M:%S) $*" >> "$NBS_DEBUG_LOG" 2>/dev/null
    fi
    return 0
}

# --- Configuration ---

POLL_DISABLE="${NBS_POLL_DISABLE:-0}"
SIDECAR_HANDLE="${NBS_HANDLE:-claude}"
NBS_ROOT="${NBS_ROOT:-.}"
NBS_MODEL="${NBS_MODEL:-claude-opus-4-7[1m]}"
NBS_CONTINUE_SESSION="${NBS_CONTINUE_SESSION:-}"
INITIAL_PROMPT="${NBS_INITIAL_PROMPT:-}"
# NBS_FORCE_SPAWN removed — flock mechanism deleted. Handle collision
# is no longer guarded; the restart script's cleanup is responsible
# for killing old agents before spawning new ones.
NBS_REMOTE_HOST="${NBS_REMOTE_HOST:-}"
NBS_REMOTE_SSH_OPTS="${NBS_REMOTE_SSH_OPTS:-}"
NBS_TRANSPORT="${NBS_TRANSPORT:-}"

# V1.4: Do not suppress cd stderr — let actual error (permission denied, not found) be visible
NBS_ROOT="$(cd "$NBS_ROOT" && pwd)" || {
    echo "Error: NBS_ROOT directory does not exist: ${NBS_ROOT:-<unset>}" >&2
    exit 1
}

# Validate handle
if [[ ! "$SIDECAR_HANDLE" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Error: NBS_HANDLE must match ^[a-zA-Z0-9_-]+\$, got '$SIDECAR_HANDLE'" >&2
    exit 4
fi

# V1.1: Validate NBS_MODEL with safe-character regex
# V1.1: Validate NBS_MODEL — alphanumeric/dots/hyphens/colons with optional [1m] suffix
if [[ -n "$NBS_MODEL" && ! "$NBS_MODEL" =~ ^[a-zA-Z0-9_.:-]+(\[1m\])?$ ]]; then
    echo "Error: NBS_MODEL contains invalid characters: '$NBS_MODEL'" >&2
    exit 4
fi

# Resolve tools
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_SIDECAR="${SCRIPT_DIR}/nbs-sidecar"

# Ensure SCRIPT_DIR is on PATH so child processes (sidecar, claude, nbs-chat)
# can find sibling binaries (nbs-bus, nbs-chat, nbs-workers) via exec*p().
# nbs-ts sessions may not source .bashrc, so PATH from install.sh is often missing.
case ":${PATH}:" in
    *":${SCRIPT_DIR}:"*) ;;  # already present
    *) export PATH="${SCRIPT_DIR}:${PATH}" ;;
esac

NBS_TS="${SCRIPT_DIR}/nbs-ts"
if [[ ! -x "$NBS_TS" ]]; then
    NBS_TS="${HOME}/.nbs/bin/nbs-ts"
fi
if [[ ! -x "$NBS_TS" ]]; then
    echo "Error: nbs-ts not found" >&2
    exit 1
fi

# Resolve honest-build for session metadata
HONEST_BUILD="${SCRIPT_DIR}/honest-build"
if [[ ! -x "$HONEST_BUILD" ]]; then
    HONEST_BUILD="${HOME}/.nbs/bin/honest-build"
fi
if [[ ! -x "$HONEST_BUILD" ]]; then
    echo "Error: honest-build not found (required for session metadata)" >&2
    exit 1
fi
SESSION_RULEBOOK="${SCRIPT_DIR}/../honest/session.honest-rulebook"
if [[ ! -f "$SESSION_RULEBOOK" ]]; then
    SESSION_RULEBOOK="${HOME}/.nbs/honest/session.honest-rulebook"
fi
if [[ ! -f "$SESSION_RULEBOOK" ]]; then
    echo "Error: session.honest-rulebook not found" >&2
    exit 1
fi
if [[ ! -x "$NBS_SIDECAR" ]]; then
    echo "Error: nbs-sidecar not found at $NBS_SIDECAR" >&2
    exit 1
fi

# Log file
NBS_LOG_FILE="${NBS_ROOT}/.nbs/nbs-claude-$$.log"

# --- Cleanup ---

SIDECAR_PID=""
SESSION_NAME=""
MODE=""

cleanup() {
    local EXIT_CODE=$?
    dbg "cleanup: exit_code=$EXIT_CODE mode=$MODE session=$SESSION_NAME sidecar_pid=$SIDECAR_PID"

    # V1.6: Fix TOCTOU — read unconditionally instead of check-then-read
    local pidfile="${NBS_ROOT}/.nbs/pids/${SIDECAR_HANDLE}.pid"
    local existing
    existing=$(cat "$pidfile" 2>/dev/null) || true
    if [[ "$existing" == "$$" ]]; then
        rm -f "$pidfile"
    fi

    # Remove session metadata
    local session_meta="${NBS_ROOT}/.nbs/sessions/${SIDECAR_HANDLE}.honest"
    rm -f "$session_meta" 2>/dev/null || true

    # Kill sidecar if running
    if [[ -n "$SIDECAR_PID" ]] && kill -0 "$SIDECAR_PID" 2>/dev/null; then
        kill "$SIDECAR_PID" 2>/dev/null || true
        wait "$SIDECAR_PID" 2>/dev/null || true
    fi

    # Kill nbs-ts session if we created one
    if [[ "$MODE" == "ts" && -n "$SESSION_NAME" ]]; then
        dbg "cleanup: killing nbs-ts session $SESSION_NAME"
        "$NBS_TS" kill "$SESSION_NAME" 2>/dev/null || true
    fi

    dbg "cleanup: done, exiting with $EXIT_CODE"
    exit "$EXIT_CODE"
}
trap cleanup INT TERM EXIT

# --- Main ---

# Parse nbs-specific args, extract values, build CLAUDE_ARGS via helper.
# nbs-claude-build-args handles: --dangerously-skip-permissions (always added),
# --model (from NBS_MODEL or --model=), --resume/--session-id (from
# NBS_CONTINUE_SESSION or --continue=), passthrough of unknown args.
# nbs-specific args (--root=, --force, --remote-host=, --remote-ssh-opts=)
# are consumed here and not passed to the helper.

# First pass: extract nbs-specific args that nbs-claude needs but claude doesn't.
BUILDER_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --root=*)
            NBS_ROOT="${arg#--root=}"
            ;;
        --remote-host=*)
            NBS_REMOTE_HOST="${arg#--remote-host=}"
            ;;
        --remote-ssh-opts=*)
            NBS_REMOTE_SSH_OPTS="${arg#--remote-ssh-opts=}"
            ;;
        --force)
            # Accepted for backwards compatibility but does nothing.
            # Flock mechanism removed.
            ;;
        *)
            BUILDER_ARGS+=("$arg")
            ;;
    esac
done

# Build CLAUDE_ARGS via the testable helper
BUILDER_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/nbs-claude-build-args"
if [[ ! -x "$BUILDER_SCRIPT" ]]; then
    echo "Error: nbs-claude-build-args not found at $BUILDER_SCRIPT" >&2
    exit 1
fi

mapfile -t CLAUDE_ARGS < <(
    NBS_MODEL="$NBS_MODEL" \
    NBS_CONTINUE_SESSION="$NBS_CONTINUE_SESSION" \
    bash "$BUILDER_SCRIPT" "${BUILDER_ARGS[@]+"${BUILDER_ARGS[@]}"}"
)

# Re-read NBS_MODEL and NBS_CONTINUE_SESSION in case --model= or --continue=
# was in the caller args (the builder consumed them but we need the values too)
for arg in "${BUILDER_ARGS[@]+"${BUILDER_ARGS[@]}"}"; do
    case "$arg" in
        --model=*) NBS_MODEL="${arg#--model=}" ;;
        --continue=*) NBS_CONTINUE_SESSION="${arg#--continue=}" ;;
    esac
done

# Re-resolve NBS_ROOT to absolute if overridden by --root=
NBS_ROOT="$(cd "$NBS_ROOT" && pwd)" || {
    echo "Error: NBS_ROOT directory does not exist: ${NBS_ROOT}" >&2
    exit 1
}
if [[ ! -d "$NBS_ROOT" ]]; then
    echo "Error: NBS_ROOT is not a directory: $NBS_ROOT" >&2
    exit 1
fi

# V1.7: HARDENING — reject NBS_ROOT with embedded newlines/carriage returns.
# These can cause surprising behaviour in mkdir -p, file paths, and JSON output.
if [[ "$NBS_ROOT" == *$'\n'* || "$NBS_ROOT" == *$'\r'* ]]; then
    echo "Error: NBS_ROOT path contains newline or carriage return characters" >&2
    exit 4
fi

# V1.1: Re-validate NBS_MODEL if overridden by --model=
# V1.1: Validate NBS_MODEL — alphanumeric/dots/hyphens/colons with optional [1m] suffix
if [[ -n "$NBS_MODEL" && ! "$NBS_MODEL" =~ ^[a-zA-Z0-9_.:-]+(\[1m\])?$ ]]; then
    echo "Error: NBS_MODEL contains invalid characters: '$NBS_MODEL'" >&2
    exit 4
fi

NBS_LOG_FILE="${NBS_ROOT}/.nbs/nbs-claude-$$.log"

# --- PID file ---
# Write PID file — used by the restart script to find and kill us.
# No flock — the old flock mechanism caused fd 9 to be inherited by
# child processes (sidecar, tail), which held the lock indefinitely
# and blocked subsequent spawns of the same handle.
mkdir -p "${NBS_ROOT}/.nbs/pids"
PIDFILE="${NBS_ROOT}/.nbs/pids/${SIDECAR_HANDLE}.pid"
echo "$$" > "$PIDFILE"

# --- Session ID ---
# The builder already added --resume or --session-id to CLAUDE_ARGS.
# We still need SESSION_UUID for metadata.
SESSION_UUID=""
if [[ -n "$NBS_CONTINUE_SESSION" ]]; then
    SESSION_UUID="$NBS_CONTINUE_SESSION"
else
    SESSION_UUID=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || python3 -c 'import uuid; print(uuid.uuid4())' 2>/dev/null || echo "")
    if [[ -z "$SESSION_UUID" ]]; then
        echo "Error: Failed to generate a UUID. Install uuidgen or ensure /proc/sys/kernel/random/uuid is available." >&2
        exit 1
    fi
    # Add --session-id since builder didn't have it (generated after builder ran)
    CLAUDE_ARGS+=("--session-id" "$SESSION_UUID")
fi

# V1.7: SECURITY — validate SESSION_UUID characters to prevent JSON injection
# (SESSION_UUID from --continue= is user-supplied; generated UUIDs should also
# pass but we verify unconditionally as a postcondition)
if [[ ! "$SESSION_UUID" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Error: Session UUID contains invalid characters: '$SESSION_UUID'" >&2
    exit 4
fi

# --- Session metadata ---
mkdir -p "${NBS_ROOT}/.nbs/sessions"
SESSION_META="${NBS_ROOT}/.nbs/sessions/${SIDECAR_HANDLE}.honest"
TMUX_SESSION_NAME="${TMUX_SESSION_NAME:-nbs-${SIDECAR_HANDLE}-live}"

# V1.3: SECURITY — validate TMUX_SESSION_NAME from environment
if [[ ! "$TMUX_SESSION_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Error: TMUX_SESSION_NAME must match ^[a-zA-Z0-9_-]+\$, got '$TMUX_SESSION_NAME'" >&2
    exit 4
fi

NBS_TS_HANDLE=""  # populated in ts mode
# SessionMeta: session_id, handle, model, nbs_ts_handle, transport (Auto|Ts),
#   started, project_root, pid, initial_prompt_set
"$HONEST_BUILD" --type SessionMeta --rulebook "$SESSION_RULEBOOK" \
  session_id="$SESSION_UUID" \
  handle="$SIDECAR_HANDLE" \
  model="$NBS_MODEL" \
  nbs_ts_handle="" \
  transport="$(if [[ "${NBS_TRANSPORT:-auto}" == "ts" ]]; then echo "Ts"; else echo "Auto"; fi)" \
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  project_root="$NBS_ROOT" \
  pid=$$ \
  initial_prompt_set="$(if [[ -n "$INITIAL_PROMPT" ]]; then echo "True"; else echo "False"; fi)" \
  > "$SESSION_META" || {
    echo "Error: honest-build failed to create session metadata" >&2
    exit 1
  }

dbg "start: handle=$SIDECAR_HANDLE root=$NBS_ROOT model=$NBS_MODEL transport=$NBS_TRANSPORT"
dbg "start: poll_disable=$POLL_DISABLE initial_prompt_len=${#INITIAL_PROMPT} tty=$(tty 2>/dev/null || echo none)"
echo "Starting Claude Code with nbs-sidecar..."
echo "  Handle: ${SIDECAR_HANDLE}"
echo "  Session ID: ${SESSION_UUID}"
echo "  Root: ${NBS_ROOT}"
if [[ -n "$NBS_MODEL" ]]; then
    echo "  Model: ${NBS_MODEL}"
fi
if [[ -n "$NBS_CONTINUE_SESSION" ]]; then
    echo "  Continuing session: ${NBS_CONTINUE_SESSION}"
fi
if [[ "$POLL_DISABLE" == "1" ]]; then
    echo "  Sidecar: DISABLED"
fi

# --- Build sidecar args ---
SIDECAR_ARGS=(
    "$NBS_SIDECAR"
    "--handle=$SIDECAR_HANDLE"
    "--root=$NBS_ROOT"
    "--log=$NBS_LOG_FILE"
)

if [[ -n "$INITIAL_PROMPT" ]]; then
    SIDECAR_ARGS+=("--initial-prompt=$INITIAL_PROMPT")
fi

if [[ "$NBS_TRANSPORT" == "ts" ]]; then
    # --- nbs-ts mode ---
    MODE="ts"

    if [[ ! -x "$NBS_TS" ]]; then
        echo "Error: nbs-ts not found (NBS_TRANSPORT=ts)" >&2
        exit 1
    fi

    # Build command string for nbs-ts
    CLAUDE_CMD=""
    for arg in "${CLAUDE_ARGS[@]}"; do
        if [[ -z "$CLAUDE_CMD" ]]; then
            CLAUDE_CMD="$(printf '%q' "$arg")"
        else
            CLAUDE_CMD="$CLAUDE_CMD $(printf '%q' "$arg")"
        fi
    done

    # Create nbs-ts session running claude.
    # Prepend cd to NBS_ROOT — the helper spawns bash in HOME,
    # so claude would otherwise open in the wrong directory.
    CLAUDE_CMD="cd $(printf '%q' "$NBS_ROOT") && $CLAUDE_CMD"

    # Derive session name tag from chat file in project root.
    # Convention: nbs-<handle>-<tag> where tag comes from the first .chat file.
    # e.g. poem.chat → nbs-supervisor-poem, nn.Module.chat → nbs-supervisor-nn-Module
    # Skip archive files — they sort before the active file and produce
    # wrong tags like "phoenix-20260401-014643-archive" instead of "phoenix".
    NBS_TS_TAG=""
    for chatf in "${NBS_ROOT}/.nbs/chat/"*.chat; do
        if [[ -f "$chatf" ]]; then
            local_name=$(basename "$chatf")
            [[ "$local_name" == *-archive* ]] && continue
            NBS_TS_TAG=$(basename "$chatf" .chat | tr '.' '-')
            break
        fi
    done
    NBS_TS_NAME_FLAG=""
    if [[ -n "$NBS_TS_TAG" ]]; then
        NBS_TS_NAME_FLAG="--name=nbs-${SIDECAR_HANDLE}-${NBS_TS_TAG}"
    fi

    dbg "creating nbs-ts session: $NBS_TS create $NBS_TS_NAME_FLAG \"$CLAUDE_CMD\""
    SESSION_NAME=$("$NBS_TS" create $NBS_TS_NAME_FLAG "$CLAUDE_CMD") || {
        echo "Error: Failed to create nbs-ts session" >&2
        dbg "nbs-ts create FAILED"
        exit 1
    }
    NBS_TS_HANDLE="$SESSION_NAME"
    dbg "session created: $SESSION_NAME"

    echo "  Mode: nbs-ts ($SESSION_NAME)"
    echo ""

    # Update session metadata with nbs-ts handle
    "$HONEST_BUILD" --type SessionMeta --rulebook "$SESSION_RULEBOOK" \
      session_id="$SESSION_UUID" \
      handle="$SIDECAR_HANDLE" \
      model="$NBS_MODEL" \
      nbs_ts_handle="$NBS_TS_HANDLE" \
      transport="Ts" \
      started="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      project_root="$NBS_ROOT" \
      pid=$$ \
      initial_prompt_set="$(if [[ -n "$INITIAL_PROMPT" ]]; then echo "True"; else echo "False"; fi)" \
      > "$SESSION_META" || {
        echo "Error: honest-build failed to update session metadata" >&2
        exit 1
      }

    SIDECAR_ARGS+=("--transport=ts" "--session=$SESSION_NAME")

    # Start C sidecar with auto-restart (ts mode).
    # Write the loop to a temp script and run via setsid so it survives
    # parent exit and signal delivery. disown does not work in
    # non-interactive bash (which is how the restart script runs us).
    if [[ "$POLL_DISABLE" != "1" ]]; then
        SIDECAR_LOOP=$(mktemp /tmp/nbs-sidecar-loop.XXXXXX.sh)
        cat > "$SIDECAR_LOOP" << SIDECAR_EOF
#!/bin/bash
export NBS_DEBUG="${NBS_DEBUG}"
CURRENT_SESSION="$SESSION_NAME"
LOGFILE="${NBS_ROOT}/.nbs/sidecar-loop-${SIDECAR_HANDLE}.log"
log() { echo "\$(date -u '+%Y-%m-%dT%H:%M:%SZ') \$*" >> "\$LOGFILE"; }
log "sidecar-loop started for ${SIDECAR_HANDLE} session=\$CURRENT_SESSION pid=\$\$"
while true; do
    log "starting sidecar session=\$CURRENT_SESSION"
    $(printf '%q ' "${SIDECAR_ARGS[@]}" | sed "s/$SESSION_NAME/\\\$CURRENT_SESSION/g")
    rc=\$?
    log "sidecar exited rc=\$rc session=\$CURRENT_SESSION"
    if "$NBS_TS" status "\$CURRENT_SESSION" 2>/dev/null | grep -q "alive"; then
        log "session \$CURRENT_SESSION alive, restarting in 5s"
        sleep 5
        continue
    fi
    log "session \$CURRENT_SESSION dead, searching for replacement for ${SIDECAR_HANDLE}"
    NEW_SESSION=\$("$(dirname "$0")/nbs-sidecar-find-session" "nbs-${SIDECAR_HANDLE}-${NBS_TS_TAG}")
    if [[ -n "\$NEW_SESSION" ]]; then
        log "found replacement session \$NEW_SESSION for ${SIDECAR_HANDLE}"
        CURRENT_SESSION="\$NEW_SESSION"
        sleep 5
        continue
    fi
    log "no replacement session for ${SIDECAR_HANDLE} — exiting"
    break
done
rm -f "$SIDECAR_LOOP"
SIDECAR_EOF
        chmod +x "$SIDECAR_LOOP"
        dbg "starting sidecar loop: $SIDECAR_LOOP (NBS_DEBUG=$NBS_DEBUG)"
        NBS_DEBUG="$NBS_DEBUG" setsid bash "$SIDECAR_LOOP" >/dev/null 2>&1 &
        SIDECAR_PID=$!
        sleep 0.5
        if ! kill -0 "$SIDECAR_PID" 2>/dev/null; then
            echo "Error: nbs-sidecar exited immediately. Check $NBS_LOG_FILE" >&2
            dbg "sidecar died immediately"
            exit 1
        fi
        dbg "sidecar running: pid=$SIDECAR_PID"
    fi

    # Attach or wait, depending on whether we have a terminal.
    # When launched by nbs-spawn-worker (setsid ... >/dev/null),
    # stdout is /dev/null and attach exits immediately, which triggers
    # the cleanup trap and kills the session before the sidecar can
    # inject the initial prompt. Instead, poll until the session dies.
    if [[ -t 1 ]]; then
        dbg "interactive mode: attaching to $SESSION_NAME"
        "$NBS_TS" attach "$SESSION_NAME"
        dbg "attach returned"
    else
        dbg "background mode: polling session $SESSION_NAME (NBS_TS=$NBS_TS)"
        dbg "background mode: first status check..."
        if "$NBS_TS" status "$SESSION_NAME" 2>/dev/null | grep -q "alive"; then
            dbg "background mode: session alive on first check, entering loop"
        else
            dbg "background mode: session NOT alive on first check — skipping loop"
        fi
        while "$NBS_TS" status "$SESSION_NAME" 2>/dev/null | grep -q "alive"; do
            dbg "background mode: session alive, sleeping 5s"
            sleep 5
        done
        dbg "session $SESSION_NAME no longer alive, exiting wait loop"
    fi
fi

# When user exits, cleanup runs via trap
