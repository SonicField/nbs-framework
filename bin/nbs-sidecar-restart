#!/bin/bash
# nbs-sidecar-restart — Hot-restart or respawn sidecar processes.
#
# Usage:
#   nbs-sidecar-restart              # restart all running sidecars (pick up new binary)
#   nbs-sidecar-restart <handle>     # restart just one sidecar
#   nbs-sidecar-restart --respawn    # scan all teams, spawn missing sidecars
#   nbs-sidecar-restart --respawn --root=/path  # only this project's sidecars
#
# Default mode: reads each running sidecar's command line from /proc,
# strips --initial-prompt, kills the old process, launches a new one.
#
# Respawn mode: scans all nbs-ts sessions, finds which ones are
# missing a sidecar process, and spawns fresh sidecars for them. Also
# restarts any existing sidecars. Works across all teams (live, module, etc).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SIDECAR="${SCRIPT_DIR}/nbs-sidecar"

# Source the shared library (lock acquisition, loop generation, etc.)
# All sidecar-loop scripts MUST be generated via nbs_sc_spawn so they
# include the lock-file block that prevents duplicate loops.
# shellcheck source=nbs-sidecar-lib.sh
source "${SCRIPT_DIR}/nbs-sidecar-lib.sh"

# Ensure bin/ is in PATH so sidecars can find nbs-bus, etc.
case ":${PATH}:" in
    *":${SCRIPT_DIR}:"*) ;;
    *) export PATH="${SCRIPT_DIR}:${PATH}" ;;
esac

MODE="restart"
TARGET_HANDLE=""
NAME_PATTERN=""
ROOT_FILTER=""

for arg in "$@"; do
    case "$arg" in
        --respawn) MODE="respawn" ;;
        --name=*) NAME_PATTERN="${arg#--name=}" ;;
        --root=*) ROOT_FILTER="${arg#--root=}" ;;
        --help|-h)
            echo "Usage: $(basename "$0") [--respawn] [--name=PATTERN] [--root=PATH] [handle]"
            echo ""
            echo "Hot-restart or respawn nbs-sidecar processes."
            echo "Agents (Claude sessions) are not affected."
            echo ""
            echo "  (no args)     Restart all running sidecars (pick up new binary)"
            echo "  <handle>      Restart only the sidecar for this handle"
            echo "  --respawn     Scan all teams, spawn missing sidecars, restart existing ones"
            echo "  --name=PAT    Filter nbs-ts sessions by name substring (reduces scan)"
            echo "  --root=PATH   Only affect sidecars for this project root"
            exit 0
            ;;
        *) TARGET_HANDLE="$arg" ;;
    esac
done

[[ -x "$SIDECAR" ]] || { echo "Error: nbs-sidecar not found at $SIDECAR" >&2; exit 1; }

# Infrastructure handles — skip these (ephemeral workers, not team agents)
is_infrastructure() {
    case "$1" in
        pythia*|shepard*|fixup*|chatdigest*|librarian*) return 0 ;;
        *) return 1 ;;
    esac
}

# --- Kill sidecar-loops for a project root ---
# Must be called BEFORE killing sidecars, otherwise the loop respawns them.

kill_sidecar_loops() {
    local filter_root="${1:-}"
    local filter_handle="${2:-}"
    local killed=0

    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ -r "/proc/$pid/cmdline" ]] || continue

        mapfile -d '' ARGS < "/proc/$pid/cmdline"
        local loop_script=""
        for arg in "${ARGS[@]}"; do
            case "$arg" in
                /tmp/nbs-sidecar-loop.*.sh) loop_script="$arg" ;;
            esac
        done
        [[ -n "$loop_script" ]] || continue
        [[ -f "$loop_script" ]] || continue

        # Filter by root if given
        if [[ -n "$filter_root" ]]; then
            grep -q "$filter_root" "$loop_script" 2>/dev/null || continue
        fi

        # Filter by handle if given
        if [[ -n "$filter_handle" ]]; then
            grep -q -- "--handle=${filter_handle}" "$loop_script" 2>/dev/null || continue
        fi

        echo "  Killing sidecar-loop PID $pid"
        kill "$pid" 2>/dev/null || true
        rm -f "$loop_script" 2>/dev/null || true
        killed=$((killed + 1))
    done < <(pgrep -f 'nbs-sidecar-loop' 2>/dev/null || true)

    if [[ $killed -gt 0 ]]; then
        echo "  Killed $killed sidecar-loop(s)"
        sleep 1  # Let loops die before proceeding
    fi
    return 0
}

# --- Restart existing sidecars (default mode) ---
# Now with deduplication: if multiple sidecars exist for the same handle,
# kill ALL of them and spawn exactly one.

restart_running() {
    local PIDS
    PIDS=$(pgrep -f '[n]bs-sidecar.*--handle=' 2>/dev/null) || {
        local pgrep_rc=$?
        if [[ $pgrep_rc -gt 1 ]]; then
            echo "ERROR: pgrep failed with exit code $pgrep_rc" >&2
            exit 1
        fi
    }

    if [[ -z "${PIDS:-}" ]]; then
        echo "No running sidecars found."
        return
    fi

    # Phase 1: Collect all sidecars grouped by handle for dedup.
    # We use temp files because associative arrays lose data in subshells.
    local DEDUP_DIR
    DEDUP_DIR=$(mktemp -d /tmp/nbs-sidecar-dedup.XXXXXX)
    trap "rm -rf '$DEDUP_DIR'" RETURN

    for pid in $PIDS; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ -r "/proc/$pid/cmdline" ]] || continue

        mapfile -d '' ARGS < "/proc/$pid/cmdline"

        # Extract handle and root. Strip any compound suffix from the
        # handle (e.g. supervisor-vib → supervisor). Agent handles are
        # single words; anything after the first hyphen is a tag artefact.
        local HANDLE="" SC_ROOT=""
        for arg in "${ARGS[@]}"; do
            case "$arg" in
                --handle=*) HANDLE="${arg#--handle=}"; HANDLE="${HANDLE%%-*}" ;;
                --root=*)   SC_ROOT="${arg#--root=}" ;;
            esac
        done
        [[ -n "$HANDLE" ]] || continue
        [[ -z "$TARGET_HANDLE" || "$HANDLE" == "$TARGET_HANDLE" ]] || continue
        is_infrastructure "$HANDLE" && continue

        # Filter by project root if --root was given
        if [[ -n "$ROOT_FILTER" && "$SC_ROOT" != "$ROOT_FILTER" ]]; then
            continue
        fi

        # Dedup key is (handle, project-root) — not handle alone.
        # Without the root, sidecars for the same role in different
        # projects (e.g. gatekeeper@cinderx vs gatekeeper@phoenix)
        # collide and only one survives.
        local ROOT_BASENAME=""
        [[ -n "$SC_ROOT" ]] && ROOT_BASENAME=$(basename "$SC_ROOT")
        local DEDUP_KEY="${HANDLE}@${ROOT_BASENAME}"

        # Record this PID under its dedup key
        echo "$pid" >> "${DEDUP_DIR}/${DEDUP_KEY}.pids"

        # Save args from the first occurrence only (for respawn)
        if [[ ! -f "${DEDUP_DIR}/${DEDUP_KEY}.args" ]]; then
            # Reconstruct args, correcting any compound handle
            # (e.g. --handle=supervisor-vib → --handle=supervisor)
            local NEW_ARGS=()
            for arg in "${ARGS[@]}"; do
                case "$arg" in
                    --initial-prompt=*) ;;
                    */nbs-sidecar|nbs-sidecar|bin/nbs-sidecar) NEW_ARGS+=("$SIDECAR") ;;
                    --handle=*-*)
                        # Strip everything from first hyphen in the handle value
                        local raw_handle="${arg#--handle=}"
                        NEW_ARGS+=("--handle=${raw_handle%%-*}")
                        ;;
                    *) NEW_ARGS+=("$arg") ;;
                esac
            done
            [[ ${#NEW_ARGS[@]} -gt 0 ]] || continue
            [[ "${NEW_ARGS[0]}" == "$SIDECAR" ]] || continue

            printf '%s\0' "${NEW_ARGS[@]}" > "${DEDUP_DIR}/${DEDUP_KEY}.args"
        fi
    done

    # Phase 2: Kill sidecar-loops before killing sidecars
    kill_sidecar_loops "$ROOT_FILTER" "$TARGET_HANDLE"

    # Phase 3: For each (handle, root), kill ALL pids, spawn exactly one.
    for pid_file in "${DEDUP_DIR}"/*.pids; do
        [[ -f "$pid_file" ]] || continue
        local DEDUP_KEY
        DEDUP_KEY=$(basename "$pid_file" .pids)
        local HANDLE="${DEDUP_KEY%%@*}"
        local args_file="${DEDUP_DIR}/${DEDUP_KEY}.args"
        [[ -f "$args_file" ]] || continue

        mapfile -t HANDLE_PIDS < "$pid_file"
        local pid_count=${#HANDLE_PIDS[@]}

        if [[ $pid_count -gt 1 ]]; then
            echo "DEDUP: ${pid_count} sidecars for ${DEDUP_KEY} — killing all, spawning one"
        fi

        # Kill all PIDs for this (handle, root)
        for pid in "${HANDLE_PIDS[@]}"; do
            echo -n "  Killing $DEDUP_KEY sidecar PID $pid... "
            kill "$pid" 2>/dev/null || true
            echo "sent SIGTERM"
        done

        # Wait for them to die
        for pid in "${HANDLE_PIDS[@]}"; do
            for _ in 1 2 3 4 5 6; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.5
            done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null && sleep 0.5
        done

        # Spawn exactly one — via library (which adds the lock block)
        mapfile -d '' NEW_ARGS < "$args_file"
        local sess_handle="" sc_root="" sc_log="" sc_prompt=""
        for narg in "${NEW_ARGS[@]}"; do
            case "$narg" in
                --session=*)        sess_handle="${narg#--session=}" ;;
                --root=*)           sc_root="${narg#--root=}" ;;
                --log=*)            sc_log="${narg#--log=}" ;;
                --initial-prompt=*) sc_prompt="${narg#--initial-prompt=}" ;;
            esac
        done
        # Clean stale PID marker — without this, the new sidecar
        # detects the old marker as a "duplicate" and exits (rc=1).
        if [[ -n "$sc_root" ]]; then
            rm -f "${sc_root}/.nbs/pids/sidecar-${HANDLE}.pid"
        fi

        local NBS_TS_BIN
        NBS_TS_BIN=$(command -v nbs-ts 2>/dev/null || echo "${SCRIPT_DIR}/nbs-ts")
        local sess_name=""
        sess_name=$("$NBS_TS_BIN" list 2>/dev/null | awk -v h="$sess_handle" '$1==h {print $3}' | head -1)

        echo -n "  Spawning $HANDLE (with restart loop)... "
        local NEW_PID
        local SPAWN_ARGS=(
            --sidecar-bin="$SIDECAR"
            --handle="$HANDLE"
            --root="$sc_root"
            --session="$sess_handle"
            --session-name="$sess_name"
        )
        [[ -n "$sc_log" ]]    && SPAWN_ARGS+=(--log="$sc_log")
        [[ -n "$sc_prompt" ]] && SPAWN_ARGS+=(--initial-prompt="$sc_prompt")
        NEW_PID=$(nbs_sc_spawn "${SPAWN_ARGS[@]}") || true
        if [[ "$NEW_PID" == "0" ]]; then
            echo "skipped (lock held by another loop)"
        elif [[ -n "$NEW_PID" ]]; then
            echo "PID $NEW_PID"
            RESTARTED=$((RESTARTED + 1))
        else
            echo "FAILED"
        fi
        sleep 1
    done

    rm -rf "$DEDUP_DIR"
    trap - RETURN
}

# --- Respawn missing sidecars ---

NBS_TS="${SCRIPT_DIR}/nbs-ts"

respawn_missing() {
    # Try nbs-ts sessions first, nbs-ts only
    if [[ -x "$NBS_TS" ]]; then
        local TS_SESSIONS
        local LIST_CMD=("$NBS_TS" list)
        if [[ -n "$NAME_PATTERN" ]]; then
            LIST_CMD+=("--name=$NAME_PATTERN")
        fi
        TS_SESSIONS=$("${LIST_CMD[@]}" 2>/dev/null | grep "alive" || true)
        if [[ -n "$TS_SESSIONS" ]]; then
            while IFS=$'\t' read -r ts_handle ts_status ts_name ts_cmd; do
                [[ -n "$ts_handle" ]] || continue

                # Dedup check: count sidecars for this session
                local sc_count
                sc_count=$(pgrep -xfc "nbs-sidecar" 2>/dev/null | head -1) || sc_count=0
                # pgrep -x matches exact process name, avoiding self-match.
                # But we need to filter by session. Count sidecar processes
                # whose /proc/PID/cmdline contains this session handle.
                sc_count=0
                while IFS= read -r sc_pid; do
                    [[ -r "/proc/$sc_pid/cmdline" ]] || continue
                    # Must match BOTH session AND root to avoid cross-project false positives
                    tr '\0' '\n' < "/proc/$sc_pid/cmdline" 2>/dev/null | grep -qF -- "--session=${ts_handle}" || continue
                    tr '\0' '\n' < "/proc/$sc_pid/cmdline" 2>/dev/null | grep -qF -- "--root=${root}" || continue
                    sc_count=$((sc_count + 1))
                done < <(pgrep -x nbs-sidecar 2>/dev/null || true)
                if [[ $sc_count -gt 1 ]]; then
                    # Kill all duplicates — we'll respawn one below
                    echo "DEDUP: ${sc_count} sidecars for session ${ts_handle} — killing all"
                    while IFS= read -r dup_pid; do
                        [[ -r "/proc/$dup_pid/cmdline" ]] || continue
                        tr '\0' '\n' < "/proc/$dup_pid/cmdline" 2>/dev/null | grep -qF -- "--session=${ts_handle}" || continue
                        tr '\0' '\n' < "/proc/$dup_pid/cmdline" 2>/dev/null | grep -qF -- "--root=${root}" || continue
                        kill "$dup_pid" 2>/dev/null
                    done < <(pgrep -x nbs-sidecar 2>/dev/null || true)
                    sleep 1
                elif [[ $sc_count -eq 1 ]]; then
                    # One sidecar exists — check if it has a live sidecar-loop parent.
                    # If the loop is dead (PPID=1 / orphaned), the sidecar won't
                    # restart on crash. Kill it and respawn with a fresh loop.
                    local sc_pid
                    sc_pid=""
                    while IFS= read -r cand_pid; do
                        [[ -r "/proc/$cand_pid/cmdline" ]] || continue
                        tr '\0' '\n' < "/proc/$cand_pid/cmdline" 2>/dev/null | grep -qF -- "--session=${ts_handle}" || continue
                        tr '\0' '\n' < "/proc/$cand_pid/cmdline" 2>/dev/null | grep -qF -- "--root=${root}" || continue
                        sc_pid="$cand_pid"; break
                    done < <(pgrep -x nbs-sidecar 2>/dev/null || true)
                    if [[ -n "$sc_pid" ]]; then
                        local sc_ppid
                        sc_ppid=$(ps -p "$sc_pid" -o ppid= 2>/dev/null | tr -d ' ') || sc_ppid=""
                        local sc_parent
                        sc_parent=$(ps -p "$sc_ppid" -o comm= 2>/dev/null) || sc_parent=""
                        if [[ "$sc_parent" == "bash" ]] && tr '\0' '\n' < "/proc/$sc_ppid/cmdline" 2>/dev/null | grep -qF 'sidecar-loop'; then
                            # Healthy: has a sidecar-loop parent — skip
                            continue
                        fi
                        # Orphaned or no loop — kill and respawn
                        echo "ORPHAN: sidecar for session ${ts_handle} has no loop (ppid=$sc_ppid parent=$sc_parent) — killing"
                        kill "$sc_pid" 2>/dev/null || true
                        kill -9 "$sc_pid" 2>/dev/null || true
                        sleep 1
                    else
                        continue
                    fi
                fi
                # Extract project root from session command ("cd /path && ...")
                # or from session metadata
                local root=""
                root=$(echo "$ts_cmd" | grep -oP '(?<=^cd )\S+' || true)
                if [[ -z "$root" || ! -d "${root}/.nbs" ]]; then
                    # Fallback: try nbs-claude processes
                    for d in $(pgrep -a -f "nbs-claude" 2>/dev/null | grep -oP '(?<=--root=)\S+' || true); do
                        [[ -d "${d}/.nbs" ]] && root="$d" && break
                    done
                fi
                [[ -n "$root" && -d "${root}/.nbs" ]] || continue

                # Filter by project root if --root was given
                if [[ -n "$ROOT_FILTER" && "$root" != "$ROOT_FILTER" ]]; then
                    continue
                fi

                # Extract handle from session name: nbs-<handle>-<tag>
                # Handles are single words (no hyphens), so match up to first hyphen.
                local agent_handle=""
                if [[ "$ts_name" =~ ^nbs-([a-zA-Z0-9_]+)- ]]; then
                    agent_handle="${BASH_REMATCH[1]}"
                fi
                if [[ -z "$agent_handle" ]]; then
                    agent_handle=$(echo "$ts_cmd" | grep -oP '(?<=NBS_HANDLE=)\S+' || true)
                fi
                [[ -n "$agent_handle" ]] || continue
                is_infrastructure "$agent_handle" && continue
                # Filter by target handle if specified
                [[ -z "$TARGET_HANDLE" || "$agent_handle" == "$TARGET_HANDLE" ]] || continue

                # Check lock — skip if a loop already exists for this handle
                local lockfile="${root}/.nbs/locks/sidecar-${agent_handle}.lock"
                if [[ -f "$lockfile" ]]; then
                    local lock_pid
                    lock_pid=$(cat "$lockfile" 2>/dev/null)
                    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
                        continue
                    fi
                fi

                # Clean stale PID marker before spawning
                rm -f "${root}/.nbs/pids/sidecar-${agent_handle}.pid"

                echo -n "Spawning sidecar for $agent_handle (nbs-ts=$ts_handle)... "
                local NEW_PID
                NEW_PID=$(nbs_sc_spawn \
                    --sidecar-bin="$SIDECAR" \
                    --handle="$agent_handle" \
                    --root="$root" \
                    --session="$ts_handle" \
                    --session-name="$ts_name" \
                    --log="${root}/.nbs/sidecar-${agent_handle}.log") || true
                if [[ "$NEW_PID" == "0" ]]; then
                    echo "skipped (lock held by another loop)"
                elif [[ -n "$NEW_PID" ]]; then
                    echo "PID $NEW_PID (with restart loop)"
                    SPAWNED=$((SPAWNED + 1))
                else
                    echo "FAILED"
                fi
                sleep 1
            done <<< "$TS_SESSIONS"
            return
        fi
    fi

    echo "No nbs-ts agent sessions found."
}

# --- Main ---

RESTARTED=0
SPAWNED=0
FAILED=0

if [[ "$MODE" == "respawn" ]]; then
    # First restart any that are running (pick up new binary)
    restart_running
    # Then spawn any that are missing
    respawn_missing
else
    restart_running
    # If a specific handle was requested and nothing was restarted,
    # the sidecar is dead — try respawning from session metadata.
    if [[ -n "$TARGET_HANDLE" && $RESTARTED -eq 0 ]]; then
        echo "No running sidecar for $TARGET_HANDLE — trying respawn..."
        respawn_missing
    fi
fi

echo ""
echo "Restarted: $RESTARTED  Spawned: $SPAWNED"

if [[ -n "$TARGET_HANDLE" && $RESTARTED -eq 0 && $SPAWNED -eq 0 ]]; then
    echo "No sidecar found for handle: $TARGET_HANDLE"
    exit 1
fi
exit 0
