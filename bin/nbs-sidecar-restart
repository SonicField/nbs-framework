#!/bin/bash
# nbs-sidecar-restart — Hot-restart or respawn sidecar processes.
#
# Usage:
#   nbs-sidecar-restart              # restart all running sidecars (pick up new binary)
#   nbs-sidecar-restart <handle>     # restart just one sidecar
#   nbs-sidecar-restart --respawn    # scan all teams, spawn missing sidecars
#
# Default mode: reads each running sidecar's command line from /proc,
# strips --initial-prompt, kills the old process, launches a new one.
#
# Respawn mode: scans all nbs-ts sessions, finds which ones are
# missing a sidecar process, and spawns fresh sidecars for them. Also
# restarts any existing sidecars. Works across all teams (live, module, etc).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SIDECAR="${SCRIPT_DIR}/nbs-sidecar"

# Ensure bin/ is in PATH so sidecars can find nbs-bus, etc.
case ":${PATH}:" in
    *":${SCRIPT_DIR}:"*) ;;
    *) export PATH="${SCRIPT_DIR}:${PATH}" ;;
esac

MODE="restart"
TARGET_HANDLE=""
NAME_PATTERN=""

for arg in "$@"; do
    case "$arg" in
        --respawn) MODE="respawn" ;;
        --name=*) NAME_PATTERN="${arg#--name=}" ;;
        --help|-h)
            echo "Usage: $(basename "$0") [--respawn] [--name=PATTERN] [handle]"
            echo ""
            echo "Hot-restart or respawn nbs-sidecar processes."
            echo "Agents (Claude sessions) are not affected."
            echo ""
            echo "  (no args)     Restart all running sidecars (pick up new binary)"
            echo "  <handle>      Restart only the sidecar for this handle"
            echo "  --respawn     Scan all teams, spawn missing sidecars, restart existing ones"
            echo "  --name=PAT    Filter nbs-ts sessions by name substring (reduces scan)"
            exit 0
            ;;
        *) TARGET_HANDLE="$arg" ;;
    esac
done

[[ -x "$SIDECAR" ]] || { echo "Error: nbs-sidecar not found at $SIDECAR" >&2; exit 1; }

# Infrastructure handles — skip these (ephemeral workers, not team agents)
is_infrastructure() {
    case "$1" in
        pythia*|shepard*|fixup*|chatdigest*|librarian*) return 0 ;;
        *) return 1 ;;
    esac
}

# --- Restart existing sidecars (default mode) ---

restart_running() {
    local PIDS
    PIDS=$(pgrep -f '[n]bs-sidecar.*--handle=' 2>/dev/null) || {
        local pgrep_rc=$?
        if [[ $pgrep_rc -gt 1 ]]; then
            echo "ERROR: pgrep failed with exit code $pgrep_rc" >&2
            exit 1
        fi
    }

    if [[ -z "${PIDS:-}" ]]; then
        echo "No running sidecars found."
        return
    fi

    for pid in $PIDS; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ -r "/proc/$pid/cmdline" ]] || continue

        mapfile -d '' ARGS < "/proc/$pid/cmdline"

        # Extract handle
        local HANDLE=""
        for arg in "${ARGS[@]}"; do
            case "$arg" in --handle=*) HANDLE="${arg#--handle=}" ;; esac
        done
        [[ -n "$HANDLE" ]] || continue
        [[ -z "$TARGET_HANDLE" || "$HANDLE" == "$TARGET_HANDLE" ]] || continue
        is_infrastructure "$HANDLE" && continue

        # Reconstruct args
        local NEW_ARGS=()
        for arg in "${ARGS[@]}"; do
            case "$arg" in
                --initial-prompt=*) ;;
                */nbs-sidecar|nbs-sidecar|bin/nbs-sidecar) NEW_ARGS+=("$SIDECAR") ;;
                *) NEW_ARGS+=("$arg") ;;
            esac
        done
        [[ ${#NEW_ARGS[@]} -gt 0 ]] || continue
        [[ "${NEW_ARGS[0]}" == "$SIDECAR" ]] || continue

        # Kill old, spawn new
        echo -n "Restarting $HANDLE (PID $pid)... "
        kill "$pid" 2>/dev/null || true
        for _ in 1 2 3 4 5 6; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null && sleep 1

        "${NEW_ARGS[@]}" &
        disown $! 2>/dev/null || true
        echo "$pid → $!"
        RESTARTED=$((RESTARTED + 1))
        sleep 1
    done
}

# --- Respawn missing sidecars ---

NBS_TS="${SCRIPT_DIR}/nbs-ts"

respawn_missing() {
    # Try nbs-ts sessions first, nbs-ts only
    if [[ -x "$NBS_TS" ]]; then
        local TS_SESSIONS
        local LIST_CMD=("$NBS_TS" list)
        if [[ -n "$NAME_PATTERN" ]]; then
            LIST_CMD+=("--name=$NAME_PATTERN")
        fi
        TS_SESSIONS=$("${LIST_CMD[@]}" 2>/dev/null | grep "alive" || true)
        if [[ -n "$TS_SESSIONS" ]]; then
            while IFS=$'\t' read -r ts_handle ts_status ts_name ts_cmd; do
                [[ -n "$ts_handle" ]] || continue
                # Check if a sidecar is already watching this session
                if pgrep -f "nbs-sidecar.*--session=${ts_handle}" >/dev/null 2>&1; then
                    continue
                fi
                # Try to find project root from session metadata
                local meta_path="${HOME}/.nbs-ts/sessions/${ts_handle}/meta"
                [[ -f "$meta_path" ]] || continue
                # Look for NBS_ROOT in the command or use cwd
                local root=""
                for d in $(pgrep -a -f "nbs-claude" 2>/dev/null | grep -oP '(?<=--root=)\S+' || true); do
                    [[ -d "${d}/.nbs" ]] && root="$d" && break
                done
                [[ -n "$root" ]] || continue

                # Extract handle from the command
                local agent_handle=""
                agent_handle=$(echo "$ts_cmd" | grep -oP '(?<=NBS_HANDLE=)\S+' || true)
                [[ -n "$agent_handle" ]] || continue
                is_infrastructure "$agent_handle" && continue

                echo -n "Spawning sidecar for $agent_handle (nbs-ts=$ts_handle)... "
                "$SIDECAR" \
                    --handle="$agent_handle" \
                    --root="$root" \
                    --transport=ts \
                    --session="$ts_handle" \
                    --log="${root}/.nbs/sidecar-${agent_handle}.log" &
                disown $! 2>/dev/null || true
                echo "PID $!"
                SPAWNED=$((SPAWNED + 1))
                sleep 1
            done <<< "$TS_SESSIONS"
            return
        fi
    fi

    echo "No nbs-ts agent sessions found."
}

# --- Main ---

RESTARTED=0
SPAWNED=0
FAILED=0

if [[ "$MODE" == "respawn" ]]; then
    # First restart any that are running (pick up new binary)
    restart_running
    # Then spawn any that are missing
    respawn_missing
else
    restart_running
fi

echo ""
echo "Restarted: $RESTARTED  Spawned: $SPAWNED"

if [[ -n "$TARGET_HANDLE" && $RESTARTED -eq 0 && $SPAWNED -eq 0 ]]; then
    echo "No sidecar found for handle: $TARGET_HANDLE"
    exit 1
fi
exit 0
