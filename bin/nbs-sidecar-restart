#!/bin/bash
# nbs-sidecar-restart — Hot-restart or respawn sidecar processes.
#
# Usage:
#   nbs-sidecar-restart              # restart all running sidecars (pick up new binary)
#   nbs-sidecar-restart <handle>     # restart just one sidecar
#   nbs-sidecar-restart --respawn    # scan all teams, spawn missing sidecars
#   nbs-sidecar-restart --respawn --root=/path  # only this project's sidecars
#
# Default mode: reads each running sidecar's command line from /proc,
# strips --initial-prompt, kills the old process, launches a new one.
#
# Respawn mode: scans all nbs-ts sessions, finds which ones are
# missing a sidecar process, and spawns fresh sidecars for them. Also
# restarts any existing sidecars. Works across all teams (live, module, etc).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SIDECAR="${SCRIPT_DIR}/nbs-sidecar"

# Ensure bin/ is in PATH so sidecars can find nbs-bus, etc.
case ":${PATH}:" in
    *":${SCRIPT_DIR}:"*) ;;
    *) export PATH="${SCRIPT_DIR}:${PATH}" ;;
esac

MODE="restart"
TARGET_HANDLE=""
NAME_PATTERN=""
ROOT_FILTER=""

for arg in "$@"; do
    case "$arg" in
        --respawn) MODE="respawn" ;;
        --name=*) NAME_PATTERN="${arg#--name=}" ;;
        --root=*) ROOT_FILTER="${arg#--root=}" ;;
        --help|-h)
            echo "Usage: $(basename "$0") [--respawn] [--name=PATTERN] [--root=PATH] [handle]"
            echo ""
            echo "Hot-restart or respawn nbs-sidecar processes."
            echo "Agents (Claude sessions) are not affected."
            echo ""
            echo "  (no args)     Restart all running sidecars (pick up new binary)"
            echo "  <handle>      Restart only the sidecar for this handle"
            echo "  --respawn     Scan all teams, spawn missing sidecars, restart existing ones"
            echo "  --name=PAT    Filter nbs-ts sessions by name substring (reduces scan)"
            echo "  --root=PATH   Only affect sidecars for this project root"
            exit 0
            ;;
        *) TARGET_HANDLE="$arg" ;;
    esac
done

[[ -x "$SIDECAR" ]] || { echo "Error: nbs-sidecar not found at $SIDECAR" >&2; exit 1; }

# Infrastructure handles — skip these (ephemeral workers, not team agents)
is_infrastructure() {
    case "$1" in
        pythia*|shepard*|fixup*|chatdigest*|librarian*) return 0 ;;
        *) return 1 ;;
    esac
}

# --- Kill sidecar-loops for a project root ---
# Must be called BEFORE killing sidecars, otherwise the loop respawns them.

kill_sidecar_loops() {
    local filter_root="${1:-}"
    local filter_handle="${2:-}"
    local killed=0

    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ -r "/proc/$pid/cmdline" ]] || continue

        mapfile -d '' ARGS < "/proc/$pid/cmdline"
        local loop_script=""
        for arg in "${ARGS[@]}"; do
            case "$arg" in
                /tmp/nbs-sidecar-loop.*.sh) loop_script="$arg" ;;
            esac
        done
        [[ -n "$loop_script" ]] || continue
        [[ -f "$loop_script" ]] || continue

        # Filter by root if given
        if [[ -n "$filter_root" ]]; then
            grep -q "$filter_root" "$loop_script" 2>/dev/null || continue
        fi

        # Filter by handle if given
        if [[ -n "$filter_handle" ]]; then
            grep -q -- "--handle=${filter_handle}" "$loop_script" 2>/dev/null || continue
        fi

        echo "  Killing sidecar-loop PID $pid"
        kill "$pid" 2>/dev/null || true
        rm -f "$loop_script" 2>/dev/null || true
        killed=$((killed + 1))
    done < <(pgrep -f 'nbs-sidecar-loop' 2>/dev/null || true)

    if [[ $killed -gt 0 ]]; then
        echo "  Killed $killed sidecar-loop(s)"
        sleep 1  # Let loops die before proceeding
    fi
    return 0
}

# --- Restart existing sidecars (default mode) ---
# Now with deduplication: if multiple sidecars exist for the same handle,
# kill ALL of them and spawn exactly one.

restart_running() {
    local PIDS
    PIDS=$(pgrep -f '[n]bs-sidecar.*--handle=' 2>/dev/null) || {
        local pgrep_rc=$?
        if [[ $pgrep_rc -gt 1 ]]; then
            echo "ERROR: pgrep failed with exit code $pgrep_rc" >&2
            exit 1
        fi
    }

    if [[ -z "${PIDS:-}" ]]; then
        echo "No running sidecars found."
        return
    fi

    # Phase 1: Collect all sidecars grouped by handle for dedup.
    # We use temp files because associative arrays lose data in subshells.
    local DEDUP_DIR
    DEDUP_DIR=$(mktemp -d /tmp/nbs-sidecar-dedup.XXXXXX)
    trap "rm -rf '$DEDUP_DIR'" RETURN

    for pid in $PIDS; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ -r "/proc/$pid/cmdline" ]] || continue

        mapfile -d '' ARGS < "/proc/$pid/cmdline"

        # Extract handle and root
        local HANDLE="" SC_ROOT=""
        for arg in "${ARGS[@]}"; do
            case "$arg" in
                --handle=*) HANDLE="${arg#--handle=}" ;;
                --root=*)   SC_ROOT="${arg#--root=}" ;;
            esac
        done
        [[ -n "$HANDLE" ]] || continue
        [[ -z "$TARGET_HANDLE" || "$HANDLE" == "$TARGET_HANDLE" ]] || continue
        is_infrastructure "$HANDLE" && continue

        # Filter by project root if --root was given
        if [[ -n "$ROOT_FILTER" && "$SC_ROOT" != "$ROOT_FILTER" ]]; then
            continue
        fi

        # Record this PID under its handle
        echo "$pid" >> "${DEDUP_DIR}/${HANDLE}.pids"

        # Save args from the first occurrence only (for respawn)
        if [[ ! -f "${DEDUP_DIR}/${HANDLE}.args" ]]; then
            # Reconstruct args
            local NEW_ARGS=()
            for arg in "${ARGS[@]}"; do
                case "$arg" in
                    --initial-prompt=*) ;;
                    */nbs-sidecar|nbs-sidecar|bin/nbs-sidecar) NEW_ARGS+=("$SIDECAR") ;;
                    *) NEW_ARGS+=("$arg") ;;
                esac
            done
            [[ ${#NEW_ARGS[@]} -gt 0 ]] || continue
            [[ "${NEW_ARGS[0]}" == "$SIDECAR" ]] || continue

            printf '%s\0' "${NEW_ARGS[@]}" > "${DEDUP_DIR}/${HANDLE}.args"
        fi
    done

    # Phase 2: Kill sidecar-loops before killing sidecars
    kill_sidecar_loops "$ROOT_FILTER" "$TARGET_HANDLE"

    # Phase 3: For each handle, kill ALL pids, spawn exactly one.
    for pid_file in "${DEDUP_DIR}"/*.pids; do
        [[ -f "$pid_file" ]] || continue
        local HANDLE
        HANDLE=$(basename "$pid_file" .pids)
        local args_file="${DEDUP_DIR}/${HANDLE}.args"
        [[ -f "$args_file" ]] || continue

        mapfile -t HANDLE_PIDS < "$pid_file"
        local pid_count=${#HANDLE_PIDS[@]}

        if [[ $pid_count -gt 1 ]]; then
            echo "DEDUP: ${pid_count} sidecars for ${HANDLE} — killing all, spawning one"
        fi

        # Kill all PIDs for this handle
        for pid in "${HANDLE_PIDS[@]}"; do
            echo -n "  Killing $HANDLE sidecar PID $pid... "
            kill "$pid" 2>/dev/null || true
            echo "sent SIGTERM"
        done

        # Wait for them to die
        for pid in "${HANDLE_PIDS[@]}"; do
            for _ in 1 2 3 4 5 6; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.5
            done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null && sleep 0.5
        done

        # Spawn exactly one
        mapfile -d '' NEW_ARGS < "$args_file"
        echo -n "  Spawning $HANDLE... "
        "${NEW_ARGS[@]}" &
        disown $! 2>/dev/null || true
        echo "PID $!"
        RESTARTED=$((RESTARTED + 1))
        sleep 1
    done

    rm -rf "$DEDUP_DIR"
    trap - RETURN
}

# --- Respawn missing sidecars ---

NBS_TS="${SCRIPT_DIR}/nbs-ts"

respawn_missing() {
    # Try nbs-ts sessions first, nbs-ts only
    if [[ -x "$NBS_TS" ]]; then
        local TS_SESSIONS
        local LIST_CMD=("$NBS_TS" list)
        if [[ -n "$NAME_PATTERN" ]]; then
            LIST_CMD+=("--name=$NAME_PATTERN")
        fi
        TS_SESSIONS=$("${LIST_CMD[@]}" 2>/dev/null | grep "alive" || true)
        if [[ -n "$TS_SESSIONS" ]]; then
            while IFS=$'\t' read -r ts_handle ts_status ts_name ts_cmd; do
                [[ -n "$ts_handle" ]] || continue

                # Dedup check: count sidecars for this session
                local sc_count
                sc_count=$(pgrep -fc "nbs-sidecar.*--session=${ts_handle}" 2>/dev/null) || sc_count=0
                if [[ $sc_count -gt 1 ]]; then
                    # Kill all duplicates — we'll respawn one below
                    echo "DEDUP: ${sc_count} sidecars for session ${ts_handle} — killing all"
                    pkill -f "nbs-sidecar.*--session=${ts_handle}" 2>/dev/null || true
                    sleep 1
                elif [[ $sc_count -eq 1 ]]; then
                    # Already has exactly one sidecar — skip
                    continue
                fi
                # Try to find project root from session metadata
                local meta_path="${HOME}/.nbs-ts/sessions/${ts_handle}/meta"
                [[ -f "$meta_path" ]] || continue
                # Look for NBS_ROOT in the command or use cwd
                local root=""
                for d in $(pgrep -a -f "nbs-claude" 2>/dev/null | grep -oP '(?<=--root=)\S+' || true); do
                    [[ -d "${d}/.nbs" ]] && root="$d" && break
                done
                [[ -n "$root" ]] || continue

                # Extract handle from the command
                local agent_handle=""
                agent_handle=$(echo "$ts_cmd" | grep -oP '(?<=NBS_HANDLE=)\S+' || true)
                [[ -n "$agent_handle" ]] || continue
                is_infrastructure "$agent_handle" && continue

                echo -n "Spawning sidecar for $agent_handle (nbs-ts=$ts_handle)... "
                "$SIDECAR" \
                    --handle="$agent_handle" \
                    --root="$root" \
                    --transport=ts \
                    --session="$ts_handle" \
                    --log="${root}/.nbs/sidecar-${agent_handle}.log" &
                disown $! 2>/dev/null || true
                echo "PID $!"
                SPAWNED=$((SPAWNED + 1))
                sleep 1
            done <<< "$TS_SESSIONS"
            return
        fi
    fi

    echo "No nbs-ts agent sessions found."
}

# --- Main ---

RESTARTED=0
SPAWNED=0
FAILED=0

if [[ "$MODE" == "respawn" ]]; then
    # First restart any that are running (pick up new binary)
    restart_running
    # Then spawn any that are missing
    respawn_missing
else
    restart_running
fi

echo ""
echo "Restarted: $RESTARTED  Spawned: $SPAWNED"

if [[ -n "$TARGET_HANDLE" && $RESTARTED -eq 0 && $SPAWNED -eq 0 ]]; then
    echo "No sidecar found for handle: $TARGET_HANDLE"
    exit 1
fi
exit 0
