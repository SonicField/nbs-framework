#!/bin/bash
# nbs-sidecar-restart — Hot-restart sidecar processes without killing agents.
#
# Usage:
#   nbs-sidecar-restart              # restart all running sidecars
#   nbs-sidecar-restart <handle>     # restart just one sidecar
#
# Reads each sidecar's command line from /proc, strips --initial-prompt
# (to prevent re-injection into an already-running agent), kills the old
# process, and launches a new one with the updated binary.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure bin/ is in PATH so sidecars can find nbs-prompts, nbs-bus, etc.
case ":${PATH}:" in
    *":${SCRIPT_DIR}:"*) ;;
    *) export PATH="${SCRIPT_DIR}:${PATH}" ;;
esac

TARGET_HANDLE="${1:-}"

if [[ "${TARGET_HANDLE}" == "--help" || "${TARGET_HANDLE}" == "-h" ]]; then
    echo "Usage: $(basename "$0") [handle]"
    echo ""
    echo "Hot-restart nbs-sidecar processes to pick up new binary code."
    echo "Agents (Claude sessions) are not affected."
    echo ""
    echo "  handle    Restart only the sidecar for this handle (optional)."
    echo "            If omitted, restarts all running sidecars."
    exit 0
fi

# Discover running sidecars
# V4.3: Use [n] trick to prevent pgrep from self-matching
# V5.4: Distinguish "no matches" (exit 1) from "pgrep error" (exit 2+)
PIDS=$(pgrep -f '[n]bs-sidecar.*--handle=' 2>/dev/null) || {
    pgrep_rc=$?
    if [[ $pgrep_rc -gt 1 ]]; then
        echo "ERROR: pgrep failed with exit code $pgrep_rc" >&2
        exit 1
    fi
}

if [[ -z "${PIDS:-}" ]]; then
    echo "No running sidecars found."
    exit 0
fi

RESTARTED=0
FAILED=0

for pid in $PIDS; do
    # V5.7: Assert PID is numeric before using in /proc paths or kill
    if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
        echo "ASSERTION FAILED: pgrep returned non-numeric PID: '$pid'" >&2
        exit 1
    fi

    # Read full command line from /proc (NUL-separated)
    if [[ ! -r "/proc/$pid/cmdline" ]]; then
        continue
    fi

    # Parse arguments from NUL-separated cmdline
    mapfile -d '' ARGS < "/proc/$pid/cmdline"

    # Extract handle from arguments
    HANDLE=""
    for arg in "${ARGS[@]}"; do
        case "$arg" in
            --handle=*)
                HANDLE="${arg#--handle=}"
                ;;
        esac
    done

    if [[ -z "$HANDLE" ]]; then
        echo "SKIP: PID $pid — could not extract handle"
        continue
    fi

    # If targeting a specific handle, skip others
    if [[ -n "$TARGET_HANDLE" && "$HANDLE" != "$TARGET_HANDLE" ]]; then
        continue
    fi

    # Skip infrastructure handles — these are ephemeral workers, not
    # persistent team agents. Restarting them is pointless (they should
    # exit on their own) or harmful (creates duplicate workers).
    case "$HANDLE" in
        pythia*|shepard*|fixup*)
            echo "SKIP: $HANDLE (PID $pid) — infrastructure, not a team agent"
            continue
            ;;
    esac

    # Reconstruct args, stripping --initial-prompt and resolving binary path
    NEW_ARGS=()
    for arg in "${ARGS[@]}"; do
        case "$arg" in
            --initial-prompt=*)
                # Skip — do not re-inject into running agent
                ;;
            */nbs-sidecar|nbs-sidecar|bin/nbs-sidecar)
                # Use the current binary from bin/
                NEW_ARGS+=("${SCRIPT_DIR}/nbs-sidecar")
                ;;
            *)
                NEW_ARGS+=("$arg")
                ;;
        esac
    done

    # V4.1: Validate NEW_ARGS is non-empty before exec
    if [[ ${#NEW_ARGS[@]} -eq 0 ]]; then
        echo "FAIL: $HANDLE (PID $pid) — no command after argument filtering"
        FAILED=$((FAILED + 1))
        continue
    fi

    # V4.2: SECURITY — validate binary path matches expected nbs-sidecar
    expected_binary="${SCRIPT_DIR}/nbs-sidecar"
    if [[ "${NEW_ARGS[0]}" != "$expected_binary" ]]; then
        echo "SKIP: PID $pid — binary '${NEW_ARGS[0]}' is not $expected_binary"
        continue
    fi

    if [[ ! -x "${NEW_ARGS[0]}" ]]; then
        echo "FAIL: $HANDLE (PID $pid) — sidecar binary not executable: ${NEW_ARGS[0]}"
        FAILED=$((FAILED + 1))
        continue
    fi

    # V5.5: SECURITY — validate argument formats to prevent injection
    # Arguments from /proc cmdline should only be --flag or --flag=value
    for arg in "${NEW_ARGS[@]:1}"; do
        if [[ ! "$arg" =~ ^--[a-zA-Z_-]+= ]] && [[ ! "$arg" =~ ^--[a-zA-Z_-]+$ ]]; then
            echo "FAIL: $HANDLE (PID $pid) — unexpected argument format: '$arg'" >&2
            FAILED=$((FAILED + 1))
            continue 2
        fi
    done

    # Kill old sidecar
    # V5.1: Log kill result instead of silently discarding errors
    echo -n "Restarting $HANDLE (PID $pid)... "
    if ! kill "$pid" 2>/dev/null; then
        # Process may already be dead — the loop below will confirm
        echo -n "(kill signal may not have been delivered to PID $pid) "
    fi
    # Wait for process to die (up to 3s)
    for i in 1 2 3 4 5 6; do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.5
    done

    # V5.2: Escalate to SIGKILL if SIGTERM did not work
    if kill -0 "$pid" 2>/dev/null; then
        echo -n "SIGTERM did not kill PID $pid, sending SIGKILL... "
        kill -9 "$pid" 2>/dev/null || true
        sleep 1
    fi

    if kill -0 "$pid" 2>/dev/null; then
        echo "FAIL: $HANDLE (PID $pid) — old process did not die even after SIGKILL"
        FAILED=$((FAILED + 1))
        continue
    fi

    # Launch new sidecar
    "${NEW_ARGS[@]}" &
    NEW_PID=$!
    # V5.3: Log disown failure — indicates backgrounding logic error
    if ! disown "$NEW_PID" 2>/dev/null; then
        echo "WARNING: disown failed for PID $NEW_PID — process may be killed when script exits"
    fi

    # V5.8: Improved postcondition — verify new process survives startup
    # Check twice with a gap to catch processes that crash during init
    sleep 1
    if kill -0 "$NEW_PID" 2>/dev/null; then
        sleep 2
        if kill -0 "$NEW_PID" 2>/dev/null; then
            echo "$pid → $NEW_PID"
            RESTARTED=$((RESTARTED + 1))
        else
            echo "FAIL: $HANDLE — new process (PID $NEW_PID) died during startup"
            FAILED=$((FAILED + 1))
        fi
    else
        echo "FAIL: $HANDLE (PID $pid) — new process (PID $NEW_PID) died immediately"
        FAILED=$((FAILED + 1))
    fi

    # Stagger restarts
    sleep 1
done

echo ""
echo "Restarted: $RESTARTED  Failed: $FAILED"

if [[ -n "$TARGET_HANDLE" && $RESTARTED -eq 0 && $FAILED -eq 0 ]]; then
    echo "No sidecar found for handle: $TARGET_HANDLE"
    exit 1
fi

# V4.4: Use 0/1 exit code, not FAILED count (which can overflow valid range)
if [[ "$FAILED" -gt 0 ]]; then
    exit 1
fi
exit 0
