#!/bin/bash
# nbs-remote-status: Quick state check of a remote pty-session
#
# Runs git status, git diff --stat, and optionally checks for running
# builds on a remote pty-session. One command instead of three.
#
# Usage:
#   nbs-remote-status <session> [options]
#
# Options:
#   --cwd=DIR          Working directory on the remote machine
#   --chat=FILE        Post status to this chat file
#   --handle=NAME      Chat handle (required with --chat)
#   --last=N           Lines of scrollback to capture (default: 100)
#
# Examples:
#   nbs-remote-status my-server --cwd=/home/user/project
#   nbs-remote-status my-server --cwd=/home/user/project \
#       --chat=.nbs/chat/live.chat --handle=helper
#
# Output:
#   === Remote Status: <session> ===
#   HEAD: <commit hash and message>
#   Branch: <branch name>
#   Working tree: <clean | N files changed>
#   Modified files: <list>
#
# Exit codes:
#   0 - Success
#   2 - Session not found
#   3 - Timeout
#   4 - Invalid arguments

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_TS="${SCRIPT_DIR}/nbs-ts"
[[ -x "$NBS_TS" ]] || NBS_TS="${HOME}/.nbs/bin/nbs-ts"
NBS_CHAT="${HOME}/.nbs/bin/nbs-chat"

[[ -x "$NBS_TS" ]] || { echo "Error: nbs-ts not found" >&2; exit 1; }



SESSION=""
CWD=""
CHAT_FILE=""
CHAT_HANDLE=""
LAST=100

usage() {
    [[ -f "$0" ]] || { echo "Error: cannot read $0 for usage" >&2; return 1; }
    grep '^#' "$0" | grep -v '!/bin/bash' | cut -c3-
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cwd=*)    CWD="${1#--cwd=}"; shift ;;
        --chat=*)   CHAT_FILE="${1#--chat=}"; shift ;;
        --handle=*) CHAT_HANDLE="${1#--handle=}"; shift ;;
        --last=*)   LAST="${1#--last=}"; shift ;;
        --help|-h)  usage; exit 0 ;;
        help)       usage; exit 0 ;;
        -*)         echo "Unknown option: $1" >&2; exit 4 ;;
        *)
            if [[ -z "$SESSION" ]]; then
                SESSION="$1"
            else
                echo "Error: unexpected argument: $1" >&2
                exit 4
            fi
            shift
            ;;
    esac
done

if [[ -z "$SESSION" ]]; then
    echo "Error: requires <session>" >&2
    echo "Usage: nbs-remote-status <session> [options]" >&2
    exit 4
fi

# Precondition: session name must contain only safe characters (SECURITY: prevents marker/command injection)
[[ "$SESSION" =~ ^[a-zA-Z0-9._-]+$ ]] || { echo "Error: session name contains invalid characters: '$SESSION'" >&2; exit 4; }

if [[ -n "$CHAT_FILE" ]] && [[ -z "$CHAT_HANDLE" ]]; then
    echo "Error: --handle is required when --chat is set" >&2
    exit 4
fi

# Precondition: nbs-chat must exist if --chat is used (BUG: validated late, fails silently after all work done)
if [[ -n "$CHAT_FILE" ]]; then
    [[ -x "$NBS_CHAT" ]] || { echo "Error: nbs-chat not found at $NBS_CHAT" >&2; exit 1; }
fi

# Validate numeric arguments — must be a positive integer, not zero (BUG: LAST=0 guarantees timeout)
[[ "$LAST" =~ ^[0-9]+$ ]] && (( LAST > 0 )) || { echo "Error: --last must be a positive integer, got '$LAST'" >&2; exit 4; }

# Validate CWD is an absolute path with safe characters (SECURITY: prevents injection via cd command)
if [[ -n "$CWD" ]]; then
    [[ "$CWD" == /* ]] || { echo "Error: --cwd must be an absolute path, got '$CWD'" >&2; exit 4; }
    CWD_RE='^[a-zA-Z0-9/._ -]+$'
    [[ "$CWD" =~ $CWD_RE ]] || { echo "Error: --cwd contains suspicious characters: '$CWD'" >&2; exit 4; }
fi

# Session dispatch helpers


# Verify session exists
if ! "$NBS_TS" read "$SESSION" --last=1 2>/dev/null >/dev/null 2>&1; then
    echo "Error: session '$SESSION' not found" >&2
    exit 2
fi

# Use markers with cryptographic randomness to prevent injection and collision
# (BUG: PID-only markers collide on PID reuse; SECURITY: predictable markers injectable)
MARKER_RANDOM=$(head -c 16 /dev/urandom | xxd -p)
MARKER_START="NBS_STATUS_START_${MARKER_RANDOM}"
MARKER_END="NBS_STATUS_END_${MARKER_RANDOM}"

# Build command: git log, status, and diff --stat in one shot
STATUS_CMD="echo '---HEAD---'; git log --oneline -1; echo '---BRANCH---'; git rev-parse --abbrev-ref HEAD; echo '---STATUS---'; git status --porcelain; echo '---DIFFSTAT---'; git diff --stat"

FULL_CMD="$STATUS_CMD"
if [[ -n "$CWD" ]]; then
    FULL_CMD="cd $(printf '%q' "$CWD") && ${STATUS_CMD}"
fi

# Single-quote markers in remote command to prevent shell expansion
if ! "$NBS_TS" send "$SESSION" "echo '${MARKER_START}'; ${FULL_CMD}; echo '${MARKER_END}'"; then
    echo "Error: Failed to send status command to session '$SESSION'" >&2
    exit 1
fi

# Wait for completion
TIMEOUT=30
elapsed=0
POLL=2
consecutive_failures=0

while (( elapsed < TIMEOUT )); do
    sleep "$POLL"
    elapsed=$((elapsed + POLL))

    # Track consecutive read failures to detect dead sessions (BUG: was silently swallowed with || true)
    if output=$("$NBS_TS" read "$SESSION" --last="$LAST" 2>/dev/null); then
        consecutive_failures=0
    else
        consecutive_failures=$((consecutive_failures + 1))
        if (( consecutive_failures >= 3 )); then
            echo "Error: session read failed 3 consecutive times for '$SESSION'" >&2
            exit 2
        fi
        continue
    fi

    # Use grep -F for fixed-string matching (HARDENING: markers treated as literal, not regex)
    if echo "$output" | grep -qF "$MARKER_END"; then
        # Extract content using awk with literal string matching (HARDENING: sed treated markers as regex)
        raw=$(echo "$output" | awk -v start="$MARKER_START" -v end="$MARKER_END" '
            $0 == start { capture=1; next }
            $0 == end { capture=0; next }
            capture { print }
        ')

        # Parse sections
        head_line=$(echo "$raw" | sed -n '/---HEAD---/,/---BRANCH---/p' | grep -v '^---' | head -1)
        branch=$(echo "$raw" | sed -n '/---BRANCH---/,/---STATUS---/p' | grep -v '^---' | head -1)
        status_lines=$(echo "$raw" | sed -n '/---STATUS---/,/---DIFFSTAT---/p' | grep -v '^---')
        diffstat=$(echo "$raw" | sed -n '/---DIFFSTAT---/,$p' | grep -v '^---')

        # Postcondition: verify parse succeeded (BUG: empty sections produce misleading "clean" status)
        if [[ -z "$head_line" ]] || [[ -z "$branch" ]]; then
            echo "Error: Failed to parse git status from remote output. Raw output:" >&2
            echo "$raw" >&2
            exit 1
        fi

        # Count modified files using porcelain format (HARDENING: grep -c '.' counted any non-empty line)
        n_modified=0
        if [[ -n "$status_lines" ]]; then
            n_modified=$(echo "$status_lines" | grep -c '^[MADRCU? ]' || true)
        fi

        # Format output
        result="=== Remote Status: ${SESSION} ===
HEAD: ${head_line:-unknown}
Branch: ${branch:-unknown}
Working tree: $(if [[ $n_modified -eq 0 ]]; then echo 'clean'; else echo "${n_modified} files changed"; fi)"

        if [[ $n_modified -gt 0 ]]; then
            result="${result}
Modified:
${status_lines}"
        fi

        if [[ -n "$diffstat" ]]; then
            result="${result}
Diff stat:
${diffstat}"
        fi

        echo "$result"

        # Post to chat if requested
        if [[ -n "$CHAT_FILE" ]] && [[ -n "$CHAT_HANDLE" ]]; then
            # Fail hard if chat post fails — user explicitly requested it (BUG: was silently downgraded to warning)
            # stderr flows to stderr naturally (HARDENING: 2>&1 was hiding error details)
            if ! "$NBS_CHAT" send "$CHAT_FILE" "$CHAT_HANDLE" "$result"; then
                echo "Error: Failed to post status to chat file '$CHAT_FILE'" >&2
                exit 1
            fi
        fi

        exit 0
    fi
done

echo "Error: Timed out waiting for status (${TIMEOUT}s)" >&2
exit 3
