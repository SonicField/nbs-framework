#!/bin/bash
# nbs-remote-edit: Edit files on remote machines via scp
#
# Usage:
#   nbs-remote-edit pull <server> <remote-path>   Download file for local editing
#   nbs-remote-edit push <server> <remote-path>   Upload edited file back
#   nbs-remote-edit diff <server> <remote-path>   Show diff between local and remote
#   nbs-remote-edit help                          Show this help
#
# <server> is an SSH hostname or user@hostname — NOT a pty-session name.
# A pty-session is created internally for scp. You never manage it.
#
# Environment:
#   NBS_REMOTE_EDIT_DIR   Local staging directory (default: .nbs/remote-edit)
#
# Examples:
#   nbs-remote-edit pull build-host /home/user/project/src/main.cpp
#   # Edit .nbs/remote-edit/build-host
#   nbs-remote-edit push build-host /home/user/project/src/main.cpp
#
# Exit codes:
#   0 - Success
#   1 - General error
#   2 - File not found (remote or local)
#   3 - Transfer failed
#   4 - Invalid arguments

set -euo pipefail

PTY_SESSION="${HOME}/.nbs/bin/pty-session"
STAGING_DIR="$(cd "${NBS_REMOTE_EDIT_DIR:-.nbs/remote-edit}" 2>/dev/null && pwd || echo "$(pwd)/.nbs/remote-edit")"

# Suppress pty-session tool banner
export NBS_PTY_QUIET=1

usage() {
    grep '^#' "$0" | grep -v '!/bin/bash' | cut -c3-
}

die() {
    local rc="$1"; shift
    echo "Error: $*" >&2
    echo "" >&2
    usage >&2
    exit "$rc"
}

[[ -x "$PTY_SESSION" ]] || die 1 "pty-session not found at $PTY_SESSION"

local_path() {
    local host="$1"
    local remote_path="$2"
    [[ "$host" =~ [/] ]] && die 4 "<server> must be an SSH hostname (e.g. build-host not a path"
    echo "${STAGING_DIR}/${host}${remote_path}"
}

# Run scp via a short-lived pty-session (gets user's credentials)
run_scp() {
    local session_name="nbs-edit-$$"
    "$PTY_SESSION" create "$session_name" 'bash --login' >/dev/null 2>&1
    sleep 1

    "$PTY_SESSION" send "$session_name" "$1; echo EDIT_RC=\$?" >/dev/null 2>&1

    # Wait for completion
    local elapsed=0
    local timeout=30
    while (( elapsed < timeout )); do
        sleep 2
        elapsed=$((elapsed + 2))
        local output
        output=$("$PTY_SESSION" read "$session_name" 2>/dev/null) || true
        if echo "$output" | grep -q "EDIT_RC="; then
            local rc
            rc=$(echo "$output" | grep -oP 'EDIT_RC=\K[0-9]+' | tail -1)
            "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1 || true
            return "${rc:-1}"
        fi
    done

    "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1 || true
    echo "Error: scp timed out after ${timeout}s" >&2
    return 3
}

cmd_pull() {
    local host="${1:-}"
    local remote_path="${2:-}"

    if [[ -z "$host" ]] || [[ -z "$remote_path" ]]; then
        die 4 "pull requires <server> <remote-path>. <server> is an SSH hostname, not a pty-session name."
    fi

    local lpath
    lpath=$(local_path "$host" "$remote_path")
    mkdir -p "$(dirname "$lpath")"

    if run_scp "scp $(printf '%q' "${host}:${remote_path}") $(printf '%q' "$lpath")"; then
        if [[ -f "$lpath" ]]; then
            echo "$lpath"
        else
            echo "Error: scp succeeded but file not found at $lpath" >&2
            return 1
        fi
    else
        rm -f "$lpath"
        echo "Error: Failed to download ${host}:${remote_path}" >&2
        return 3
    fi
}

cmd_push() {
    local host="${1:-}"
    local remote_path="${2:-}"

    if [[ -z "$host" ]] || [[ -z "$remote_path" ]]; then
        die 4 "push requires <server> <remote-path>. <server> is an SSH hostname, not a pty-session name."
    fi

    local lpath
    lpath=$(local_path "$host" "$remote_path")

    if [[ ! -f "$lpath" ]]; then
        die 2 "Local file not found: $lpath — did you run 'nbs-remote-edit pull' first?"
    fi

    if run_scp "scp $(printf '%q' "$lpath") $(printf '%q' "${host}:${remote_path}")"; then
        echo "Pushed: ${remote_path} -> ${host}"
    else
        echo "Error: Failed to upload to ${host}:${remote_path}" >&2
        return 3
    fi
}

cmd_diff() {
    local host="${1:-}"
    local remote_path="${2:-}"

    if [[ -z "$host" ]] || [[ -z "$remote_path" ]]; then
        die 4 "diff requires <server> <remote-path>. <server> is an SSH hostname, not a pty-session name."
    fi

    local lpath
    lpath=$(local_path "$host" "$remote_path")

    if [[ ! -f "$lpath" ]]; then
        die 2 "Local file not found: $lpath"
    fi

    local tmp
    tmp=$(mktemp)
    trap "rm -f $(printf '%q' "$tmp")" RETURN

    if run_scp "scp $(printf '%q' "${host}:${remote_path}") $(printf '%q' "$tmp")"; then
        diff -u "$tmp" "$lpath" --label "remote:${remote_path}" --label "local:${lpath}" || true
    else
        echo "Error: Failed to download ${host}:${remote_path} for diff" >&2
        return 3
    fi
}

# Main dispatch
case "${1:-}" in
    pull)  shift; cmd_pull "$@" ;;
    push)  shift; cmd_push "$@" ;;
    diff)  shift; cmd_diff "$@" ;;
    help|--help|-h|"") usage ;;
    *)
        die 4 "Unknown command: $1"
        ;;
esac
