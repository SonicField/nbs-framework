#!/bin/bash
# nbs-remote-edit: Edit files on remote machines via scp
#
# Usage:
#   nbs-remote-edit pull <server> <remote-path>   Download file for local editing
#   nbs-remote-edit push <server> <remote-path>   Upload edited file back
#   nbs-remote-edit diff <server> <remote-path>   Show diff between local and remote
#   nbs-remote-edit help                          Show this help
#
# <server> is an SSH hostname or user@hostname — NOT a pty-session name.
# A pty-session is created internally for scp. You never manage it.
#
# Environment:
#   NBS_REMOTE_EDIT_DIR   Local staging directory (default: .nbs/remote-edit)
#
# Examples:
#   nbs-remote-edit pull build-host /home/user/project/src/main.cpp
#   # Edit .nbs/remote-edit/build-host
#   nbs-remote-edit push build-host /home/user/project/src/main.cpp
#
# Exit codes:
#   0 - Success
#   1 - General error
#   2 - File not found (remote or local)
#   3 - Transfer failed
#   4 - Invalid arguments

set -euo pipefail

PTY_SESSION="${HOME}/.nbs/bin/pty-session"

# V7: Validate NBS_REMOTE_EDIT_DIR if explicitly set, rather than silently falling back
if [[ -n "${NBS_REMOTE_EDIT_DIR:-}" ]]; then
    [[ -d "$NBS_REMOTE_EDIT_DIR" ]] || {
        echo "Error: NBS_REMOTE_EDIT_DIR does not exist: $NBS_REMOTE_EDIT_DIR" >&2
        exit 1
    }
    STAGING_DIR="$(cd "$NBS_REMOTE_EDIT_DIR" && pwd)"
else
    STAGING_DIR="$(pwd)/.nbs/remote-edit"
fi

# Suppress pty-session tool banner
export NBS_PTY_QUIET=1

# V8: Guard usage against $0 not being a readable file
usage() {
    if [[ -f "$0" ]] && [[ -r "$0" ]]; then
        # Extract only the header comment block (lines starting with # before
        # the first non-comment, non-shebang line), not inline code comments
        sed -n '2,/^[^#]/{ /^#/p }' "$0" | grep -v '!/bin/bash' | cut -c3-
    else
        echo "Usage: nbs-remote-edit {pull|push|diff|help} <server> <remote-path>" >&2
    fi
}

die() {
    local rc="$1"; shift
    echo "Error: $*" >&2
    echo "" >&2
    usage >&2
    exit "$rc"
}

[[ -x "$PTY_SESSION" ]] || die 1 "pty-session not found at $PTY_SESSION"

# V1 (SECURITY): Validate hostname and remote path against injection
# V2 (BUG): Validate remote_path is absolute
local_path() {
    local host="$1"
    local remote_path="$2"
    # Hostname: only alphanumeric, dots, hyphens, underscores, @ (for user@host)
    [[ "$host" =~ ^[a-zA-Z0-9._@-]+$ ]] || die 4 "Invalid server hostname (only alphanumeric, dots, hyphens, underscores, @ allowed): $host"
    # Remote path must be absolute
    [[ "$remote_path" =~ ^/ ]] || die 4 "Remote path must be absolute (start with /), got: $remote_path"
    # Remote path must contain only safe POSIX path characters
    [[ "$remote_path" =~ [^a-zA-Z0-9_./-] ]] && die 4 "Remote path contains disallowed characters: $remote_path"
    echo "${STAGING_DIR}/${host}${remote_path}"
}

# Run scp via a short-lived pty-session (gets user's credentials)
run_scp() {
    # V9: Add RANDOM suffix for uniqueness under concurrent use
    local session_name="nbs-edit-$$-${RANDOM}"

    # V4: Check pty-session create success and report errors
    if ! "$PTY_SESSION" create "$session_name" 'bash --login' >/dev/null 2>&1; then
        echo "Error: Failed to create pty-session '$session_name'" >&2
        return 3
    fi
    sleep 1

    # V4: Check pty-session send success
    if ! "$PTY_SESSION" send "$session_name" "$1; echo EDIT_RC=\$?" >/dev/null 2>&1; then
        "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1 || true
        echo "Error: Failed to send command to pty-session '$session_name'" >&2
        return 3
    fi

    # Wait for completion
    local elapsed=0
    local timeout=30
    while (( elapsed < timeout )); do
        sleep 2
        elapsed=$((elapsed + 2))
        local output
        output=$("$PTY_SESSION" read "$session_name" 2>/dev/null) || true
        # V6: Use bash regex for stricter, atomic matching of exit code
        if [[ "$output" =~ EDIT_RC=([0-9]+) ]]; then
            local rc="${BASH_REMATCH[1]}"
            "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1 || true
            return "$rc"
        fi
    done

    # V4: Warn if session kill fails (possible orphan)
    if ! "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1; then
        echo "Warning: failed to kill pty-session '$session_name' — may need manual cleanup" >&2
    fi
    echo "Error: scp timed out after ${timeout}s" >&2
    return 3
}

cmd_pull() {
    local host="${1:-}"
    local remote_path="${2:-}"

    if [[ -z "$host" ]] || [[ -z "$remote_path" ]]; then
        die 4 "pull requires <server> <remote-path>. <server> is an SSH hostname, not a pty-session name."
    fi

    local lpath
    lpath=$(local_path "$host" "$remote_path")
    mkdir -p "$(dirname "$lpath")"

    if run_scp "scp $(printf '%q' "${host}:${remote_path}") $(printf '%q' "$lpath")"; then
        if [[ -f "$lpath" ]]; then
            echo "$lpath"
        else
            echo "Error: scp succeeded but file not found at $lpath" >&2
            return 1
        fi
    else
        rm -f "$lpath"
        echo "Error: Failed to download ${host}:${remote_path}" >&2
        return 3
    fi
}

cmd_push() {
    local host="${1:-}"
    local remote_path="${2:-}"

    if [[ -z "$host" ]] || [[ -z "$remote_path" ]]; then
        die 4 "push requires <server> <remote-path>. <server> is an SSH hostname, not a pty-session name."
    fi

    local lpath
    lpath=$(local_path "$host" "$remote_path")

    if [[ ! -f "$lpath" ]]; then
        die 2 "Local file not found: $lpath — did you run 'nbs-remote-edit pull' first?"
    fi

    if run_scp "scp $(printf '%q' "$lpath") $(printf '%q' "${host}:${remote_path}")"; then
        echo "Pushed: ${remote_path} -> ${host}"
    else
        echo "Error: Failed to upload to ${host}:${remote_path}" >&2
        return 3
    fi
}

cmd_diff() {
    local host="${1:-}"
    local remote_path="${2:-}"

    if [[ -z "$host" ]] || [[ -z "$remote_path" ]]; then
        die 4 "diff requires <server> <remote-path>. <server> is an SSH hostname, not a pty-session name."
    fi

    local lpath
    lpath=$(local_path "$host" "$remote_path")

    if [[ ! -f "$lpath" ]]; then
        die 2 "Local file not found: $lpath"
    fi

    local tmp
    tmp=$(mktemp)
    # V3: Use EXIT instead of RETURN so temp file is cleaned on signals too
    trap "rm -f $(printf '%q' "$tmp")" EXIT

    if run_scp "scp $(printf '%q' "${host}:${remote_path}") $(printf '%q' "$tmp")"; then
        diff -u "$tmp" "$lpath" --label "remote:${remote_path}" --label "local:${lpath}" || true
    else
        echo "Error: Failed to download ${host}:${remote_path} for diff" >&2
        return 3
    fi
}

# Main dispatch
case "${1:-}" in
    pull)  shift; cmd_pull "$@" ;;
    push)  shift; cmd_push "$@" ;;
    diff)  shift; cmd_diff "$@" ;;
    help|--help|-h|"") usage ;;
    *)
        die 4 "Unknown command: $1"
        ;;
esac
