#!/bin/bash
# nbs-kick-agent — Level 4 hard restart of a single agent
#
# Usage: nbs-kick-agent <agent> <project-root> <chat-file>
#
# Performs: kill session, clean PID, reset cursor, respawn, verify.
# Output goes to stdout for capture by nbs-chat-terminal INFO lines.
#
# Exit codes:
#   0 — agent restarted and verified
#   1 — restart failed (agent did not come up)
#   4 — invalid arguments

set -uo pipefail

if [[ $# -ne 3 ]]; then
    echo "Usage: nbs-kick-agent <agent> <project-root> <chat-file>"
    exit 4
fi

AGENT="$1"
PROJECT_ROOT="$2"
CHAT_FILE="$3"

# Validate agent name
VALID_AGENTS="scribe medic supervisor gatekeeper theologian testkeeper generalist"
VALID=0
for a in $VALID_AGENTS; do
    if [[ "$AGENT" == "$a" ]]; then
        VALID=1
        break
    fi
done

if [[ $VALID -eq 0 ]]; then
    echo "Error: unknown agent '$AGENT'"
    echo "Valid agents: $VALID_AGENTS"
    exit 4
fi

# Derive tag from chat file
TAG=$(basename "$CHAT_FILE" .chat | tr '.' '-')
SESSION_NAME="nbs-${AGENT}-${TAG}"

# 1. Kill existing session (use nbs-ts find for exact match)
HANDLE=$(nbs-ts find "$SESSION_NAME" 2>/dev/null)
if [[ -n "$HANDLE" ]]; then
    STATUS=$(nbs-ts status "$HANDLE" 2>/dev/null)
    echo "Killing session $SESSION_NAME ($HANDLE, $STATUS)..."
    nbs-ts kill "$HANDLE" 2>/dev/null || true
    sleep 2  # wait for session cleanup before spawning replacement
else
    echo "No session found for $AGENT ($SESSION_NAME)"
fi

# 2. Clean PID file
rm -f "${PROJECT_ROOT}/.nbs/pids/${AGENT}.pid"

# 3. Reset cursor (lock-safe via nbs-chat cursor-set, msg_count-1 so agent sees last message)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_CHAT="${SCRIPT_DIR}/nbs-chat"
MSG_COUNT=$("$NBS_CHAT" count "$CHAT_FILE" 2>/dev/null || echo 0)
if [[ $MSG_COUNT -gt 0 ]]; then
    RESET_TO=$((MSG_COUNT - 1))
else
    RESET_TO=0
fi
"$NBS_CHAT" cursor-set "$CHAT_FILE" "$AGENT" "$RESET_TO" 2>/dev/null
echo "Cursor reset to $RESET_TO (msg_count=$MSG_COUNT)"

# 4. Respawn
echo "Respawning $AGENT..."
cd "$PROJECT_ROOT" || exit 1

NBS_LAUNCH="${PROJECT_ROOT}/.nbs/bin/nbs-launch-agent"
if [[ ! -f "$NBS_LAUNCH" ]]; then
    NBS_LAUNCH="${PROJECT_ROOT}/bin/nbs-launch-agent"
fi
if [[ ! -f "$NBS_LAUNCH" ]]; then
    echo "Error: nbs-launch-agent not found"
    exit 1
fi

source "$NBS_LAUNCH"
launch_agent "${AGENT}" "${PROJECT_ROOT}" ".nbs/bin/nbs-claude" \
    "Read .nbs/workers/${AGENT}-skill.md and follow the role instructions. Then read the chat history and begin work."

# 5. Verify (wait up to 30s)
echo "Waiting for $AGENT to start..."
ELAPSED=0
while [[ $ELAPSED -lt 30 ]]; do
    sleep 5
    ELAPSED=$((ELAPSED + 5))
    VERIFY=$(nbs-ts find "$SESSION_NAME" 2>/dev/null)
    if [[ -n "$VERIFY" ]]; then
        VSTATUS=$(nbs-ts status "$VERIFY" 2>/dev/null)
        if [[ "$VSTATUS" == "alive" ]]; then
            echo "$AGENT alive and verified ($VERIFY)"
            exit 0
        fi
    fi
done

echo "RESTART FAILED — $AGENT not alive after 30s"
exit 1
