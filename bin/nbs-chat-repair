#!/bin/bash
# nbs-chat-repair: Detect and repair corrupt lines in nbs-chat files
#
# Scans a chat file for lines after the --- header separator that are not
# valid base64. Corrupt lines are blanked in-place (preserving file byte
# count) and a recovery message is appended with the salvaged content.
#
# Usage:
#   nbs-chat-repair <chat-file> [--dry-run]
#
# Exit codes:
#   0 - Repair completed (or no corruption found)
#   1 - Error (file not found, write failed)
#   4 - Invalid arguments

set -euo pipefail

# --- Argument parsing ---

if [[ $# -lt 1 ]]; then
    echo "Usage: nbs-chat-repair <chat-file> [--dry-run]" >&2
    exit 4
fi

CHAT_FILE="$1"
DRY_RUN=0

shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 4
            ;;
    esac
    shift
done

if [[ ! -f "$CHAT_FILE" ]]; then
    echo "Error: file not found: $CHAT_FILE" >&2
    exit 1
fi

# Resolve nbs-chat binary — same directory as this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_CHAT="${NBS_CHAT_BIN:-$SCRIPT_DIR/nbs-chat}"

if [[ ! -x "$NBS_CHAT" ]]; then
    echo "Error: nbs-chat binary not found at $NBS_CHAT" >&2
    exit 1
fi

# --- Constants ---
MAX_RECOVER_BYTES=65536  # 64KB truncation limit

# --- Find the --- separator line ---

SEPARATOR_LINE=0
LINE_NUM=0
while IFS= read -r line; do
    LINE_NUM=$((LINE_NUM + 1))
    if [[ "$line" == "---" ]]; then
        SEPARATOR_LINE=$LINE_NUM
        break
    fi
done < "$CHAT_FILE"

if [[ $SEPARATOR_LINE -eq 0 ]]; then
    echo "Error: no --- separator found in $CHAT_FILE" >&2
    exit 1
fi

# --- Scan lines after separator for corruption ---

# Base64 alphabet regex: only A-Za-z0-9+/= characters
B64_RE='^[A-Za-z0-9+/=]+$'

# Collect corrupt line info: line_number, byte_offset, line_length, content
declare -a CORRUPT_LINES=()      # line numbers (1-based)
declare -a CORRUPT_OFFSETS=()    # byte offsets in file
declare -a CORRUPT_LENGTHS=()    # byte lengths including newline
declare -a CORRUPT_CONTENT=()    # raw content (without trailing newline)

BYTE_OFFSET=0
LINE_NUM=0
PAST_SEPARATOR=0

# Force C locale for byte-accurate ${#var} — without this, ${#var}
# returns character count in UTF-8 locales, corrupting byte offsets.
while LC_ALL=C IFS= read -r line || [[ -n "$line" ]]; do
    LINE_NUM=$((LINE_NUM + 1))
    # In LC_ALL=C, ${#line} returns byte count (not character count)
    LINE_BYTES=${#line}

    if [[ $PAST_SEPARATOR -eq 0 ]]; then
        if [[ "$line" == "---" ]]; then
            PAST_SEPARATOR=1
        fi
        BYTE_OFFSET=$((BYTE_OFFSET + LINE_BYTES + 1))
        continue
    fi

    # We are past the separator — check if this line is valid base64
    IS_CORRUPT=0

    if [[ -z "$line" ]]; then
        # Empty line — chat_read skips these, not corrupt per se
        BYTE_OFFSET=$((BYTE_OFFSET + 1))  # just the newline
        continue
    fi

    # Check 1: length must be a multiple of 4
    if [[ $((LINE_BYTES % 4)) -ne 0 ]]; then
        IS_CORRUPT=1
    fi

    # Check 2: must contain only base64 alphabet characters
    if [[ $IS_CORRUPT -eq 0 ]] && ! [[ "$line" =~ $B64_RE ]]; then
        IS_CORRUPT=1
    fi

    if [[ $IS_CORRUPT -eq 1 ]]; then
        # Check if this is a space-padded line from a previous repair
        STRIPPED=$(echo "$line" | tr -d ' ')
        if [[ -z "$STRIPPED" ]]; then
            # All spaces — already repaired, skip
            BYTE_OFFSET=$((BYTE_OFFSET + LINE_BYTES + 1))
            continue
        fi

        CORRUPT_LINES+=("$LINE_NUM")
        CORRUPT_OFFSETS+=("$BYTE_OFFSET")
        CORRUPT_LENGTHS+=("$((LINE_BYTES + 1))")  # +1 for newline
        CORRUPT_CONTENT+=("$line")
    fi

    BYTE_OFFSET=$((BYTE_OFFSET + LINE_BYTES + 1))
done < "$CHAT_FILE"

# --- Check results ---

if [[ ${#CORRUPT_LINES[@]} -eq 0 ]]; then
    echo "No corruption found in $CHAT_FILE"
    exit 0
fi

echo "Found ${#CORRUPT_LINES[@]} corrupt line(s) in $CHAT_FILE"

# --- Group consecutive corrupt lines ---
# Consecutive lines are treated as one message (heuristic from spec)

declare -a GROUP_START=()    # index into CORRUPT_LINES for group start
declare -a GROUP_END=()      # index into CORRUPT_LINES for group end (inclusive)

GROUP_IDX=0
GROUP_START+=("0")
for ((i = 1; i < ${#CORRUPT_LINES[@]}; i++)); do
    PREV_LINE=${CORRUPT_LINES[$((i - 1))]}
    CURR_LINE=${CORRUPT_LINES[$i]}
    if [[ $((CURR_LINE - PREV_LINE)) -ne 1 ]]; then
        # Not consecutive — close previous group, start new one
        GROUP_END+=("$((i - 1))")
        GROUP_START+=("$i")
    fi
done
GROUP_END+=("$((${#CORRUPT_LINES[@]} - 1))")

# --- Sanitise recovered text ---

sanitise_text() {
    local raw="$1"
    local sanitised

    # Step 1: UTF-8 validation — strip invalid sequences
    sanitised=$(echo "$raw" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || echo "$raw")

    # Step 2: Strip ANSI escape sequences
    sanitised=$(echo "$sanitised" | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g')

    # Step 3: Strip control characters (keep tab 0x09, newline 0x0A)
    # Convert CR to newline, strip 0x00-0x08, 0x0B, 0x0C, 0x0E-0x1F, 0x7F
    sanitised=$(echo "$sanitised" | tr '\r' '\n' | tr -d '\000-\010\013\014\016-\037\177')

    # Step 4: Length truncation
    local byte_len=${#sanitised}
    if [[ $byte_len -gt $MAX_RECOVER_BYTES ]]; then
        sanitised="${sanitised:0:$MAX_RECOVER_BYTES}
[truncated — original was $byte_len bytes]"
    fi

    echo "$sanitised"
}

# Check if text is valid UTF-8
is_valid_utf8() {
    local text="$1"
    echo "$text" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1
}

# --- Build recovery message ---

RECOVERY_TEXT="[AUTO-REPAIR] Recovered ${#CORRUPT_LINES[@]} corrupt line(s) from chat file."

for ((g = 0; g < ${#GROUP_START[@]}; g++)); do
    START_IDX=${GROUP_START[$g]}
    END_IDX=${GROUP_END[$g]}

    FIRST_LINE=${CORRUPT_LINES[$START_IDX]}
    LAST_LINE=${CORRUPT_LINES[$END_IDX]}

    # Collect content for this group
    GROUP_CONTENT=""
    GROUP_IS_BINARY=0

    for ((i = START_IDX; i <= END_IDX; i++)); do
        RAW="${CORRUPT_CONTENT[$i]}"

        # Check if content is valid UTF-8
        if ! is_valid_utf8 "$RAW"; then
            GROUP_IS_BINARY=1
        fi

        if [[ $i -eq $START_IDX ]]; then
            GROUP_CONTENT="$RAW"
        else
            GROUP_CONTENT="$GROUP_CONTENT
$RAW"
        fi
    done

    if [[ $FIRST_LINE -eq $LAST_LINE ]]; then
        LINE_LABEL="line $FIRST_LINE"
    else
        LINE_LABEL="lines $FIRST_LINE-$LAST_LINE"
    fi

    if [[ $GROUP_IS_BINARY -eq 1 ]]; then
        # Binary garbage — hex dump
        BYTE_COUNT=${#GROUP_CONTENT}
        HEX_DUMP=$(echo -n "$GROUP_CONTENT" | xxd -l 40 -p 2>/dev/null | head -1)
        RECOVERY_TEXT="$RECOVERY_TEXT

--- Unrecoverable ($LINE_LABEL) ---
$BYTE_COUNT bytes, hex: $HEX_DUMP"
    else
        # Recoverable text — sanitise
        SANITISED=$(sanitise_text "$GROUP_CONTENT")
        RECOVERY_TEXT="$RECOVERY_TEXT

--- Recovered text ($LINE_LABEL) ---
$SANITISED"
    fi
done

# --- Dry run: report and exit ---

if [[ $DRY_RUN -eq 1 ]]; then
    echo ""
    echo "Dry run — would perform the following repair:"
    echo ""
    for ((i = 0; i < ${#CORRUPT_LINES[@]}; i++)); do
        echo "  Line ${CORRUPT_LINES[$i]}: blank ${CORRUPT_LENGTHS[$i]} bytes"
    done
    echo ""
    echo "Recovery message:"
    echo "$RECOVERY_TEXT"
    exit 0
fi

# --- In-place replacement: blank corrupt lines with spaces ---

for ((i = 0; i < ${#CORRUPT_LINES[@]}; i++)); do
    OFFSET=${CORRUPT_OFFSETS[$i]}
    LENGTH=${CORRUPT_LENGTHS[$i]}

    # Write LENGTH-1 spaces followed by one newline at OFFSET
    SPACE_COUNT=$((LENGTH - 1))
    SPACES=$(printf '%*s' "$SPACE_COUNT" '')

    # Use dd for byte-precise in-place writes
    printf '%s\n' "$SPACES" | dd of="$CHAT_FILE" bs=1 seek="$OFFSET" count="$LENGTH" conv=notrunc 2>/dev/null
done

# --- Append recovery message via nbs-chat send ---

"$NBS_CHAT" send "$CHAT_FILE" "chat-repair" "$RECOVERY_TEXT"

echo "Repair complete: ${#CORRUPT_LINES[@]} corrupt line(s) blanked, recovery message appended."
exit 0
