#!/bin/bash
# nbs-digest-spawn: Spawn ephemeral worker to digest a chat file
#
# Produces a structured digest of the chat session and posts the
# summary to chat. Used by nbs-teams-restart to brief recovered
# agents automatically.
#
# Usage:
#   nbs-digest-spawn <chat-file> [--wait]
#
# Options:
#   --wait    Block until the digest worker completes (default: fire and forget)
#
# Exit codes:
#   0 - Success (worker spawned, or completed if --wait)
#   1 - Error
#   4 - Invalid arguments

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NBS_WORKERS="${SCRIPT_DIR}/nbs-workers"
NBS_CHAT="${SCRIPT_DIR}/nbs-chat"

# Project root is the current working directory, NOT the script's parent.
# The script may be in the framework's bin/ (via symlink) while the project
# is elsewhere (e.g. ~/local/pytorch-source). The caller (restart script)
# cd's to the project root before invoking us.
PROJECT_ROOT="$(pwd)"

# [HARDENING #5] Assert required external tools exist and are executable
for tool in "$NBS_WORKERS" "$NBS_CHAT"; do
    [[ -x "$tool" ]] || {
        echo "ASSERTION FAILED: required tool not found or not executable: $tool" >&2
        exit 1
    }
done

if [[ $# -lt 1 ]]; then
    echo "Usage: nbs-digest-spawn <chat-file> [--wait]" >&2
    exit 4
fi

# [HARDENING #4] Validate argument count and reject unknown options
if [[ $# -gt 2 ]]; then
    echo "Error: unexpected arguments: ${*:3}" >&2
    exit 4
fi
if [[ $# -eq 2 && "$2" != "--wait" ]]; then
    echo "Error: unknown option: $2" >&2
    exit 4
fi

WAIT=false
if [[ "${2:-}" == "--wait" ]]; then
    WAIT=true
fi

# [SECURITY #3, #7] Validate CHAT_FILE is a canonical absolute path with safe characters
if ! CHAT_FILE="$(realpath -- "$1" 2>/dev/null)"; then
    echo "Error: cannot resolve path: $1" >&2
    exit 1
fi
[[ "$CHAT_FILE" =~ ^/[a-zA-Z0-9_./-]+$ ]] || {
    echo "Error: chat file path contains unsafe characters: $CHAT_FILE" >&2
    exit 4
}

if [[ ! -f "$CHAT_FILE" ]]; then
    echo "Error: chat file not found: $CHAT_FILE" >&2
    exit 1
fi

# Spawn ephemeral digest worker
# CHAT_FILE has been validated to contain only safe characters (alphanumeric, dots,
# hyphens, underscores, forward slashes) so it is safe to embed in the prompt string.
TASK_DESC="Load /nbs-chat-digest. Read the last 100 messages of ${CHAT_FILE} via 'nbs-chat read ${CHAT_FILE} --last=100'. Do NOT launch sub-agents — process the messages directly in this session. Produce a concise digest (key decisions, blockers, outcomes, current state). CRITICAL: include a Continuation section — analyse the final messages to determine whether clear next goals exist (CONTINUATION: GOALS) or the team needs to review and propose direction (CONTINUATION: REVIEW). Post the digest to ${CHAT_FILE} via 'nbs-chat send ${CHAT_FILE} chatdigest <digest>'. Also write to .nbs/digests/. Then stop — do not do anything else after posting."

# [BUG #1] Do not suppress stderr from spawn -- let errors propagate
WORKER_NAME=$("$NBS_WORKERS" spawn chatdigest "$PROJECT_ROOT" "$TASK_DESC") || {
    echo "Error: nbs-workers spawn failed (exit $?)" >&2
    exit 1
}

if [[ -z "$WORKER_NAME" ]]; then
    echo "Error: failed to spawn digest worker (empty name returned)" >&2
    exit 1
fi

echo "Digest worker spawned: $WORKER_NAME"

if [[ "$WAIT" == true ]]; then
    # [HARDENING #8] Assert workers directory exists before polling
    WORKERS_DIR="${PROJECT_ROOT}/.nbs/workers"
    [[ -d "$WORKERS_DIR" ]] || {
        echo "ASSERTION FAILED: workers directory not found: $WORKERS_DIR" >&2
        exit 1
    }
    TASK_FILE="${WORKERS_DIR}/${WORKER_NAME}.md"

    TIMEOUT=600
    ELAPSED=0

    while (( ELAPSED < TIMEOUT )); do
        sleep 5
        ELAPSED=$((ELAPSED + 5))

        if [[ -f "$TASK_FILE" ]]; then
            # [HARDENING #9] Normalise state extraction with tolower
            STATE=$(grep -m1 '^State:' "$TASK_FILE" 2>/dev/null | awk '{print tolower($2)}' || true)
            if [[ "$STATE" == "completed" || "$STATE" == "failed" || "$STATE" == "escalated" ]]; then
                echo "Digest worker finished: $STATE"
                break
            fi
        fi
    done

    # [BUG #6] Timeout is a failure, not a warning -- exit non-zero
    if (( ELAPSED >= TIMEOUT )); then
        echo "Error: digest worker timed out after ${TIMEOUT}s" >&2
        exit 1
    fi
fi

# [BUG #2] Do not swallow banner post errors -- report failure
if ! "$NBS_CHAT" send "$CHAT_FILE" chatdigest \
    "=== TEAM RESTART — Digest above summarises prior session ==="; then
    echo "Warning: failed to post restart banner to $CHAT_FILE" >&2
fi

echo "Restart banner posted to $CHAT_FILE"
