#!/bin/bash
# nbs-scribe-query: Search the scribe decision log
#
# Usage:
#   nbs-scribe-query --chat=<chat-file> <pattern>    Search decisions (literal text)
#   nbs-scribe-query --chat=<chat-file> <pattern> --regex  Search with ERE regex
#   nbs-scribe-query --chat=<chat-file> --id=D-<ts>  Look up a specific decision
#   nbs-scribe-query --chat=<chat-file> --last=N     Show last N decisions
#   nbs-scribe-query --chat=<chat-file> --by=<handle>  Decisions involving handle
#   nbs-scribe-query --chat=<chat-file> --tag=<tag>  Decisions with risk tag
#   nbs-scribe-query --chat=<chat-file> --count      Count total decisions
#   nbs-scribe-query --chat=<chat-file> --superseded Show all corrections
#
# The log file is derived from the chat file name:
#   .nbs/chat/live.chat → .nbs/scribe/live-log.md
#   .nbs/chat/work.chat → .nbs/scribe/work-log.md
#   .nbs/chat/live-20260227-121804-archive.chat → .nbs/scribe/live-log.md
#
# Search is literal (fixed string) by default. Use --regex for grep
# extended regex (ERE). Perl regex (\s, \d, lookahead) is not supported.
# ERE supports: . * + ? | () [] {n,m} — but not \s \d \w.
#
# Examples:
#   nbs-scribe-query --chat=.nbs/chat/live.chat benchmark
#   nbs-scribe-query --chat=.nbs/chat/live.chat --last=5
#   nbs-scribe-query --chat=.nbs/chat/live.chat --by=theologian
#   nbs-scribe-query --chat=.nbs/chat/live.chat 'deopt.*crash' --regex
#
# Exit codes:
#   0 - Success (matches found)
#   1 - No matches
#   4 - Invalid arguments

set -euo pipefail

# Help check first
if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
    sed -n '2,/^$/p' "$0" | grep '^#' | cut -c3-
    [[ $# -eq 0 ]] && exit 4 || exit 0
fi

# Extract flags from args
USE_REGEX=false
CHAT_FILE=""
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --regex) USE_REGEX=true ;;
        --chat=*) CHAT_FILE="${arg#--chat=}" ;;
        *) ARGS+=("$arg") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# [Violation 13] No subcommand after --chat= should be an error, not silent help
if [[ $# -eq 0 ]]; then
    echo "Error: no search pattern or command specified" >&2
    echo "Run with --help for usage" >&2
    exit 4
fi

if [[ -z "$CHAT_FILE" ]]; then
    echo "Error: --chat=<chat-file> is required" >&2
    echo "Example: nbs-scribe-query --chat=.nbs/chat/live.chat benchmark" >&2
    exit 4
fi

# Derive log path from chat file name
# .nbs/chat/live.chat → .nbs/scribe/live-log.md
# .nbs/chat/live-20260227-121804-archive.chat → .nbs/scribe/live-log.md
CHAT_DIR=$(dirname "$CHAT_FILE")
CHAT_BASE=$(basename "$CHAT_FILE" .chat)
# Strip archive suffix: name-YYYYMMDD-HHMMSS-archive → name
CHAT_BASE=$(echo "$CHAT_BASE" | sed 's/-[0-9]\{8\}-[0-9]\{6\}-archive$//')

# [Violation 8/SECURITY] Canonicalise scribe directory to prevent path traversal
SCRIBE_DIR=$(cd "$CHAT_DIR/../scribe" 2>/dev/null && pwd) || {
    echo "Error: scribe directory not found relative to $CHAT_DIR" >&2
    exit 4
}
LOG="${SCRIBE_DIR}/${CHAT_BASE}-log.md"

if [[ ! -f "$LOG" ]]; then
    echo "Error: scribe log not found: $LOG (derived from $CHAT_FILE)" >&2
    exit 4
fi

# [Violation 3] Use array for grep options instead of unquoted variable
GREP_OPTS=(-n)
if [[ "$USE_REGEX" != true ]]; then
    GREP_OPTS+=(-F)
fi

case "$1" in
    --help|-h)
        sed -n '2,/^$/p' "$0" | grep '^#' | cut -c3-
        exit 0
        ;;
    --count)
        c=$(grep -c '^### D-' "$LOG" || true)
        echo "${c:-0}"
        exit 0
        ;;
    --last=*)
        N="${1#--last=}"
        # [Violation 1] Validate N is a positive integer
        [[ "$N" =~ ^[1-9][0-9]*$ ]] || {
            echo "Error: --last requires a positive integer, got '$N'" >&2
            exit 4
        }
        grep -n '^### D-' "$LOG" | tail -"$N" | while IFS=: read -r line_num _rest; do
            sed -n "${line_num},/^---$/p" "$LOG" | head -10
            echo ""
        done
        exit 0
        ;;
    --id=*)
        ID="${1#--id=}"
        # [Violation 2] Validate ID format and use -F to prevent regex injection
        [[ "$ID" =~ ^D-[0-9]+$ ]] || {
            echo "Error: --id must match D-<timestamp>, got '$ID'" >&2
            exit 4
        }
        LINE=$(grep -nF "### ${ID}" "$LOG" | head -1 | cut -d: -f1 || true)
        if [[ -z "$LINE" ]]; then
            echo "Decision not found: $ID" >&2
            exit 1
        fi
        sed -n "${LINE},/^---$/p" "$LOG" | head -12
        exit 0
        ;;
    --by=*)
        HANDLE="${1#--by=}"
        # [Violation 3] Validate handle is non-empty
        [[ -n "$HANDLE" ]] || {
            echo "Error: --by requires a non-empty handle" >&2
            exit 4
        }
        # [Violation 5] Exit 1 if no matches found
        RESULTS=$(grep -n "Participants:" "$LOG" | grep -F "$HANDLE" | cut -d: -f1 | while read -r pline; do
            HEADER_LINE=$(head -"$pline" "$LOG" | grep -n '^### D-' | tail -1 | cut -d: -f1 || true)
            if [[ -n "$HEADER_LINE" ]]; then
                sed -n "${HEADER_LINE},/^---$/p" "$LOG" | head -10
                echo ""
            fi
        done | awk '!seen[$0]++') || true
        if [[ -z "$RESULTS" ]]; then
            exit 1
        fi
        printf '%s\n' "$RESULTS"
        exit 0
        ;;
    --tag=*)
        TAG="${1#--tag=}"
        # [Violation 4] Validate tag is non-empty
        [[ -n "$TAG" ]] || {
            echo "Error: --tag requires a non-empty tag" >&2
            exit 4
        }
        # [Violation 6] Exit 1 if no matches found
        RESULTS=$(grep -n "Risk tags:" "$LOG" | grep -F "$TAG" | cut -d: -f1 | while read -r tline; do
            HEADER_LINE=$(head -"$tline" "$LOG" | grep -n '^### D-' | tail -1 | cut -d: -f1 || true)
            if [[ -n "$HEADER_LINE" ]]; then
                sed -n "${HEADER_LINE},/^---$/p" "$LOG" | head -10
                echo ""
            fi
        done | awk '!seen[$0]++') || true
        if [[ -z "$RESULTS" ]]; then
            exit 1
        fi
        printf '%s\n' "$RESULTS"
        exit 0
        ;;
    --superseded)
        # [Violation 7] Exit 1 if no superseded entries found
        RESULTS=$(grep -A8 '\[SUPERSEDES' "$LOG") || true
        if [[ -z "$RESULTS" ]]; then
            exit 1
        fi
        printf '%s\n' "$RESULTS"
        exit 0
        ;;
    -*)
        echo "Unknown option: $1" >&2
        exit 4
        ;;
    *)
        PATTERN="$1"
        # [Violation 5] Validate pattern is non-empty
        [[ -n "$PATTERN" ]] || {
            echo "Error: search pattern must not be empty" >&2
            exit 4
        }
        # [Violation 3/4] Use array for grep opts; -- prevents pattern-as-flag
        # [Violation 8] Exit 1 if no matches found
        RESULTS=$(grep "${GREP_OPTS[@]}" -- "$PATTERN" "$LOG" 2>&1 | while IFS=: read -r line_num _rest; do
            HEADER_LINE=$(head -"$line_num" "$LOG" | grep -n '^### D-' | tail -1 | cut -d: -f1 || true)
            if [[ -n "$HEADER_LINE" ]]; then
                sed -n "${HEADER_LINE},/^---$/p" "$LOG" | head -10
                echo ""
            fi
        done | awk '!seen[$0]++') || true
        if [[ -z "$RESULTS" ]]; then
            exit 1
        fi
        printf '%s\n' "$RESULTS"
        exit 0
        ;;
esac
