#!/bin/bash
# nbs-oracle-reaper — Kill oracle workers after they post to chat.
#
# Oracles (pythia, librarian, shepard, fixup) are ephemeral. They spawn,
# do their assessment, post to chat, and should exit. This script detects
# when an oracle has posted and kills its session.
#
# STATELESS — no state files. All information comes from nbs-ts sessions:
#   - Session name identifies the oracle role (nbs-pythia-XXXX-poem)
#   - Session meta file has the start timestamp
#   - nbs-chat search finds posts after that timestamp
#
# Usage:
#   nbs-oracle-reaper check <project-root>

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ORACLE_ROLES="pythia shepard librarian fixup"
ORACLE_TIMEOUT=600   # 10 minutes
ORACLE_GRACE=30      # don't check before this
ORACLE_SETTLE=10     # wait after detecting post before kill

cmd_check() {
    local root="$1"

    # Find the chat file
    local chat_file
    chat_file=$(grep '^chat:' "${root}/.nbs/control-registry-supervisor" 2>/dev/null | cut -d: -f2-)
    [[ -n "$chat_file" ]] || exit 0

    local now
    now=$(date +%s)

    for role in $ORACLE_ROLES; do
        # Find alive sessions for this role.
        # Session names are unique: nbs-pythia-XXXX-poem
        # grep "nbs-${role}-" matches the role prefix with the unique suffix.
        local sessions
        sessions=$("${SCRIPT_DIR}/nbs-ts" list --name="nbs-${role}-" 2>/dev/null \
            | grep alive || true)
        [[ -n "$sessions" ]] || continue

        while IFS=$'\t' read -r handle status name cmd; do
            [[ -n "$handle" ]] || continue

            # Get session start time from meta file
            local meta_file
            meta_file="${HOME}/.nbs-ts/sessions/${handle}/meta"
            local start_epoch
            start_epoch=$(grep '^start:' "$meta_file" 2>/dev/null | awk '{print $2}')
            [[ -n "$start_epoch" ]] || continue

            local elapsed=$(( now - start_epoch ))

            # Timeout — kill if running too long
            if [[ $elapsed -gt $ORACLE_TIMEOUT ]]; then
                "${SCRIPT_DIR}/nbs-ts" kill "$handle" 2>/dev/null || true
                continue
            fi

            # Grace period — don't check too early
            if [[ $elapsed -lt $ORACLE_GRACE ]]; then
                continue
            fi

            # Chat post found after session start?
            local found
            found=$("${SCRIPT_DIR}/nbs-chat" search "$chat_file" "" \
                --handle="$role" --after="$start_epoch" 2>/dev/null \
                | grep -v "^No matches" | head -1 || true)
            if [[ -n "$found" ]]; then
                sleep $ORACLE_SETTLE
                "${SCRIPT_DIR}/nbs-ts" kill "$handle" 2>/dev/null || true
            fi
        done <<< "$sessions"
    done
}

# --- Main ---

if [[ $# -lt 2 ]]; then
    echo "Usage: nbs-oracle-reaper check <project-root>" >&2
    exit 4
fi

case "$1" in
    check)
        cmd_check "$2"
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Usage: nbs-oracle-reaper check <project-root>" >&2
        exit 4
        ;;
esac
