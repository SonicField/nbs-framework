#!/bin/bash
# nbs-remote-read: Read a file (or part of it) on a remote machine
#
# Quick read of remote files via scp. For glancing at code, checking
# logs, or verifying changes — without staging files locally.
#
# Usage:
#   nbs-remote-read <server> <remote-path>              Read entire file
#   nbs-remote-read <server> <remote-path> --head=N     First N lines
#   nbs-remote-read <server> <remote-path> --tail=N     Last N lines
#   nbs-remote-read <server> <remote-path> --lines=M-N  Lines M through N
#   nbs-remote-read <server> <remote-path> --grep=PAT   Lines matching pattern
#
# <server> is an SSH hostname or user@hostname — NOT a pty-session name.
# A pty-session is created internally for scp. You never manage it.
#
# Exit codes:
#   0 - Success
#   1 - General error
#   2 - File not found
#   3 - Transfer failed
#   4 - Invalid arguments

set -euo pipefail

PTY_SESSION="${HOME}/.nbs/bin/pty-session"
export NBS_PTY_QUIET=1

# V8 (from remote-edit pattern): Guard usage against $0 not being a file
usage() {
    if [[ -f "$0" ]] && [[ -r "$0" ]]; then
        # Extract only the header comment block, not inline code comments
        sed -n '2,/^[^#]/{ /^#/p }' "$0" | grep -v '!/bin/bash' | cut -c3-
    else
        echo "Usage: nbs-remote-read <server> <remote-path> [--head=N|--tail=N|--lines=M-N|--grep=PAT]" >&2
    fi
}

die() {
    local rc="$1"; shift
    echo "Error: $*" >&2
    echo "" >&2
    usage >&2
    exit "$rc"
}

[[ -x "$PTY_SESSION" ]] || die 1 "pty-session not found at $PTY_SESSION"

# scp via short-lived pty-session (bypasses BpfJailer)
fetch_file() {
    local host="$1"
    local remote_path="$2"
    local local_path="$3"
    # V9: Add RANDOM suffix to session name for collision safety
    local session_name="nbs-read-$$-${RANDOM}"

    # V6: Check pty-session create success and report errors
    if ! "$PTY_SESSION" create "$session_name" 'bash --login' >/dev/null 2>&1; then
        echo "Error: failed to create pty-session '$session_name'" >&2
        return 1
    fi
    sleep 1

    # V7: Check pty-session send success
    if ! "$PTY_SESSION" send "$session_name" \
        "scp $(printf '%q' "${host}:${remote_path}") $(printf '%q' "$local_path") 2>&1; echo FETCH_RC=\$?" \
        >/dev/null 2>&1; then
        "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1 || true
        echo "Error: failed to send scp command to pty-session '$session_name'" >&2
        return 1
    fi

    local elapsed=0
    local timeout=20
    while (( elapsed < timeout )); do
        sleep 1
        elapsed=$((elapsed + 1))
        local output
        # V11: Capture stderr along with stdout so errors are visible
        output=$("$PTY_SESSION" read "$session_name" 2>&1) || true
        # Use bash regex for stricter matching (same pattern as remote-edit V6)
        if [[ "$output" =~ FETCH_RC=([0-9]+) ]]; then
            local rc="${BASH_REMATCH[1]}"
            "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1 || true
            return "$rc"
        fi
    done

    # V8 (orphan warning): Warn if session kill fails
    if ! "$PTY_SESSION" kill "$session_name" >/dev/null 2>&1; then
        echo "Warning: failed to kill pty-session '$session_name' — may need manual cleanup" >&2
    fi
    echo "Error: scp timed out after ${timeout}s" >&2
    return 3
}

case "${1:-}" in
    help|--help|-h) usage; exit 0 ;;
    "") if [[ $# -eq 0 ]]; then usage; exit 0; fi ;;
esac

if [[ $# -lt 2 ]]; then
    die 4 "requires <server> <remote-path>. <server> is an SSH hostname, not a pty-session name."
fi

HOST="$1"
REMOTE_PATH="$2"
shift 2

# V12: Validate HOST and REMOTE_PATH are non-empty and well-formed
[[ -n "$HOST" ]] || die 4 "<server> must not be empty"
[[ -n "$REMOTE_PATH" ]] || die 4 "<remote-path> must not be empty"
# Hostname: only alphanumeric, dots, hyphens, underscores, @ (for user@host)
[[ "$HOST" =~ ^[a-zA-Z0-9._@-]+$ ]] || die 4 "Invalid server hostname (only alphanumeric, dots, hyphens, underscores, @ allowed): $HOST"
# Remote path must be absolute
[[ "$REMOTE_PATH" =~ ^/ ]] || die 4 "Remote path must be absolute (start with /), got: $REMOTE_PATH"
# Remote path must contain only safe POSIX path characters
[[ "$REMOTE_PATH" =~ [^a-zA-Z0-9_./-] ]] && die 4 "Remote path contains disallowed characters: $REMOTE_PATH"

# Parse options
MODE="cat"
MODE_ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --head=*)  MODE="head"; MODE_ARG="${1#--head=}"; shift ;;
        --tail=*)  MODE="tail"; MODE_ARG="${1#--tail=}"; shift ;;
        --lines=*) MODE="lines"; MODE_ARG="${1#--lines=}"; shift ;;
        --grep=*)  MODE="grep"; MODE_ARG="${1#--grep=}"; shift ;;
        --help|-h) usage; exit 0 ;;
        *) die 4 "unknown option: $1" ;;
    esac
done

# V2/V3: Validate MODE_ARG for numeric/pattern correctness before use
case "$MODE" in
    head|tail)
        [[ "$MODE_ARG" =~ ^[0-9]+$ ]] || die 4 "--${MODE} requires a positive integer, got: $MODE_ARG"
        (( MODE_ARG > 0 )) || die 4 "--${MODE} requires a value > 0, got: $MODE_ARG"
        ;;
    lines)
        [[ "$MODE_ARG" =~ ^[0-9]+-[0-9]+$ ]] || die 4 "--lines requires M-N format (e.g. 10-20), got: $MODE_ARG"
        # V10: Validate start <= end
        local_start="${MODE_ARG%-*}"
        local_end="${MODE_ARG#*-}"
        (( local_start <= local_end )) || die 4 "--lines start must be <= end, got: $MODE_ARG"
        ;;
    grep)
        [[ -n "$MODE_ARG" ]] || die 4 "--grep requires a non-empty pattern"
        ;;
esac

# Fetch to temp file
TMP=$(mktemp)
# V1: Use single-quoted trap to defer expansion to execution time
trap 'rm -f "$TMP"' EXIT

if ! fetch_file "$HOST" "$REMOTE_PATH" "$TMP"; then
    echo "Error: failed to fetch ${HOST}:${REMOTE_PATH}" >&2
    exit 3
fi

if [[ ! -s "$TMP" ]]; then
    echo "Error: file empty or not found: ${HOST}:${REMOTE_PATH}" >&2
    exit 2
fi

# Apply filter locally
case "$MODE" in
    cat)   cat "$TMP" ;;
    head)  head -n "$MODE_ARG" "$TMP" ;;
    tail)  tail -n "$MODE_ARG" "$TMP" ;;
    lines)
        START="${MODE_ARG%-*}"
        END="${MODE_ARG#*-}"
        sed -n "${START},${END}p" "$TMP"
        ;;
    # V4/V5: Use -- to prevent pattern-as-flag injection; distinguish grep exit codes
    grep)
        set +e
        grep -n -- "$MODE_ARG" "$TMP"
        grep_rc=$?
        set -e
        if (( grep_rc == 1 )); then
            echo "(no matches)" >&2
        elif (( grep_rc > 1 )); then
            echo "Error: grep failed on pattern: $MODE_ARG" >&2
            exit 1
        fi
        ;;
esac
