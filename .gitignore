# Test outputs - generated files, not committed
# See tests/README.md for explanation

# Verdict files (evaluator judgements)
tests/automated/verdicts/*.json
tests/automated/verdicts/*.txt

# Legacy patterns (before verdicts/ subdirectory)
tests/automated/scenarios/*/test_output_*.txt
tests/automated/scenarios/*/test_verdict_*.json
tests/automated/*_verdict.json
tests/automated/*_test_verdict.json

# Python bytecache
__pycache__/

# Compiled test binaries (source is tests/*.c, binaries are build artefacts)
tests/test_*_unit
tests/test_*_adversarial
tests/test_*_audit

# Compiled binaries in bin/ (built by make install, not committed)
bin/nbs-bus
bin/nbs-chat
bin/nbs-chat-remote
bin/nbs-chat-terminal
bin/nbs-chat-web
bin/nbs-scribe-log
bin/nbs-sidecar
bin/nbs-workers
bin/pty-session

# Build artefacts (intermediate objects and binaries in source dirs)
src/nbs-chat/nbs-chat
src/nbs-chat/nbs-chat-terminal
src/nbs-chat/nbs-chat-remote
src/nbs-chat/assert_check
src/nbs-chat/*.o
src/nbs-bus/nbs-bus
src/nbs-bus/assert_check
src/nbs-bus/*.o
src/nbs-sidecar/*.o
src/nbs-sidecar/nbs-sidecar
src/nbs-sidecar/assert_check
src/nbs-workers/*.o
src/nbs-workers/nbs-workers
src/nbs-workers/nbs-worker
src/nbs-workers/assert_check
src/nbs-pty-session/*.o
src/nbs-pty-session/nbs-pty-session
src/nbs-pty-session/assert_check

# macOS resource forks
._*

# Stray fix/bench scripts (session-specific, not framework code)
fix_*.py
abba_bench.py
remove_debug.py

# Benchmark results (session-specific output)
benchmark_results/

# Archived session scripts
archive/

# Proxy certificates (accidental downloads)
proxy:*

# Claude Code config
.claude/

# NBS teams working directory (project-specific, not framework)
.nbs/

# Lock files (created by chat sessions)
*.lock

# Stray edit scripts (session-specific, belong in plans/)
edit_*.py

# Prevent plan/progress docs in repo root (use plans/ directory)
# Pattern: dd-mm-yyyy-*.md
[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]-*.md
# Build artefacts for nbs-scribe-log
src/nbs-scribe-log/nbs-scribe-log
src/nbs-scribe-log/assert_check
src/nbs-scribe-log/*.o
# Build artefacts for nbs-hub
src/nbs-hub/nbs-hub
src/nbs-hub/*.o
bin/nbs-hub
# Build artefacts for nbs-ts
src/nbs-ts/*.o
src/nbs-ts/nbs-ts
src/nbs-ts/nbs-ts-helper
src/nbs-ts/assert_check
src/nbs-ts/test_nbs_ts
bin/nbs-ts-helper
# Build artefacts for nbs-ts-tools
src/nbs-ts-tools/nbs-ts-grep
src/nbs-ts-tools/nbs-ts-query
# Build artefacts for nbs-ts-render
src/nbs-ts-render/nbs-ts-render
src/nbs-ts-render/test_nbs_ts_render
src/nbs-ts-render/*.o
bin/nbs-ts-render
# Build artefacts for nbs-chat-edit
src/nbs-chat-edit/nbs-chat-edit
bin/nbs-chat-edit
